---
import { getAllArticles } from "~/utils/article-stats";
import { sortByPubDate } from "~/utils/date-utils";
import { getAdjacentPosts } from "~/utils/adjacent-posts";
// 灯箱样式按需注入（见 src/utils/fancybox.ts / D-0057）

import BaseLayout from "~/layouts/BaseLayout.astro";
import PostMeta from "~/components/Article/PostMeta.astro";
import PostCardImage from "~/components/Article/PostCardImage.astro";
import PostFooter from "~/components/Article/PostFooter.astro";
import PostNavigation from "~/components/Article/PostNavigation.astro";
import PostShare from "~/components/Article/PostShare.astro";
import QuoteSelection from "~/components/Article/QuoteSelection.astro";
import AnnotationLayer from "~/components/Article/AnnotationLayer.astro";
import SeriesNav from "~/components/Series/SeriesNav.astro";
import Toc from "~/components/Article/Toc.astro";
import BackToTop from "~/components/Layout/BackToTop.astro";
import DynamicIcon from "~/components/Icons/DynamicIcon.astro";
import { tocNodes } from "~/utils/toc";
import Donate from "~/components/UI/Donate.astro";
import Author from "~/components/UI/Author.astro";
import WalineComment from "~/components/UI/WalineComment.astro";
import MermaidRenderer from "~/components/Layout/MermaidRenderer.astro";
import RelatedPosts from "~/components/Article/RelatedPosts.astro";
import Breadcrumb from "~/components/Article/Breadcrumb.astro";
import { site, postView, waline, donate, author as siteAuthor } from "~/config";
import { getRandomImageUrl } from "~/utils";
import { seriesContextOf } from "~/utils/series";

interface Props {
    frontmatter: Record<string, any>;
    slug: string;
    modifiedTime: Date | string;
    readTime: string;
    wordCount: number;
    noindex?: boolean;
    noEnAlternate?: boolean;
    locale?: string;
    /** markdown 渲染出的标题树（构建期就有，用来预渲染 TOC，避免目录等 JS 才出现） */
    headings?: TocHeading[];
}

interface TocHeading {
    depth: number;
    slug: string;
    text: string;
}

const {
    frontmatter = {
        waline: false,
        donate: false,
        toc: false,
        mathjax: false,
        katex: false,
        mermaid: false,
    },
    slug,
    modifiedTime,
    readTime,
    wordCount,
    noindex = false,
    noEnAlternate = false,
    locale = "zh",
    headings = [],
} = Astro.props;

const isEnPage = Astro.url.pathname.startsWith("/en/");
const articlePrefix = isEnPage ? "/en/article" : "/article";

/**
 * features[] → 渲染开关（G4 / A13）
 * v4 契约把 6 个 render 布尔键合并成 features[]，模板这里做一次映射。
 * 89 篇已全部迁移，故不再回退旧的 mathjax/mermaid 布尔键（D-0045）。
 */
const features: string[] = frontmatter.features ?? [];
const hasMathjax = features.includes("mathjax");
const hasKatex = features.includes("katex");
const hasMermaid = features.includes("mermaid");

const { prev: prevSlug, next: nextSlug } = await getAdjacentPosts(slug, isEnPage ? "en" : "zh");
const toArticleUrl = (id: string) => `${articlePrefix}/${isEnPage ? id.replace(/-en$/, "") : id}/`;
const prevUrl = prevSlug ? toArticleUrl(prevSlug) : null;
const nextUrl = nextSlug ? toArticleUrl(nextSlug) : null;

// 相关文章计算需要排序后的完整文章列表（仅同语言文章参与）
const allPosts = (await getAllArticles()).filter((post) => (post.data.lang === "en") === isEnPage);
const sorted = sortByPubDate(allPosts);

/**
 * 系列上下文（M5-13 · N-1b）：只有写了 `series` 的文章才跑聚合 —— 无系列的文章
 * 连 `collectSeries` 都不进，页面里不会留下任何 `.series-nav` 空壳。
 * 排序/成员来自 `~/utils/series`，与 `/series/<slug>/` 页面同一份数据。
 */
const seriesContext = frontmatter.series ? seriesContextOf(allPosts, slug) : null;

const today = new Date();
const publishedTime = frontmatter.pubDate;
const updateTime = modifiedTime instanceof Date ? modifiedTime : new Date(modifiedTime);
const daysSinceUpdate = Math.floor(
    (today.getTime() - updateTime.getTime()) / (1000 * 60 * 60 * 24),
);

const imageUrl = frontmatter.image?.url || getRandomImageUrl();
const imageAlt = frontmatter.image?.alt || "Blog Cover";
const ogImage =
    import.meta.env.DEV || import.meta.env.PREVIEW ? imageUrl : `${Astro.site}og/${slug}.png`;

// 相关文章：按标签匹配数量降序排列，排除当前文章，取前 3 篇
const currentTags: string[] = frontmatter.tags || [];
const relatedPosts = sorted
    .filter((post) => post.id !== slug)
    .map((post) => ({
        post,
        matchCount: (post.data.tags || []).filter((tag: string) => currentTags.includes(tag))
            .length,
    }))
    .filter(({ matchCount }) => matchCount > 0)
    .sort((a, b) => b.matchCount - a.matchCount)
    .slice(0, 3)
    .map(({ post }) => post);

const isEn = Astro.url.pathname.startsWith("/en/");
const firstTag = currentTags[0] || "";

/**
 * M6-3：8/4 版式的两个派生量。
 * - `tocCount`：移动端「目录 N」按钮上的节数 —— 与目录卡同一个口径（`~/utils/toc`），
 *   两处各算一份必然对不上；
 * - `showRail`：右栏在三块都为空时不渲染（不留空列，主栏自动占满整行）。
 */
const tocCount = tocNodes(headings).length;
const showToc = Boolean(frontmatter.toc);
const showAuthor = Boolean(frontmatter.author) && Boolean(postView.author);
const showRail = showToc || showAuthor || relatedPosts.length > 0;
---

<BaseLayout
    title={`${frontmatter.title} - ${site.title}`}
    description={`${frontmatter.title} - ${frontmatter.description}`}
    image={ogImage}
    imageAlt={imageAlt}
    keywords={frontmatter.tags}
    publishedTime={publishedTime}
    modifiedTime={modifiedTime}
    mathjax={hasMathjax}
    katex={hasKatex}
    mermaid={hasMermaid}
    prevUrl={prevUrl}
    nextUrl={nextUrl}
    noindex={noindex}
    noEnAlternate={noEnAlternate}
    locale={isEn ? "en" : "zh"}
>
    <div class="reading-progress"></div>
    <article class="post">
        <div class:list={["post-layout", { "post-layout--full": !showRail }]}>
            <div class="post-main">
                <header class="post-masthead">
                    <Breadcrumb title={frontmatter.title} firstTag={firstTag} isEn={isEn} />
                    <h1 class="post-title-text">
                        {frontmatter.title}
                    </h1>
                    <PostMeta
                        publishedTime={publishedTime}
                        modifiedTime={modifiedTime}
                        wordCount={wordCount}
                        readTime={readTime}
                        currentSlug={slug}
                        variant="article"
                    />
                </header>
                {
                    showToc && tocCount > 0 && (
                        <div class="post-toolbar">
                            {/* 移动端目录入口：声明式 popover 触发（0 JS，Esc/焦点回填由浏览器给） */}
                            <button
                                class="post-toc-trigger"
                                type="button"
                                popovertarget="post-toc-drawer"
                                aria-controls="post-toc-drawer"
                            >
                                <DynamicIcon name="tabler:stack-2" class="post-toc-trigger__icon" />
                                <span class="post-toc-trigger__label">
                                    {isEn ? "Contents" : "目录"}
                                </span>
                                <span class="post-toc-trigger__count" aria-hidden="true">
                                    {tocCount}
                                </span>
                            </button>
                        </div>
                    )
                }
                <div class="post-sheet">
                    <figure class="post-cover">
                        <PostCardImage
                            imagePath={imageUrl}
                            altText={imageAlt}
                            transformWidth={1200}
                            loading="eager"
                        />
                    </figure>
                    {
                        daysSinceUpdate >= 180 && (
                            <aside class="post-stale remark-aside remark-aside--danger">
                                <p>
                                    🌶 <strong>过期警告：</strong> 本页面距今已有
                                    {daysSinceUpdate}
                                    天未更新，年久失修，内容可能有所偏颇，还请仔细甄别！
                                </p>
                            </aside>
                        )
                    }
                    {
                        frontmatter.summary && (
                            <p class="post-lede" data-pagefind-ignore>
                                {frontmatter.summary}
                            </p>
                        )
                    }
                    <div
                        id="post-content"
                        class="post-content"
                        data-pagefind-body
                        data-pagefind-meta={`title:${frontmatter.title}`}
                        data-fancybox-off={frontmatter.fancybox === false ? "" : undefined}
                    >
                        <h2 id="post-content-title" class="toc-ignore sr-only" data-pagefind-ignore>
                            {frontmatter.title}
                        </h2>
                        <div class="article-content">
                            <slot />
                        </div>
                    </div>
                    <PostFooter tags={frontmatter.tags} />
                    {
                        seriesContext && (
                            <SeriesNav context={seriesContext} locale={isEn ? "en" : "zh"} />
                        )
                    }
                    <PostShare
                        title={frontmatter.title}
                        description={frontmatter.description}
                        image={ogImage}
                        slug={slug}
                        locale={isEn ? "en" : "zh"}
                    />
                    <PostNavigation slug={slug} />
                    {/* M6-3：相关阅读回到正文末尾，改用竖排条目（toc 稿右栏卡的版式） */}
                    <RelatedPosts relatedPosts={relatedPosts} variant="rail" />
                    {/* M6-3：评论只挪位（主栏底部，与 toc 稿一致），交互仍归 M7-2 */}
                    {
                        frontmatter.waline && waline.enable && (
                            <div class="post-comments">
                                <WalineComment locale={locale} />
                            </div>
                        )
                    }
                </div>
            </div>
            {
                showRail && (
                    <aside class="post-rail">
                        <div class="post-rail__sticky">
                            {showToc && <Toc headings={headings} />}
                            {showAuthor && (
                                <div class="post-rail__card post-rail__author">
                                    <Author />
                                </div>
                            )}
                        </div>
                    </aside>
                )
            }
        </div>
    </article>
    {/* M7-3d-2：选中正文 → 金句卡弹层（脚本与渲染器都按需加载） */}
    <QuoteSelection
        title={frontmatter.title}
        author={siteAuthor.type}
        locale={isEn ? "en" : "zh"}
    />
    {/* M7-4b：正文选区高亮 + 批注工具条（无批注、未选字时 0 请求） */}
    <AnnotationLayer slug={slug} locale={isEn ? "en" : "zh"} />
    {postView.backtotop && <BackToTop />}
    {frontmatter.donate && donate.enable && <Donate locale={locale} />}
    {hasMermaid && <MermaidRenderer />}
</BaseLayout>

<!-- 样式已移到 src/styles/article.css（D-0085：并入全局样式链，避免文章页单独拉一份 CSS） -->

{frontmatter.markmap && <script>import "~/scripts/markmap-renderer.ts";</script>}
{frontmatter.chart && <script>import "~/scripts/chart-renderer.ts";</script>}
{frontmatter.reveal && <script>import "~/scripts/reveal-renderer.ts";</script>}
{frontmatter.tabs !== false && <script>import "~/scripts/tabs";</script>}
