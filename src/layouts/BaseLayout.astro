---
import "~/styles/global.css";
// 页面级样式统一进全局样式链（D-0083 / D-0085）：
// 换页时不再新拉一份 CSS —— 慢链路上那一次请求就是「内容出来了、样式还没到」的根因。
// home.css 的规则已全部收进 .home-page 作用域；article.css 放最后，组件规则仍排在基础样式之后。
import "~/styles/home.css";
import "~/styles/article.css";
import "~/styles/remark-aside.css";
import "~/styles/toc.css";
import BaseHead from "~/components/BaseHead/BaseHead.astro";
import Header from "~/components/Layout/Header.astro";
import Footer from "~/components/Layout/Footer.astro";
import Notice from "~/components/UI/Notice.astro";
import Watermark from "~/components/UI/Watermark.astro";
import Sidebar from "~/components/Layout/Sidebar.astro";
import { config } from "~/config";
import { sidebarConfig } from "~/config/ui";
import { getLocale, htmlLangOf } from "~/utils/i18n";

interface Props {
    title: string;
    description: string;
    image?: string;
    imageAlt?: string;
    keywords?: string | string[];
    publishedTime?: Date | string;
    modifiedTime?: Date | string;
    mathjax?: boolean;
    katex?: boolean;
    mermaid?: boolean;
    fullWidth?: boolean;
    locale?: string;
    prevUrl?: string | null;
    nextUrl?: string | null;
    noindex?: boolean;
    noEnAlternate?: boolean;
    /** M5-12：这一页没有中文对照（英文系列页专用，见 BaseHead/SeoLinks） */
    noZhAlternate?: boolean;
    showSidebar?: boolean;
    template?: "default" | "splash" | "doc";
    /**
     * M6-1：shell 分栏。`auto`（默认）= 沿用旧行为（有侧栏才分栏）；
     * `8-4` / `4-8` = 1140 shell 的 12 栅格可选列（主栏 8 / 侧栏 4），
     * 供 M6-2 起的页面重做直接使用；不传 props 的页面输出逐字节不变。
     */
    columns?: "auto" | "8-4" | "4-8";
}

const {
    title,
    description,
    image,
    imageAlt,
    keywords = [],
    publishedTime,
    modifiedTime,
    mathjax = false,
    katex = false,
    mermaid = false,
    fullWidth = false,
    locale = "zh",
    prevUrl,
    nextUrl,
    noindex = false,
    noEnAlternate = false,
    noZhAlternate = false,
    showSidebar = false,
    template = "default",
    columns = "auto",
} = Astro.props;

const isSplash = template === "splash";
const isDoc = template === "doc";
/** 有列定义才进 page-wrapper（8/4 需要栅格容器；旧页面没有 props → 行为不变） */
const hasColumns = columns === "8-4" || columns === "4-8";
const useWrapper = showSidebar || isDoc || hasColumns;

/**
 * `<html lang>` 只从 i18n 注册表取（M2-11a）：以前是 `locale === "en" ? "en" : "zh-CN"`，
 * 新接的 ja/ko/fr/zh-TW 会被压成 zh-CN —— 屏幕阅读器和浏览器断字都拿错语言。
 * 未知 locale 仍然回落到 zh-CN（getLocale 的默认行为），zh/en 输出逐字节不变。
 */
const lang = htmlLangOf(getLocale(locale));
// 预览构建（PUBLIC_PREVIEW=1）才打包这段清理脚本，正式站不引入
---

<!doctype html>
<html lang={lang}>
    <BaseHead
        title={title}
        description={description}
        image={image}
        imageAlt={imageAlt}
        keywords={keywords}
        publishedTime={publishedTime}
        modifiedTime={modifiedTime}
        mathjax={mathjax}
        katex={katex}
        mermaid={mermaid}
        prevUrl={prevUrl}
        nextUrl={nextUrl}
        noindex={noindex}
        noEnAlternate={noEnAlternate}
        noZhAlternate={noZhAlternate}
    />
    <body>
        <a href="#main-content" class="skip-link"
            >{locale === "en" ? "Skip to content" : "跳至内容"}</a
        >
        <Notice />
        <div
            id="app"
            class:list={[
                "full-width",
                `template-${template}`,
                { "with-sidebar": showSidebar || isDoc },
            ]}
        >
            {!isSplash && <Header locale={locale} />}
            {
                useWrapper ? (
                    <div
                        class:list={[
                            "page-wrapper",
                            {
                                "page-wrapper--sidebar": showSidebar || isDoc,
                                "page-wrapper--8-4": columns === "8-4",
                                "page-wrapper--4-8": columns === "4-8",
                            },
                        ]}
                    >
                        {(showSidebar || isDoc) && (
                            <Sidebar items={sidebarConfig} currentPath={Astro.url.pathname} />
                        )}
                        <main id="main-content" class="main">
                            <div class:list={["content", { "content--full": fullWidth }]}>
                                <slot />
                            </div>
                        </main>
                    </div>
                ) : (
                    <main id="main-content" class="main">
                        <div class:list={["content", { "content--full": fullWidth }]}>
                            <slot />
                        </div>
                    </main>
                )
            }
            {!isSplash && <Footer />}
        </div>
        <Watermark />
        {config.redirect && <script>import "~/scripts/redirect-handler";</script>}
        <script>
            import "~/scripts/a11y-scroll";
            import "~/scripts/anchor-scroll";
            import "~/scripts/tab-nav";
            // 文章浏览量：常驻模块 + 按需动态 import（D-0090，SPA 换页后模块不会重新执行）
            import "~/scripts/pageview";
            // 阅读进度条（D-0089）：常驻监听，SPA 换页后换的是元素不是监听器
            import "~/scripts/reading-progress";
            import "~/scripts/pwa-register";
            // 灯箱：常驻模块 + astro:page-load 监听。页面级 <script> 在 swup 换页时
            // 不会重新执行（脚本在 head，容器替换不带它），所以必须放在 BaseLayout。
            import "~/scripts/fancybox-handler";
            import "~/scripts/fancybox-essay";
            import "~/scripts/fancybox-album";
        </script>
    </body>
</html>

<style is:global>
    /* M6-1：shell 容器。宽度走 1140（`--layout-content-wide`），外边距 24；
       旧 `--content-width-max`(1440) 只保留给全宽模板。 */
    .page-wrapper {
        display: grid;
        width: 100%;
        max-width: var(--layout-content-wide, var(--content-width-max));
        margin: 0 auto;
        padding-inline: var(--space-6, 24px);
        padding-block: var(--space-6, 24px) 0;
        gap: var(--space-8, 32px);
        align-items: start;
    }

    .page-wrapper--sidebar,
    .with-sidebar .page-wrapper {
        grid-template-columns: var(--sidebar-width) minmax(0, 1fr);
    }

    /* 12 栅格的可选列：主栏 8 / 侧栏 4（M6-2 起直接用 columns="8-4"） */
    .page-wrapper--8-4 {
        grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
    }

    .page-wrapper--4-8 {
        grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    }

    /* 8/4 分栏里正文吃满 shell，不再被 860 的旧阅读宽截断（页面自己可再收窄） */
    .page-wrapper--8-4 .content,
    .page-wrapper--4-8 .content {
        max-width: none;
    }

    .with-sidebar .main,
    .page-wrapper--sidebar .main {
        min-width: 0;
    }

    .page-wrapper > .main {
        padding-inline: 0;
    }

    @media (max-width: 768px) {
        .with-sidebar .page-wrapper,
        .page-wrapper--sidebar,
        .page-wrapper--8-4,
        .page-wrapper--4-8 {
            grid-template-columns: minmax(0, 1fr);
            padding-inline: var(--space-5, 20px);
        }
    }

    @media (max-width: 450px) {
        .page-wrapper {
            padding-inline: var(--space-4, 16px);
        }
    }

    /* Template: splash — full-width, no chrome */
    .template-splash .content {
        max-width: var(--content-width-max);
        padding: 0;
    }
    .template-splash .main {
        padding-top: var(--space-3xl);
        padding-bottom: var(--space-3xl);
    }
</style>
