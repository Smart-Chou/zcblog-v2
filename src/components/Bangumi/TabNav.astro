---
interface Tab {
    id: string;
    name: string;
    count?: number;
}

interface Props {
    tabs: Tab[];
    activeTab: string;
}

const { tabs, activeTab } = Astro.props;
---

<div class="tab-nav">
    <!-- role/aria 关系：tablist → tab（aria-selected + aria-controls）→ tabpanel（BangumiSection 里的
         id="panel-<id>" + aria-labelledby）。此前 button 上裸挂 aria-selected，缺 role 被 axe
         判 aria-allowed-attr critical（2 个番剧页 × 5 个 tab）。 -->
    <nav class="tab-buttons" role="tablist">
        {
            tabs.map((tab) => (
                <button
                    class:list={["tab-btn", { active: tab.id === activeTab }]}
                    data-tab={tab.id}
                    id={`tab-${tab.id}`}
                    type="button"
                    role="tab"
                    aria-selected={tab.id === activeTab}
                    aria-controls={`panel-${tab.id}`}
                >
                    {tab.name}
                    {tab.count !== undefined && <span class="count">({tab.count})</span>}
                </button>
            ))
        }
    </nav>
</div>

<!-- tab 逻辑见 src/scripts/tab-nav.ts（D-0080） -->

<style>
    .tab-nav {
        border-bottom: 1px solid var(--color-border);
        margin-bottom: 1.5rem;
    }

    .tab-buttons {
        display: flex;
        gap: 0.5rem;
        overflow-x: auto;
    }

    .tab-btn {
        padding: 12px 16px;
        border: none;
        background: transparent;
        font-size: 0.9rem;
        font-weight: 500;
        color: var(--color-text);
        cursor: pointer;
        border-bottom: 2px solid transparent;
        transition: all var(--duration-normal) var(--ease-out);
        white-space: nowrap;
    }

    @media (hover: hover) {
        .tab-btn:hover {
            color: var(--color-accent);
        }
    }

    .tab-btn.active {
        color: var(--color-accent);
        border-bottom-color: var(--color-accent);
    }

    .count {
        font-size: 0.8rem;
        /* M2-13a：opacity .7 把 accent 与底色混成脏红（3.53:1）。改为实色 muted，
           不再靠透明度凑层级（暗色 6.86:1 / 浅色 6.1:1）。 */
        color: var(--color-muted);
        margin-left: 4px;
    }
</style>
