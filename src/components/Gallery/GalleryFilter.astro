---
/**
 * 相册地点筛选（Gallery 层；M2-8c 收紧）
 *
 * 只是按钮组 + 事件委托：点一个地点，把 `.album-card` 里 `data-tags` 不含它的隐藏掉。
 * 标签串由页面用 `albumPlaceLabel()` 算，与卡片 `data-tags` 同源，两边不会漂。
 *
 * M2-8c 的两处修正（都是实测出来的，不是审美偏好）：
 * - 选中态原本是 `var(--color-accent)` + `white`，深色主题下 axe 判 `color-contrast`
 *   serious；改成 design token 配套的 `--color-accent-solid` + `--color-fg-on-accent`。
 * - 按钮补 `type="button"` 与 `aria-pressed`：选中状态此前只有 class，读屏用户看不到。
 */
interface Props {
    tags: string[];
    allLabel: string;
}

const { tags, allLabel } = Astro.props;
---

<div class="gallery-filter" role="group" aria-label={allLabel}>
    <button type="button" class="filter-tag active" data-tag="all" aria-pressed="true">
        {allLabel}
    </button>
    {
        tags.map((tag) => (
            <button type="button" class="filter-tag" data-tag={tag} aria-pressed="false">
                {tag}
            </button>
        ))
    }
</div>

<script is:inline>
    // 内联脚本会随 <main> 一起被 swup 重新执行；直接 querySelectorAll 绑元素的话，
    // 同一批按钮会被绑上第二份监听。改成"只绑一次 + 事件委托"，对后续换页的
    // 新 DOM 同样生效。
    if (!window.__galleryFilterBound) {
        window.__galleryFilterBound = true;
        document.addEventListener("click", function (event) {
            var btn = event.target && event.target.closest && event.target.closest(".filter-tag");
            if (!btn) return;
            var tag = btn.getAttribute("data-tag");
            document.querySelectorAll(".filter-tag").forEach(function (b) {
                b.classList.remove("active");
                b.setAttribute("aria-pressed", "false");
            });
            btn.classList.add("active");
            btn.setAttribute("aria-pressed", "true");
            document.querySelectorAll(".album-card").forEach(function (card) {
                var tags = (card.getAttribute("data-tags") || "").split(",");
                var show = tag === "all" || tags.indexOf(tag) !== -1;
                card.style.display = show ? "" : "none";
            });
        });
    }
</script>

<style>
    /* 筛选条（M8-3a）：375 上按钮必须换行而不是把页面撑宽。
       min-inline-size:0 解掉 flex 项默认 min-width:auto；单个超长地名
       用 overflow-wrap:anywhere 兜住，否则一个地名就是一整条横向溢出。 */
    .gallery-filter {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-2);
        justify-content: center;
        min-inline-size: 0;
        max-inline-size: 100%;
    }

    .filter-tag {
        flex: 0 1 auto;
        max-inline-size: 100%;
        overflow-wrap: anywhere;
        padding: var(--space-1) var(--space-3);
        border: 1px solid var(--color-border-subtle);
        border-radius: var(--radius-pill);
        background-color: var(--color-bg-surface);
        color: var(--color-fg-default);
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        letter-spacing: var(--tracking-wide);
        cursor: pointer;
        transition:
            background-color var(--duration-base) var(--ease-standard),
            color var(--duration-base) var(--ease-standard),
            border-color var(--duration-base) var(--ease-standard);
    }

    @media (hover: hover) {
        .filter-tag:hover {
            border-color: var(--color-accent-solid);
        }
    }

    /* 选中态 = 语义色对（底 + 其上文字），不是「accent 上放白字」的巧合组合 */
    .filter-tag.active {
        background-color: var(--color-accent-solid);
        border-color: var(--color-accent-solid);
        color: var(--color-fg-on-accent);
    }

    .filter-tag:focus-visible {
        outline: 2px solid var(--color-accent-solid);
        outline-offset: 2px;
    }
</style>
