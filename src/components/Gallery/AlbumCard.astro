---
/**
 * 相册卡片（Gallery 层；M2-8c 重做）
 * ------------------------------------------------------------------
 * 为什么不再用 `Card` + overlay 槽：卡片文字原本压在照片上的暗色渐变里，
 * 播放层面（axe）**判不出对比度** —— 文字压在图片/渐变上永远是 `color-contrast`
 * 的 incomplete，这与「机器可判定的 a11y」这条门禁冲突。现在改成
 * 「封面在上、说明在下」：文字落在页面底色上，对比度可计算，也更好读。
 *
 * 张数徽标仍压在照片右上角，但用**实心底 + 默认前景色**（半透明底同样判不出）。
 * `data-tags` 保留给 `GalleryFilter`：相册按地点筛，不是在按相册名筛自己。
 */
import DynamicIcon from "~/components/Icons/DynamicIcon.astro";

interface Props {
    id: string;
    name: string;
    cover?: string;
    description?: string;
    date?: string;
    location?: string;
    tags?: string[];
    photoCount?: number;
}

const { id, name, cover, description, date, location, tags, photoCount } = Astro.props;
---

<a
    class="album-card"
    href={`/albums/${id}/`}
    data-tags={tags?.join(",") || ""}
    data-album-item={id}
>
    <span class="album-card__cover">
        {
            cover ? (
                <img
                    class="album-card__image"
                    src={cover}
                    alt={name}
                    loading="lazy"
                    decoding="async"
                />
            ) : (
                <span class="album-card__placeholder" aria-hidden="true">
                    📷
                </span>
            )
        }
        <span class="album-card__count">{photoCount || 0} 张</span>
    </span>
    <span class="album-card__body">
        <h3 class="album-card__name">{name}</h3>
        {description && <span class="album-card__desc">{description}</span>}
        <span class="album-card__meta">
            {date && <span class="album-card__date">{date}</span>}
            {
                location && (
                    <span class="album-card__place">
                        <DynamicIcon name="tabler:map-pin-filled" width="12" height="12" />
                        {/* 地点文字单独占一个盒子：ellipsis 只能落在自己的块上，直接给
                            inline-flex 容器写 text-overflow 是不生效的（M8-3a） */}
                        <span class="album-card__place-text">{location}</span>
                    </span>
                )
            }
        </span>
    </span>
</a>

<style>
    .album-card {
        display: flex;
        flex-direction: column;
        gap: var(--space-2);
        /* 等高格子（M8-3a）：相册墙是 grid-auto-rows:1fr + stretch，卡片撑满行高；
           说明区 flex:1 把 meta 压到卡片底部，同一行的日期/地点永远在同一条基线上。 */
        block-size: 100%;
        text-decoration: none;
        color: inherit;
        min-inline-size: 0;
    }

    .album-card__cover {
        position: relative;
        display: block;
        /* 比例锁：1 / 2 / 3 列都用 4:3，列数变化不改比例（改比例 = 卡片高度跳） */
        aspect-ratio: 4 / 3;
        overflow: hidden;
        border-radius: var(--radius-lg);
        background-color: var(--color-bg-muted);
        box-shadow: var(--shadow-1);
        transition: box-shadow var(--duration-base) var(--ease-standard);
    }

    .album-card__image {
        inline-size: 100%;
        block-size: 100%;
        object-fit: cover;
        display: block;
        transition: transform var(--duration-base) var(--ease-standard);
    }

    .album-card__placeholder {
        display: flex;
        align-items: center;
        justify-content: center;
        block-size: 100%;
        font-size: var(--text-2xl);
    }

    /* 徽标压在照片上：实心底 + 默认前景色，axe 才能判定对比度 */
    .album-card__count {
        position: absolute;
        inset-block-start: var(--space-2);
        inset-inline-end: var(--space-2);
        padding: var(--space-1) var(--space-2);
        border: 1px solid var(--color-border-subtle);
        border-radius: var(--radius-pill);
        background-color: var(--color-bg-surface);
        color: var(--color-fg-default);
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        letter-spacing: var(--tracking-wide);
        /* 徽标永远不越出封面（1 列 320px 的手机也不会把「1234 张」挤出圆角） */
        white-space: nowrap;
        max-inline-size: calc(100% - var(--space-4));
    }

    .album-card__body {
        display: flex;
        flex: 1 1 auto;
        flex-direction: column;
        gap: var(--space-1);
        min-inline-size: 0;
    }

    /* 标题最多 2 行：长相册名（尤其英文）不再把卡片撑高、把同行的卡片推成锯齿 */
    .album-card__name {
        display: -webkit-box;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 2;
        overflow: hidden;
        overflow-wrap: anywhere;
        margin: 0;
        font-family: var(--font-serif);
        font-size: var(--text-lg);
        font-weight: var(--font-weight-semibold);
        line-height: var(--leading-tight);
        color: var(--color-fg-heading);
    }

    .album-card__desc {
        display: -webkit-box;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 2;
        overflow: hidden;
        overflow-wrap: anywhere;
        font-size: var(--text-sm);
        line-height: var(--leading-relaxed);
        color: var(--color-fg-muted);
    }

    /* 元信息锁一行：日期不换行，地点先让位（省略号），两者都带不掉行高 */
    .album-card__meta {
        display: flex;
        flex-wrap: nowrap;
        align-items: center;
        gap: var(--space-2);
        margin-block-start: var(--space-1);
        overflow: hidden;
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        letter-spacing: var(--tracking-wide);
        color: var(--color-fg-muted);
        white-space: nowrap;
    }

    .album-card__date {
        flex: 0 0 auto;
    }

    .album-card__place {
        display: inline-flex;
        align-items: center;
        gap: var(--space-1);
        min-inline-size: 0;
    }

    .album-card__place :global(svg) {
        flex: 0 0 auto;
    }

    .album-card__place-text {
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .album-card:focus-visible {
        outline: 2px solid var(--color-accent-solid);
        outline-offset: 2px;
        border-radius: var(--radius-lg);
    }

    @media (hover: hover) {
        .album-card:hover .album-card__cover {
            box-shadow: var(--shadow-3);
        }

        .album-card:hover .album-card__image {
            transform: scale(1.03);
        }
    }
</style>
