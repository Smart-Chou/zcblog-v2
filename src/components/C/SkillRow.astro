---
/**
 * SkillRow — C 层（M8-2 技能页）
 *
 * 一行技能：`名称（1fr）｜等级文字｜刻度`，备注另起一行（规格 §4.6）。
 * - 行**不可点、不可聚焦**（没有链接也没有展开），因此没有 hover；
 * - 等级始终有文字（N5），刻度只是装饰；
 * - `data-level` / `data-group-id` 是筛选模块的匹配属性（规格 §1.6.4）；
 * - 未知等级（防御 B-4）渲染成「未知」+ 全暗刻度，保留原始 `data-level`，不抛错。
 */
import {
    SKILL_LEVEL_RANK,
    pick,
    skillLevelLabel,
    type EntityLocale,
    type Skill,
    type SkillLevel,
} from "~/types/entities";
import SkillMeter from "./SkillMeter.astro";

interface Props {
    skill: Skill;
    locale: EntityLocale;
    /** 所属分组 id：筛选「领域」组按它匹配。 */
    groupId: string;
}

const KNOWN_LEVELS: readonly string[] = ["exploring", "working", "solid", "deep"];

const { skill, locale, groupId } = Astro.props;

const note = pick(skill.note, locale);
const isKnown = KNOWN_LEVELS.includes(skill.level);
const rank = isKnown ? (SKILL_LEVEL_RANK[skill.level as SkillLevel] ?? 0) : 0;
const levelLabel = isKnown
    ? skillLevelLabel(skill.level, locale)
    : locale === "en"
      ? "Unknown"
      : "未知";
---

<li
    class="skill"
    data-entity-item
    data-skill={skill.name}
    data-level={skill.level}
    data-group-id={groupId}
>
    <div class="skill__main">
        <h3 class="skill__name">{skill.name}</h3>
        <span class="skill__level" data-level={skill.level} data-known={isKnown ? "true" : "false"}>
            {levelLabel}
        </span>
        <SkillMeter value={rank} />
    </div>
    {
        (note || skill.since) && (
            <p class="skill__note">
                {skill.since && <span class="skill__since">{skill.since}</span>}
                {note}
            </p>
        )
    }
</li>

<style>
    .skill {
        display: block;
        padding-block: var(--space-3);
        border-block-start: 1px solid var(--color-border-subtle);
    }

    /* 筛选用的是 hidden 属性；类上的 display 会盖掉 UA 的 [hidden] 规则，这里显式收口 */
    .skill[hidden] {
        display: none;
    }

    .skill:first-child {
        padding-block-start: 0;
        border-block-start: 0;
    }

    .skill__main {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto auto;
        align-items: baseline;
        gap: var(--space-1) var(--space-3);
    }

    .skill__name {
        margin: 0;
        font-family: var(--font-sans);
        font-size: var(--text-base);
        font-weight: var(--font-weight-semibold);
        line-height: var(--leading-snug);
        color: var(--color-fg-default);
        /* 长英文名 / URL 不许把行撑破 */
        overflow-wrap: anywhere;
    }

    .skill__level {
        font-family: var(--font-sans);
        font-size: var(--text-xs);
        font-weight: var(--font-weight-semibold);
        line-height: var(--leading-normal);
        /* 等级不是状态，不单独上色 */
        color: var(--color-fg-muted);
        white-space: nowrap;
    }

    .skill__level[data-known="false"] {
        text-decoration: underline dotted;
    }

    .skill__note {
        margin: var(--space-1) 0 0;
        font-size: var(--text-sm);
        line-height: var(--leading-normal);
        color: var(--color-fg-muted);
        /* 备注最多 2 行（B-1） */
        display: -webkit-box;
        -webkit-line-clamp: 2;
        line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        overflow-wrap: anywhere;
    }

    .skill__since {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        letter-spacing: var(--tracking-wide);
        color: var(--color-fg-subtle);
    }

    .skill__since::after {
        content: " · ";
    }

    /* 769–1023 / ≤768：名称独占一行，等级与刻度落到第二行（规格 §4.3） */
    @media (width < 1024px) {
        .skill__main {
            grid-template-columns: minmax(0, 1fr) auto;
        }

        .skill__name {
            grid-column: 1 / -1;
        }
    }
</style>
