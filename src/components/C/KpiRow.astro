---
/**
 * KpiRow — C 层（M8-2）
 *
 * `<dl>` 让读屏把「5 / 个项目」读成一对，而不是两段散字。
 * 固定 4 块：不因某一项为 0 而少渲染（少一块会让栅格留洞，读者以为布局坏了）。
 * 样式在 `src/styles/pages/entities-projects.css`（`.entity-kpi*`）。
 */
import KpiTile from "./KpiTile.astro";

export interface KpiItem {
    label: string;
    value: string | number;
    unit?: string;
    icon?: string;
    stale?: boolean;
    staleLabel?: string;
}

interface Props {
    items: KpiItem[];
    /** 读屏用的整组说明（视觉隐藏）。 */
    label?: string;
    class?: string;
}

const { items, label, class: className } = Astro.props;
---

<dl class:list={["entity-kpi", className]} aria-label={label}>
    {
        items.map((item) => (
            <KpiTile
                label={item.label}
                value={item.value}
                unit={item.unit}
                icon={item.icon}
                stale={item.stale}
                staleLabel={item.staleLabel}
            />
        ))
    }
</dl>
