---
/**
 * GameCard — C 层（M2-7b；M8-6-1 视觉重做）单条游戏记录
 *
 * 契约：只吃 `Game`（src/types/entities.ts）+ locale，0 数据、0 站点私有文案。
 * 外壳复用 `UI/atom/Card.astro`（D-0149 一页一主方案）：**不给 Card 加 prop**，
 * 语义钩子 `.game-card` 与 `data-game-*` 落在 `<li>` 上，Card 只负责纸面与 hover。
 *
 * 结构（`gaming_hub_2` 的无图版）：
 *   media  —— 16:9 色块 banner：序号（装饰）+ 平台·年份（唯一事实来源，不引第三方封面）
 *   header —— 标题 + 评分（仅 rating 有值时才出 5 格 + 「n/5」）
 *   content— 一句话评价
 *   footer —— 状态文案 + 时长文本
 *
 * 两张诚实性红线：
 *   1. 卡片没有封面字段（`Game` 无 `cover`）→ banner 走色块，不加载站外封面、不空 `<img>`。
 *   2. 没有分母（只有 `hours`，没有 total）→ **不渲染** `role="progressbar"`，只出时长文本。
 *
 * a11y：序号与五星刻度都是装饰（aria-hidden）；评分另有「4/5」文字，不让只数格子的人
 * 拿不到分数。没填 rating 就不渲染评分块，不显示 0 分。
 */
import Card from "~/components/UI/atom/Card.astro";
import {
    gamePlatformLabel,
    gameStatusLabel,
    pick,
    type EntityLocale,
    type Game,
} from "~/types/entities";

interface Props {
    game: Game;
    /** 列表序号（从 1 起），只做视觉编号。 */
    index: number;
    locale: EntityLocale;
}

const { game, index, locale } = Astro.props;

const title = pick(game.title, locale);
const note = pick(game.note, locale);
const platforms = game.platforms.map((platform) => gamePlatformLabel(platform, locale));
const statusLabel = gameStatusLabel(game.status, locale);
const rating = game.rating ?? null;
const hoursLabel = game.hours ? (locale === "en" ? `${game.hours} h` : `${game.hours} 小时`) : "";
const ordinal = String(index).padStart(2, "0");
const segments = [1, 2, 3, 4, 5] as const;
---

<li
    class="game-card"
    data-game-id={game.id}
    data-game-status={game.status}
    data-game-platforms={game.platforms.join(" ")}
    data-game-rating={rating ?? ""}
>
    <Card as="div" variant="interactive" padding="md" class="game-card__surface">
        <div slot="media" class="game-card__banner">
            <span class="game-card__index" aria-hidden="true">{ordinal}</span>
            <p class="game-card__meta">
                <span class="game-card__platforms">{platforms.join(" · ")}</span>
                {
                    game.year && (
                        <>
                            <span class="game-card__sep" aria-hidden="true">
                                ·
                            </span>
                            <span class="game-card__year">{game.year}</span>
                        </>
                    )
                }
            </p>
        </div>

        <div slot="header" class="game-card__head">
            <h3 class="game-card__title">{title}</h3>
            {
                rating !== null && (
                    <p class="game-card__rating" data-rating={rating}>
                        <span class="game-card__scale" aria-hidden="true">
                            {segments.map((segment) => (
                                <i
                                    class:list={["game-card__seg", { "is-on": segment <= rating }]}
                                />
                            ))}
                        </span>
                        {/* 分数必须有一段可读文字：刻度条只是给眼睛的，读屏读到的是「4/5」 */}
                        <span class="game-card__score">{rating}/5</span>
                    </p>
                )
            }
        </div>

        <p class="game-card__note">{note}</p>

        <div slot="footer" class="game-card__foot">
            <span class="game-card__state">{statusLabel}</span>
            {hoursLabel && <span class="game-card__hours">{hoursLabel}</span>}
        </div>
    </Card>
</li>
