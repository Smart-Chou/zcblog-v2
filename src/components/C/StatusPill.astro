---
/**
 * StatusPill — C 层（M8-2）
 *
 * 状态徽标：文字 + 圆点双通道，颜色只是第三通道。tone 决定配色，文字永远在 DOM 里。
 * 样式在 `src/styles/pages/entities-projects.css`（`.status-pill*`），本组件不带 <style>。
 */
export type StatusTone = "success" | "info" | "neutral" | "warning";

interface Props {
    label: string;
    tone?: StatusTone;
    class?: string;
}

const { label, tone = "neutral", class: className } = Astro.props;
---

<span class:list={["status-pill", className]} data-tone={tone}>
    <span class="status-pill__dot" aria-hidden="true"></span>
    {label}
</span>
