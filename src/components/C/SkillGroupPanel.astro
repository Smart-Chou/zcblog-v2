---
/**
 * SkillGroupPanel — C 层（M8-2 技能页）
 *
 * 一个领域 = 一张面板（规格 §4.6）：
 *   序号 + 标题 + 说明 + 计数（组头，底部 1px 分隔）→ 技能行列表。
 *
 * - 外壳复用 `Card variant="flat" padding="md"`（surface / 1px subtle / --radius-lg / --space-6），
 *   组件只写内部排版；边框、圆角、底色、reduced-motion 全由 Card 负责。
 * - 外层 `<div data-entity-group>` 是筛选模块的挂点：`hidden` 落在它身上（Card 不收属性），
 *   组头计数由 `entity-filter.ts` 按可见行数改写（`3 / 5 项`）。
 * - a11y：`<section aria-labelledby>`，组头 `h2`、行内名称 `h3`，层级不跳。
 */
import Card from "~/components/UI/atom/Card.astro";
import { pick, type EntityLocale, type SkillGroup } from "~/types/entities";
import SkillRow from "./SkillRow.astro";

interface Props {
    group: SkillGroup;
    /** 组序号（从 1 起），用于视觉编号。 */
    index: number;
    locale: EntityLocale;
    /** 组头计数的单位（`项` / `skills`），i18n 由页面注入。 */
    unit: string;
}

const { group, index, locale, unit } = Astro.props;

const title = pick(group.title, locale);
const summary = pick(group.summary, locale);
const ordinal = String(index).padStart(2, "0");
const total = group.items.length;
const countLabel = `${total} ${unit}`;
const headingId = `skill-group-${group.id}`;
---

<div
    class="skill-groups__cell"
    data-entity-group
    data-group-id={group.id}
    data-group-total={total}
    data-group-unit={unit}
>
    <Card variant="flat" padding="md" as="section" labelledby={headingId} class="skill-group">
        <Fragment slot="header">
            <header class="skill-panel__head">
                <span class="skill-panel__index" aria-hidden="true">{ordinal}</span>
                <div class="skill-panel__intro">
                    <h2 class="skill-panel__title" id={headingId}>{title}</h2>
                    {summary && <p class="skill-panel__summary">{summary}</p>}
                </div>
                <p class="skill-panel__count" data-group-count>{countLabel}</p>
            </header>
        </Fragment>

        <ul class="skill-panel__list" role="list">
            {
                group.items.map((skill) => (
                    <SkillRow skill={skill} locale={locale} groupId={group.id} />
                ))
            }
        </ul>
    </Card>
</div>

<style>
    .skill-groups__cell {
        display: flex;
        min-inline-size: 0;
    }

    .skill-groups__cell > :global(*) {
        inline-size: 100%;
    }

    .skill-panel__head {
        display: grid;
        grid-template-columns: auto minmax(0, 1fr) auto;
        align-items: start;
        gap: var(--space-3) var(--space-4);
        padding-block-end: var(--space-3);
        border-block-end: 1px solid var(--color-border-subtle);
    }

    .skill-panel__index {
        padding-block-start: var(--space-1);
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        line-height: var(--leading-snug);
        letter-spacing: var(--tracking-wide);
        color: var(--color-fg-subtle);
        font-variant-numeric: tabular-nums;
    }

    .skill-panel__intro {
        display: flex;
        flex-direction: column;
        gap: var(--space-1);
        min-inline-size: 0;
    }

    .skill-panel__title {
        margin: 0;
        font-family: var(--font-serif);
        font-size: var(--text-xl);
        font-weight: var(--font-weight-semibold);
        line-height: var(--leading-tight);
        letter-spacing: var(--tracking-tight);
        color: var(--color-fg-heading);
        overflow-wrap: anywhere;
    }

    .skill-panel__summary {
        margin: 0;
        max-inline-size: var(--measure-prose);
        font-size: var(--text-sm);
        line-height: var(--leading-normal);
        color: var(--color-fg-muted);
        display: -webkit-box;
        -webkit-line-clamp: 2;
        line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .skill-panel__count {
        margin: 0;
        padding-block-start: var(--space-1);
        font-size: var(--text-sm);
        color: var(--color-fg-muted);
        white-space: nowrap;
        font-variant-numeric: tabular-nums;
    }

    .skill-panel__list {
        display: flex;
        flex-direction: column;
        margin: var(--space-1) 0 0;
        padding: 0;
        list-style: none;
    }

    @media (width < 768px) {
        .skill-panel__head {
            grid-template-columns: auto minmax(0, 1fr);
        }

        .skill-panel__count {
            grid-column: 1 / -1;
        }
    }
</style>
