---
/**
 * Dogeared Radio dock — `/radio/` prototype (M8-7 后续，not the final M8-4 SitePlayer)
 *
 * Two live streams only:
 *   - Radio Paradise Main Mix (default)  https://stream.radioparadise.com/mp3-128
 *   - Nightride FM                        https://stream.nightride.fm/nightride.mp3
 *
 * The audio element is intentionally `preload="none"`: no bytes until the visitor
 * presses play. Playback is stopped when the route is left; the dock is page-scoped,
 * so it does not add a site-wide player or a cross-page singleton.
 *
 * CSP: `media-src` in ContentSecurityPolicy.astro whitelists exactly these two origins.
 * No now-playing API: Radio Paradise's endpoint has no CORS header, so the dock shows
 * a truthful "LIVE" status and links to the station's own now-playing page.
 */
const stations = [
    {
        id: "radioparadise",
        name: "Radio Paradise",
        detail: "Human-curated · Main Mix",
        note: "Eclectic rock, electronic and world music. No ads, listener-supported.",
        url: "https://stream.radioparadise.com/mp3-128",
        home: "https://radioparadise.com/music/what-is-playing",
    },
    {
        id: "nightride",
        name: "Nightride FM",
        detail: "Synthwave · 24/7",
        note: "Synthwave and cyberpunk sub-channels, with live DJ shows and IRC.",
        url: "https://stream.nightride.fm/nightride.mp3",
        home: "https://nightride.fm/",
    },
] as const;
---

<aside class="radio-dock" data-radio-dock data-state="collapsed" aria-label="Dogeared Radio">
    <audio data-radio-audio preload="none"></audio>

    <div class="radio-dock__bar">
        <button
            class="radio-dock__toggle"
            type="button"
            data-radio-toggle
            aria-expanded="false"
            aria-controls="radio-dock-panel"
        >
            <span class="radio-dock__signal" aria-hidden="true"></span>
            <span class="radio-dock__brand">DOGEARED RADIO</span>
            <span class="radio-dock__live" data-radio-live>STANDBY</span>
        </button>
        <button
            class="radio-dock__play"
            type="button"
            data-radio-play
            aria-label="播放电台"
            aria-pressed="false"
        >
            <svg
                data-radio-icon="play"
                viewBox="0 0 24 24"
                width="18"
                height="18"
                aria-hidden="true"
                focusable="false"
            >
                <path d="M8 5.5v13l10-6.5-10-6.5Z" fill="currentColor"></path>
            </svg>
            <svg
                data-radio-icon="pause"
                viewBox="0 0 24 24"
                width="18"
                height="18"
                aria-hidden="true"
                focusable="false"
                hidden
            >
                <path d="M8 5.5h3v13H8zM13 5.5h3v13h-3z" fill="currentColor"></path>
            </svg>
        </button>
    </div>

    <div class="radio-dock__panel" id="radio-dock-panel" data-radio-panel hidden>
        <p class="radio-dock__eyebrow">NOW TUNED</p>
        <h2 class="radio-dock__name" data-radio-name>{stations[0].name}</h2>
        <p class="radio-dock__note" data-radio-note>{stations[0].note}</p>

        <div class="radio-dock__stations" role="group" aria-label="选择电台">
            {
                stations.map((station, index) => (
                    <button
                        class="radio-dock__station"
                        type="button"
                        data-radio-station={station.id}
                        aria-pressed={index === 0 ? "true" : "false"}
                    >
                        <span class="radio-dock__station-name">{station.name}</span>
                        <span class="radio-dock__station-detail">{station.detail}</span>
                    </button>
                ))
            }
        </div>

        <div class="radio-dock__controls">
            <label class="radio-dock__volume">
                <span class="radio-dock__volume-label">Volume</span>
                <input
                    type="range"
                    min="0"
                    max="100"
                    value="72"
                    data-radio-volume
                    aria-label="音量"
                />
            </label>
            <a
                class="radio-dock__home"
                data-radio-home
                href={stations[0].home}
                target="_blank"
                rel="noopener noreferrer">官方站点 <span aria-hidden="true">↗</span></a
            >
        </div>

        <p class="radio-dock__status" data-radio-status role="status" aria-live="polite">
            Ready · 选择一个电台
        </p>
    </div>
</aside>

<style>
    .radio-dock {
        position: fixed;
        inset-inline-end: var(--space-6);
        inset-block-end: var(--space-6);
        z-index: var(--z-overlay, 60);
        inline-size: min(24rem, calc(100vw - var(--space-8)));
        border: 1px solid var(--color-border-default);
        border-radius: var(--radius-xl);
        background: var(--color-bg-raised);
        box-shadow: var(--shadow-5);
        color: var(--color-fg-default);
        font-family: var(--font-sans);
    }

    .radio-dock__bar {
        display: flex;
        align-items: center;
        gap: var(--space-2);
        min-block-size: 56px;
        padding: var(--space-2) var(--space-2) var(--space-2) var(--space-4);
    }

    .radio-dock__toggle {
        display: flex;
        flex: 1;
        align-items: center;
        gap: var(--space-2);
        min-inline-size: 0;
        min-block-size: 44px;
        padding: 0;
        border: 0;
        background: transparent;
        color: inherit;
        font: inherit;
        text-align: start;
        cursor: pointer;
    }

    .radio-dock__toggle:focus-visible,
    .radio-dock__play:focus-visible,
    .radio-dock__station:focus-visible,
    .radio-dock__home:focus-visible {
        outline: 2px solid var(--color-ring-focus);
        outline-offset: 2px;
    }

    .radio-dock__signal {
        inline-size: 7px;
        block-size: 7px;
        flex: 0 0 7px;
        border-radius: var(--radius-pill);
        background: var(--color-status-success-solid);
    }

    .radio-dock[data-playing="true"] .radio-dock__signal {
        box-shadow: 0 0 0 3px var(--color-status-success-bg);
    }

    .radio-dock__brand {
        overflow: hidden;
        color: var(--color-fg-heading);
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        font-weight: var(--font-weight-semibold);
        letter-spacing: 0.08em;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .radio-dock__live {
        flex: 0 0 auto;
        color: var(--color-fg-default);
        font-family: var(--font-mono);
        font-size: 10px;
        letter-spacing: 0.08em;
    }

    .radio-dock[data-playing="true"] .radio-dock__live {
        color: var(--color-status-success-fg);
    }

    .radio-dock__play {
        display: grid;
        place-items: center;
        inline-size: 44px;
        block-size: 44px;
        flex: 0 0 44px;
        border: 1px solid var(--color-border-strong);
        border-radius: var(--radius-pill);
        background: var(--color-bg-surface);
        color: var(--color-fg-heading);
        cursor: pointer;
    }

    .radio-dock__play:hover {
        background: var(--color-bg-hover);
    }

    .radio-dock__play svg[hidden] {
        display: none;
    }

    .radio-dock__panel {
        display: flex;
        flex-direction: column;
        gap: var(--space-3);
        padding: 0 var(--space-4) var(--space-4);
        border-block-start: 1px solid var(--color-border-subtle);
    }

    .radio-dock__panel[hidden] {
        display: none;
    }

    .radio-dock__eyebrow {
        margin: var(--space-3) 0 0;
        color: var(--color-fg-heading);
        font-family: var(--font-mono);
        font-size: 10px;
        font-weight: var(--font-weight-semibold);
        letter-spacing: 0.12em;
    }

    .radio-dock__name {
        margin: 0;
        color: var(--color-fg-heading);
        font-family: var(--font-serif);
        font-size: var(--text-xl);
        font-weight: var(--font-weight-regular);
        line-height: var(--leading-tight);
    }

    .radio-dock__note {
        margin: 0;
        color: var(--color-fg-muted);
        font-size: var(--text-xs);
        line-height: var(--leading-relaxed);
    }

    .radio-dock__stations {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: var(--space-2);
    }

    .radio-dock__station {
        display: flex;
        flex-direction: column;
        gap: 2px;
        min-block-size: 44px;
        padding: var(--space-2) var(--space-3);
        border: 1px solid var(--color-border-default);
        border-radius: var(--radius-md);
        background: var(--color-bg-surface);
        color: var(--color-fg-default);
        font: inherit;
        text-align: start;
        cursor: pointer;
    }

    .radio-dock__station[aria-pressed="true"] {
        border-color: var(--color-border-accent);
        background: var(--color-bg-selected);
    }

    .radio-dock__station:hover {
        background: var(--color-bg-hover);
    }

    .radio-dock__station-name {
        font-size: var(--text-xs);
        font-weight: var(--font-weight-semibold);
        line-height: var(--leading-tight);
    }

    .radio-dock__station-detail {
        color: var(--color-fg-muted);
        font-family: var(--font-mono);
        font-size: 10px;
        line-height: var(--leading-relaxed);
    }

    .radio-dock__station[aria-pressed="true"] .radio-dock__station-detail {
        color: var(--color-fg-default);
    }

    .radio-dock__controls {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-3);
        padding-block-start: var(--space-2);
    }

    .radio-dock__volume {
        display: flex;
        align-items: center;
        gap: var(--space-2);
        min-inline-size: 0;
        color: var(--color-fg-default);
        font-family: var(--font-mono);
        font-size: 10px;
    }

    .radio-dock__volume input {
        inline-size: 7rem;
        accent-color: var(--color-accent-solid);
    }

    .radio-dock__home {
        color: var(--color-fg-default);
        font-size: var(--text-xs);
        text-decoration: none;
        white-space: nowrap;
    }

    .radio-dock__home:hover {
        color: var(--color-fg-link-hover);
        text-decoration: underline;
    }

    .radio-dock__status {
        margin: 0;
        color: var(--color-fg-subtle);
        font-family: var(--font-mono);
        font-size: 10px;
        line-height: var(--leading-relaxed);
    }

    @media (max-width: 640px) {
        .radio-dock {
            inset-inline: var(--space-4);
            inset-block-end: calc(60px + var(--space-6) + env(safe-area-inset-bottom, 0px));
            inline-size: auto;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .radio-dock[data-playing="true"] .radio-dock__signal {
            box-shadow: none;
        }
    }
</style>
