---
import { site, footerList, umami } from "~/config";
import DynamicIcon from "../Icons/DynamicIcon.astro";
import { getArticleStats } from "~/utils/article-stats";
import siteStats from "~/data/site-stats.json";

const currentYear = new Date().getFullYear();

// 英文页面：统计/RSS 链接指向英文版
const isEn = Astro.url.pathname.startsWith("/en/");
const prefix = isEn ? "/en" : "";
const rssUrl = isEn ? "/en/rss.xml" : "/rss.xml";

const { totalPosts, totalTags, totalWords } = await getArticleStats();

function formatNumber(num: number): string {
    if (num >= 1000000) return `${(num / 1000000).toFixed(1)}m`;
    if (num >= 1000) return `${(num / 1000).toFixed(1)}k`;
    return num.toString();
}

const stats = [
    { label: "文章", value: formatNumber(totalPosts), url: `${prefix}/archives/` },
    { label: "标签", value: formatNumber(totalTags), url: `${prefix}/tags/` },
    { label: "字数", value: formatNumber(totalWords), url: `${prefix}/archives/` },
];

// 页脚 Umami 计数：构建期静态数字（site-stats.json）+ 访问时实时追平（scripts/umami-counter.ts）
const showUmami = umami.enable && umami.umamiBaseUrl !== "" && umami.shareSlug !== "";
const umamiViews =
    typeof siteStats?.pageviews === "number" && siteStats.pageviews > 0
        ? formatNumber(siteStats.pageviews)
        : null;
---

<footer class="footer" role="contentinfo">
    <!-- Stats bar — custom crafted, no external images -->
    <!-- role="group"：aria-label 挂在无 role 的 div 上不受支持（axe 记 incomplete，全站 546 页），
         group 是最贴近「一组统计入口」的容器角色，不改变布局与读屏顺序。 -->
    <div class="footer-stats" role="group" aria-label="站点统计">
        {
            stats.map((stat) => (
                <a href={stat.url} class="stat-item">
                    <span class="stat-value">{stat.value}</span>
                    <span class="stat-label">{stat.label}</span>
                </a>
            ))
        }
        <span class="stat-divider" aria-hidden="true"></span>
        <a href={rssUrl} class="stat-item stat-item--icon">
            <DynamicIcon name="tabler:rss" />
            <span class="stat-label">RSS</span>
        </a>
        <a href="/sitemap-0.xml" class="stat-item stat-item--icon">
            <DynamicIcon name="tabler:focus-centered" />
            <span class="stat-label">Sitemap</span>
        </a>
    </div>

    <!-- Tech badges row — text chips matching the editorial palette -->
    <div class="footer-tech">
        {
            footerList.map((meta) => (
                <a
                    data-key={`footer-link-${meta.title}`}
                    href={meta.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="tech-badge"
                    aria-label={`${meta.title}: ${meta.text}`}
                >
                    <span class="tech-badge__dot" aria-hidden="true" />
                    <span class="tech-badge__text">
                        {meta.title} · {meta.text}
                    </span>
                </a>
            ))
        }
        {
            showUmami && (
                <a
                    href={`${umami.umamiBaseUrl}/share/${umami.shareSlug}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="tech-badge"
                >
                    <span class="tech-badge__dot" aria-hidden="true" />
                    <span class="tech-badge__text">
                        {"Umami · Analytics"}
                        {umamiViews && (
                            <>
                                {" · "}
                                <span
                                    data-umami-counter
                                    data-umami-base={umami.umamiBaseUrl}
                                    data-umami-share={umami.shareSlug}
                                    data-umami-website={umami.umamiId}
                                >
                                    {umamiViews}
                                </span>
                            </>
                        )}
                    </span>
                </a>
            )
        }
    </div>

    <!-- Meta row -->
    <div class="footer-meta">
        <span class="footer-copyright">
            &copy; {site.startYear}&ndash;{currentYear}
        </span>
        {
            site.beian && (
                <a
                    href={site.beianURL}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="footer-beian"
                >
                    {site.beian}
                </a>
            )
        }
    </div>
</footer>

<script>
    import "~/scripts/umami-counter";
</script>

<style>
    /* M6-1：页脚与 shell 同宽（1140）、同一条 24px 外边距；三段（统计 / 技术栈 / 备案）
       全部走 `--shell-*`，等宽数字与标签统一到 `.mono-*` 的排印口径。 */
    .footer {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: var(--space-3, 12px);
        width: 100%;
        max-width: var(--layout-content-wide, var(--content-width-max));
        margin: var(--space-12, 48px) auto 0;
        padding: var(--space-8, 32px) var(--space-6, 24px) var(--space-6, 24px);
        font-size: var(--text-xs, 0.75rem);
        font-family: var(--font-mono);
        letter-spacing: 0.04em;
        color: var(--shell-fg-muted);
        border-top: 1px solid var(--shell-border);
    }

    /* ---- Stats bar ---- */
    .footer-stats {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0;
    }

    .stat-item {
        display: flex;
        align-items: baseline;
        gap: 5px;
        padding: 5px 12px;
        border-radius: var(--shell-radius-pill);
        color: var(--shell-fg-muted);
        text-decoration: none;
        line-height: 1;
        transition:
            color var(--duration-fast) var(--ease-out),
            background var(--duration-fast) var(--ease-out);
    }

    @media (hover: hover) {
        .stat-item:hover {
            color: var(--shell-accent);
            background: var(--shell-hover);
        }
    }

    .stat-value {
        font-family: var(--font-mono);
        font-size: 0.95em;
        font-weight: 600;
        letter-spacing: -0.02em;
        color: var(--shell-fg-strong);
        font-variant-numeric: tabular-nums;
        line-height: 1;
    }

    .stat-label {
        font-size: 0.85em;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        font-weight: 500;
        line-height: 1;
    }

    .stat-divider {
        display: inline-block;
        width: 1px;
        height: 12px;
        background: var(--shell-border);
        margin: 0 4px;
        border-radius: 1px;
    }

    .stat-svg {
        width: 0.85em;
        height: 0.85em;
        opacity: 0.6;
        flex-shrink: 0;
        transition: opacity var(--duration-fast) var(--ease-out);
    }

    @media (hover: hover) {
        .stat-item:hover .stat-svg {
            opacity: 1;
        }
    }

    /* ---- Tech badges row — 等宽标签胶囊 ---- */
    .footer-tech {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        align-items: center;
        gap: var(--space-2, 8px);
    }

    .tech-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 10px;
        border: 1px solid var(--shell-border);
        border-radius: var(--shell-radius-pill);
        background: var(--shell-surface);
        font-family: var(--font-mono);
        font-size: 0.72em;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: var(--shell-fg-muted);
        text-decoration: none;
        transition:
            color var(--duration-fast) var(--ease-out),
            border-color var(--duration-fast) var(--ease-out),
            background-color var(--duration-fast) var(--ease-out);
    }

    .tech-badge__dot {
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: var(--shell-accent);
        opacity: 0.85;
        flex-shrink: 0;
    }

    /* Umami 计数：保持小写 k（与上方统计行一致），不参与徽章 uppercase 转换 */
    .tech-badge [data-umami-counter] {
        text-transform: none;
    }

    @media (hover: hover) {
        .tech-badge:hover {
            color: var(--shell-fg);
            border-color: var(--shell-border-strong);
            background-color: var(--shell-hover);
        }
    }

    /* ---- Meta row ---- */
    .footer-meta {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        align-items: center;
        gap: var(--space-2, 8px);
        font-size: 0.8em;
        letter-spacing: 0.04em;
    }

    .footer-copyright {
        white-space: nowrap;
    }

    .footer-beian {
        color: inherit;
        text-decoration: none;
        transition: color var(--duration-fast) var(--ease-out);
    }

    @media (hover: hover) {
        .footer-beian:hover {
            color: var(--shell-accent);
        }
    }

    /* ---- Mobile ---- */
    @media screen and (max-width: 768px) {
        .footer {
            padding: var(--space-6, 24px) var(--space-5, 20px);
            gap: 10px;
            margin-top: var(--space-8, 32px);
        }

        .stat-item {
            padding: 4px 8px;
            gap: 4px;
        }

        .stat-divider {
            height: 10px;
            margin: 0 2px;
        }
    }

    @media screen and (max-width: 480px) {
        .footer {
            padding: var(--space-5, 20px) var(--space-4, 16px);
            gap: var(--space-2, 8px);
        }

        .footer-stats {
            flex-wrap: wrap;
            justify-content: center;
            gap: 0;
        }

        .stat-item {
            padding: 4px 6px;
        }

        .stat-value {
            font-size: 0.9em;
        }

        .stat-label {
            letter-spacing: 0.04em;
            font-size: 0.78em;
        }

        .stat-divider {
            display: none;
        }
    }

    @media screen and (max-width: 360px) {
        .stat-item {
            padding: 3px 4px;
        }
    }
</style>
