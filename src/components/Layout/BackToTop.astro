---
import { onPageReady } from "~/utils/page-lifecycle";
import DynamicIcon from "~/components/Icons/DynamicIcon.astro";

interface Props {
    threshold?: number;
}

const { threshold = 300 } = Astro.props;
---

<div id="back-to-top" data-threshold={threshold}>
    <DynamicIcon name="mingcute:arrow-up-circle-fill" width="2rem" height="2rem" />
</div>

<script>
    // 首屏不背返回顶部逻辑；首次滚动/指针交互时再加载。
    const load = () => {
        void import("~/scripts/back-to-top");
    };
    if (window.scrollY > 0) load();
    else {
        window.addEventListener("scroll", load, { once: true, passive: true });
        window.addEventListener("pointerdown", load, { once: true, passive: true });
    }
</script>

