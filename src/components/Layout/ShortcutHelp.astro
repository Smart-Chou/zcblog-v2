---
/**
 * M7-5a：全站键盘 / 手势速查（dialog 模式）
 *
 * 与 M2-5 的「速查 sheet」（overlay-sheets.ts，点导航菜单里的入口）并存：
 * 本组件只负责 `?` / `Ctrl-Cmd + /` 这条键盘通道，外壳是原生 `<dialog>`，
 * 因此 Esc、Tab 循环、`::backdrop`、关闭后焦点归还全部由浏览器 + overlay 基座（passive）提供。
 *
 * 关闭态成本 = 0：`<dialog>` 未打开时 UA 就是 `display: none`，不占布局、不请求任何 chunk。
 * 文案表在 `~/scripts/shortcuts` 的 chunk 里吗？不 —— 键位表在这里是静态标记（零 JS），
 * chunk 只装开合逻辑（首次按键才下载）。
 *
 * 沿用 overlays.css 的 `.ovl__*` 基元（面板 / 标题 / 关闭键 / 键帽），本卡不新增浮层基座样式。
 * overlays.css 平时由 Search / PostShare 引入；splash 模板没有 Header，这里显式 import 兜底。
 */
import "~/styles/pages/overlays.css";

interface Props {
    locale?: string;
}

const { locale = "zh" } = Astro.props;
const isEn = locale === "en";

/** 组合键写成一个字符串（空格分键）：拆多个 <kbd> 会触发 axe 短文本 color-contrast incomplete */
const KEYS = {
    search: isEn ? "⌘ K" : "⌘ K",
    help: "?",
    helpAlt: isEn ? "⌘ /" : "Ctrl /",
    close: "Esc",
    prevNext: "←/→",
};

const t = isEn
    ? {
          title: "Keyboard shortcuts",
          close: "Close",
          groups: [
              {
                  title: "Site",
                  rows: [
                      ["Search", KEYS.search],
                      ["Open this sheet", KEYS.help],
                      ["Open this sheet (alternative)", KEYS.helpAlt],
                      ["Close overlays / lightbox", KEYS.close],
                  ],
              },
              {
                  title: "Image lightbox",
                  rows: [["Previous / next", KEYS.prevNext]],
              },
          ],
          hint: "Shortcuts stay out of the way while typing in a field.",
      }
    : {
          title: "键盘快捷键",
          close: "关闭",
          groups: [
              {
                  title: "全站",
                  rows: [
                      ["搜索", KEYS.search],
                      ["打开本速查", KEYS.help],
                      ["打开本速查（备选）", KEYS.helpAlt],
                      ["关闭弹层 / 灯箱", KEYS.close],
                  ],
              },
              {
                  title: "图片灯箱",
                  rows: [["上一张 / 下一张", KEYS.prevNext]],
              },
          ],
          hint: "在输入框里打字时，快捷键不会抢键。",
      };

/** 关闭图标用 SVG（可见文本「×」会让 axe 的 label-content-name-mismatch 变 incomplete） */
const CLOSE_ICON =
    '<svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M15 5 5 15M5 5l10 10"></path></svg>';
---

<dialog id="shortcut-help" class="shortcut-help" aria-labelledby="shortcut-help-title">
    <div class="shortcut-help__panel ovl__panel">
        <h2 class="ovl__title" id="shortcut-help-title">{t.title}</h2>
        <button
            type="button"
            class="ovl__close shortcut-help__close"
            data-shortcut-close
            aria-label={t.close}
            set:html={CLOSE_ICON}
        />
        {
            t.groups.map((group) => (
                <section class="shortcut-help__group">
                    <h3 class="shortcut-help__heading">{group.title}</h3>
                    <dl class="ovl__rows shortcut-help__rows">
                        {group.rows.map(([label, keys]) => (
                            <div class="ovl__row">
                                <dt>{label}</dt>
                                <dd>
                                    <kbd class="ovl__kbd">{keys}</kbd>
                                </dd>
                            </div>
                        ))}
                    </dl>
                </section>
            ))
        }
        <p class="shortcut-help__hint">{t.hint}</p>
    </div>
</dialog>

<script>
    /**
     * 常驻的手指很轻：一个 window 捕获监听（关掉一个键就 return），首次命中才 import 逻辑 chunk。
     *
     * 为什么挂在 `window` 捕获阶段并 `stopImmediatePropagation`：M2-5 的 overlay.ts 在
     * `document` 捕获阶段也认 `?`（打开旧速查 sheet）。两个入口都活着会同时开出两块面板，
     * 而本卡的源文件边界不允许改 overlay.ts —— 在 window 捕获层截断，键位从此只归 dialog。
     * 后续把 overlay.ts 里那段 `?` 分支删掉即可移除此闸（见卡内交接说明）。
     */
    const EDITABLE = "input, textarea, select, [contenteditable]:not([contenteditable='false'])";

    const isHelpKey = (event: KeyboardEvent): boolean => {
        if (event.altKey) return false;
        if (event.key === "?") return !event.metaKey && !event.ctrlKey;
        // Ctrl/Cmd + /（美式布局）；部分布局下 key 是 "?" + 修饰键，上面分支已覆盖
        return event.key === "/" && (event.metaKey || event.ctrlKey);
    };

    let pending = false;

    window.addEventListener(
        "keydown",
        (event) => {
            if (!isHelpKey(event)) return;
            const target = event.target as HTMLElement | null;
            if (target?.closest(EDITABLE)) return;
            const dialog = document.getElementById("shortcut-help") as HTMLDialogElement | null;
            if (!dialog || dialog.open) return;
            event.preventDefault();
            event.stopImmediatePropagation();
            if (pending) return;
            pending = true;
            import("~/scripts/shortcuts")
                .then((mod) => {
                    pending = false;
                    mod.openShortcutHelp();
                })
                .catch(() => {
                    pending = false;
                });
        },
        true,
    );
</script>

<style>
    /* 原生 dialog：去掉 UA 内边距/边框，让面板自己决定尺寸；点面板外的遮罩区（命中 dialog 本身）即关闭 */
    .shortcut-help {
        max-width: min(30rem, calc(100% - var(--space-4) * 2));
        max-height: 100dvh;
        padding: 0;
        overflow: visible;
        border: 0;
        background: transparent;
        color: var(--color-fg-default);
    }

    .shortcut-help::backdrop {
        background: var(--color-bg-scrim);
    }

    .shortcut-help__panel {
        width: min(30rem, 100%);
        max-height: min(80dvh, 40rem);
    }

    .shortcut-help__group + .shortcut-help__group {
        margin-top: var(--space-5);
    }

    .shortcut-help__heading {
        margin: var(--space-5) 0 0;
        font-size: var(--text-xs);
        font-weight: var(--font-weight-semibold);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--color-fg-muted);
    }

    .shortcut-help__rows {
        margin-top: var(--space-3);
    }

    .shortcut-help__hint {
        margin: var(--space-5) 0 0;
        font-size: var(--text-sm);
        color: var(--color-fg-muted);
    }

    /* 移动断点：贴底的全宽 sheet（overlays.css 的 .ovl__panel 规则在这个断点也是全宽 + 上圆角） */
    @media screen and (max-width: 768px) {
        .shortcut-help {
            width: 100%;
            max-width: 100%;
            margin: auto auto 0;
        }

        .shortcut-help__panel {
            max-height: 85dvh;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .shortcut-help,
        .shortcut-help::backdrop,
        .shortcut-help__panel {
            animation: none;
            transition: none;
        }
    }
</style>
