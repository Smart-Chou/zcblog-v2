---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Logo from "~/components/Layout/Logo.astro";
import Nav from "~/components/Layout/Nav.astro";
import Search from "~/components/UI/Search.astro";
import ToggleTheme from "~/components/Layout/ToggleTheme.astro";
import LanguageSwitcher from "~/components/Layout/LanguageSwitcher.astro";
import { search, site, author } from "~/config";

interface Props {
    searchEnable?: boolean;
    locale?: string;
}

const { searchEnable = search.enable, locale = "zh" } = Astro.props as Props;

/**
 * M6-1：头像组。清单（`selection.md` §9.2 #8）要求 header 右侧有「主题 / 语言 / 头像」组。
 * 头像沿用主题包的资源约定（`~/assets/logo.*`，与 Logo.astro 同一 glob），
 * 也支持 overlay 把 `author.avatar` 配成远端 URL；两者都没有时退化成首字母徽章，
 * 不发任何额外请求。
 */
const avatarModules = import.meta.glob<{ default: ImageMetadata }>("~/assets/logo.*", {
    eager: true,
});
const avatarEntry = Object.entries(avatarModules).find(([key]) => key.endsWith(author.avatar));
const avatarImage = avatarEntry?.[1]?.default;
const avatarRemote = /^https?:\/\//.test(author.avatar) ? author.avatar : null;
const avatarInitial = (author.type || site.title).trim().slice(0, 1).toUpperCase();
---

<header id="progress-container" role="banner">
    <div class="nav-shell">
        <div class="header-left">
            <Logo />
            <span class="header-brand">
                <span class="header-brand-title">{site.title}</span>
                <span class="header-brand-sub">{site.subtitle}</span>
            </span>
        </div>

        <div class="header-actions">
            {
                searchEnable && (
                    <div class="header-search">
                        <Search locale={locale} />
                    </div>
                )
            }

            <Nav />

            <div class="header-tools">
                <LanguageSwitcher />
                <ToggleTheme />
                <a
                    class="header-avatar"
                    href={author.url}
                    rel="me noopener noreferrer"
                    target="_blank"
                    aria-label={author.type}
                >
                    {
                        avatarImage ? (
                            <Image
                                src={avatarImage}
                                alt=""
                                width={64}
                                height={64}
                                class="header-avatar-img"
                                loading="lazy"
                                decoding="async"
                            />
                        ) : avatarRemote ? (
                            <img
                                src={avatarRemote}
                                alt=""
                                class="header-avatar-img"
                                loading="lazy"
                                decoding="async"
                            />
                        ) : (
                            <span class="header-avatar-fallback" aria-hidden="true">
                                {avatarInitial}
                            </span>
                        )
                    }
                </a>
            </div>
        </div>
    </div>
</header>

<script>
    // 滚动超过阈值时给外壳加一层更实的投影。
    // View Transitions 会替换 DOM，必须在 handler 内实时 querySelector。
    // 模块脚本每页只执行一次（swup 只换 #app 内容，模块缓存不会重跑），所以这里
    // 不存在重复绑定；换页后靠 astro:after-swap 重新取一次状态。
    const SCROLL_THRESHOLD = 8;
    function updateNav() {
        const nav = document.querySelector(".nav-shell");
        if (nav) nav.classList.toggle("scrolled", window.scrollY > SCROLL_THRESHOLD);
    }
    updateNav();
    document.addEventListener("scroll", updateNav, { passive: true });
    document.addEventListener("astro:after-swap", updateNav);
</script>

<style>
    /* 全宽吸顶外壳（M6-1）：半透明画布 + 背景模糊 + 1px 下边线。
       高度走 `--layout-header-height`（64 / 56 / 52），与 base.css 的 .main 起点同一来源。 */
    #progress-container {
        position: fixed;
        top: var(--notice-height, 0px);
        left: 0;
        right: 0;
        z-index: 100;
        display: flex;
        justify-content: center;
        background: color-mix(in srgb, var(--shell-canvas) 85%, transparent);
        -webkit-backdrop-filter: blur(14px) saturate(1.4);
        backdrop-filter: blur(14px) saturate(1.4);
        border-bottom: 1px solid var(--shell-border);
        view-transition-name: none;
        transform: translateZ(0);
        transition:
            top var(--duration-slow) var(--ease-out),
            box-shadow var(--duration-slow) var(--ease-out);
    }

    .nav-shell {
        width: 100%;
        max-width: var(--layout-content-wide, var(--content-width-max));
        height: var(--shell-header-h);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-4, 16px);
        padding-inline: var(--space-6, 24px);
        transition: box-shadow var(--duration-slow) var(--ease-out);
    }

    .nav-shell.scrolled {
        box-shadow: inset 0 -1px 0 var(--shell-border);
    }

    .header-left,
    .header-actions,
    .header-tools {
        display: flex;
        align-items: center;
    }

    .header-left {
        min-width: 0;
        gap: var(--space-3, 12px);
    }

    /* 字标：Logo 图 + 站名/副标题（设计稿 header 左侧是 wordmark 而不是单独一枚头像） */
    .header-brand {
        display: flex;
        flex-direction: column;
        justify-content: center;
        min-width: 0;
        line-height: 1.15;
    }

    .header-brand-title {
        font-family: var(--font-heading);
        font-size: var(--text-lg, 1.125rem);
        font-weight: 600;
        letter-spacing: -0.01em;
        color: var(--shell-fg-strong);
        white-space: nowrap;
    }

    .header-brand-sub {
        font-size: var(--text-xs, 0.75rem);
        color: var(--shell-fg-muted);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .header-actions {
        gap: var(--space-2, 8px);
        flex-shrink: 0;
    }

    .header-tools {
        gap: var(--space-1, 4px);
    }

    /* ---- 搜索触发器：面片胶囊（surface-container-low + 1px 描边），
       宽度/快捷键角标全由 pagefind 自己的变量控制，这里只换皮。 ---- */
    .header-search :global(pagefind-modal-trigger) {
        --pf-input-height: 34px;
        --pf-border-radius: var(--shell-radius-md);
        --pf-background: var(--shell-sunken);
        --pf-border: var(--shell-border);
        --pf-text-muted: var(--shell-fg-muted);
        --pf-text-secondary: var(--shell-fg-muted);
        --pf-font: var(--font-body);
        --pf-hover: var(--shell-sunken-strong);
    }

    .header-search :global(pagefind-modal-trigger::part(button)),
    .header-search :global(.pf-trigger-btn) {
        border: 1px solid var(--shell-border) !important;
        box-shadow: none !important;
    }

    @media (hover: hover) {
        .header-search :global(pagefind-modal-trigger:hover) {
            --pf-background: var(--shell-sunken-strong);
            --pf-border: var(--shell-border-strong);
        }
    }

    /* ---- 工具组：语言 / 主题 / 头像 ---- */
    .header-tools :global(.language-switcher-button) {
        min-height: 34px;
        border: 0;
        background: transparent;
        padding: 0 var(--space-2, 8px);
        font-weight: 500;
        border-radius: var(--shell-radius-md);
        color: var(--shell-fg-muted);
        white-space: nowrap;
        flex-shrink: 0;
        transition:
            color var(--duration-fast) var(--ease-out),
            background-color var(--duration-fast) var(--ease-out);
    }

    @media (hover: hover) {
        .header-tools :global(.language-switcher-button:hover) {
            background-color: var(--shell-hover);
            color: var(--shell-fg);
        }
    }

    .header-tools :global(.toggle-theme) {
        min-width: 34px;
        min-height: 34px;
        padding: 6px;
        border-radius: var(--shell-radius-md);
        color: var(--shell-fg-muted);
    }

    /* 主题图标自带固定的琥珀 / 蓝色（ToggleTheme.astro 未在 M6-1 边界内），
       在外壳里统一收成静音色，只有 hover 才回到正文色。 */
    .header-tools :global(.toggle-theme .feather) {
        color: var(--shell-fg-muted);
        transition: color var(--duration-fast) var(--ease-out);
    }

    @media (hover: hover) {
        .header-tools :global(.toggle-theme:hover .feather) {
            color: var(--shell-fg);
        }
    }

    .header-avatar {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
        margin-left: var(--space-1, 4px);
        border-radius: var(--shell-radius-pill);
        overflow: hidden;
        background: var(--shell-accent);
        color: var(--shell-accent-fg);
        text-decoration: none;
        flex-shrink: 0;
    }

    .header-avatar-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .header-avatar-fallback {
        font-family: var(--font-mono);
        font-size: var(--text-xs, 0.75rem);
        font-weight: 600;
        line-height: 1;
    }

    .header-avatar:focus-visible {
        outline: 2px solid var(--shell-ring);
        outline-offset: 3px;
    }

    /* ---- 断点 ---- */
    @media screen and (max-width: 1280px) {
        .header-brand-sub {
            display: none;
        }
    }

    @media screen and (max-width: 768px) {
        .nav-shell {
            padding-inline: var(--space-5, 20px);
            gap: var(--space-2, 8px);
        }

        .header-actions {
            gap: var(--space-1, 4px);
        }

        /* 搜索只剩图标：文字与 ⌘K 角标由 search-global.css 在 ≤768 收起，
           这里只把触发器收成 34×34。 */
        .header-search :global(pagefind-modal-trigger) {
            max-width: 34px;
            overflow: hidden;
        }
    }

    @media screen and (max-width: 450px) {
        .nav-shell {
            padding-inline: var(--space-4, 16px);
        }

        /* 390 下只留 Logo 图，字标让位给操作组 */
        .header-brand {
            display: none;
        }

        .header-avatar {
            width: 28px;
            height: 28px;
        }
    }
</style>
