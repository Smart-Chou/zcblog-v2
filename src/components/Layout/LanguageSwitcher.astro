---
import DynamicIcon from "~/components/Icons/DynamicIcon.astro";
import { getCollection } from "astro:content";
import {
    defaultLocale,
    enabledLocales,
    getLocale,
    getLocalePath,
    hasLocaleRoute,
    hreflangOf,
    localeLabelOf,
    localeMeta,
    stripLocalePrefix,
    type Locale,
} from "~/utils/i18n";
import { articleLang, articleSlug } from "~/utils/article-url";
import { collectSeriesByLang } from "~/utils/series";

/**
 * 语言切换器（M2-11a）
 *
 * 三条判据：
 * 1. **语言清单只有一个出处**：`enabledLocales()`（= registry ∩ 本次构建开关）。
 *    默认构建仍然只有「中文 / EN」两项，`I18N_LOCALES=all` 才出现 6 项 ——
 *    不会给没构建的语言留下死链。
 * 2. **只送人去真的存在的页**：新语言目前只有 5 个模板路由，其余路径一律回
 *    该语言首页（`hasLocaleRoute`），绝不拼出 `/ja/talks/` 这种 404。
 * 3. **文章页走翻译对照**：有对照直达对照版，没有就落到该语言的博客列表
 *    （中文没有对应文章时也不再硬跳一个 404 的文章 URL）。
 */
const currentLocale = getLocale(Astro.currentLocale || defaultLocale);
const currentPath = Astro.url.pathname;
const enabled = enabledLocales();
/** 语言无关路径：`/ja/blog/1/` → `/blog/1/` */
const basePath = stripLocalePrefix(currentPath);

/**
 * 系列页（M5-12）：`/series/`、`/series/<slug>/` 是**按内容动态生成**的路由，
 * 对侧语言没有同名系列时 `/en/series/<slug>/` 不存在（不是「有页面但空」）。
 * 所以这里与文章页同一套思路：先查构建期集合，确认对侧真有这一页才直达，
 * 否则回落到该语言的系列索引，再退一步回首页 —— 绝不拼出不存在的 URL。
 */
const seriesMatch = basePath.match(/^\/series(?:\/([^/]+))?\/?$/);
const seriesSlug = seriesMatch?.[1] ? decodeURIComponent(seriesMatch[1]) : null;
let seriesHasZh = false;
let seriesHasEn = false;
let seriesHasAnyEn = false;
if (seriesMatch) {
    const all = await getCollection("article", ({ data }) => !(data.draft ?? false));
    const zhSeries = collectSeriesByLang(all, "zh");
    const enSeries = collectSeriesByLang(all, "en");
    seriesHasAnyEn = enSeries.length > 0;
    seriesHasZh = seriesSlug
        ? zhSeries.some((group) => group.slug === seriesSlug)
        : zhSeries.length > 0;
    seriesHasEn = seriesSlug ? enSeries.some((group) => group.slug === seriesSlug) : seriesHasAnyEn;
}

/** 文章页翻译对照查询（构建期一次；非文章页为 null） */
const articleMatch = currentPath.match(/^\/(?:en\/)?article\/([^/]+)\/?$/);
const articleUrlSlug = articleMatch ? decodeURIComponent(articleMatch[1]) : null;
let articleHasZh = false;
let articleHasEn = false;
if (articleUrlSlug) {
    const all = await getCollection("article", ({ data }) => !(data.draft ?? false));
    articleHasZh = all.some((p) => articleLang(p) === "zh" && articleSlug(p) === articleUrlSlug);
    articleHasEn = all.some((p) => articleLang(p) === "en" && articleSlug(p) === articleUrlSlug);
}

function targetPath(locale: Locale): string {
    if (locale === currentLocale) return currentPath;

    // 文章页：有译文对直达对照版；新语言没有正文 → 落到该语言博客列表
    if (articleUrlSlug) {
        if (locale === defaultLocale) {
            return articleHasZh ? `/article/${articleUrlSlug}/` : "/blog/1/";
        }
        if (locale === "en") {
            return articleHasEn ? `/en/article/${articleUrlSlug}/` : "/en/blog/1/";
        }
        return getLocalePath(locale, "/blog/1/");
    }

    // 错误页没有对应版本 → 目标语言首页
    if (/^\/(404|500)\//.test(basePath)) return getLocalePath(locale);

    // 系列页：按构建期集合判断「对侧真有没有这一页」（M5-12）
    if (seriesMatch) {
        if (locale === defaultLocale) return seriesHasZh ? basePath : "/";
        if (locale === "en") {
            if (seriesHasEn) return `/en${basePath}`;
            return seriesHasAnyEn ? "/en/series/" : "/en/";
        }
        return getLocalePath(locale);
    }

    if (locale === "en") {
        // en 是既有手写路由，保持原有回退规则（这几页没有英文版）
        if (/^\/(cookies|copyright|privacy-policy|redirect)\/$/.test(basePath)) return "/en/";
        if (/^\/albums\/[^/]+\/$/.test(basePath)) return "/en/albums/";
        return getLocalePath(locale, basePath);
    }

    // 新语言只有 5 个模板路由：其余路径回该语言首页，不造死链
    if (!hasLocaleRoute(basePath)) return getLocalePath(locale);
    return getLocalePath(locale, basePath);
}

const items = enabled.map((locale) => ({
    locale,
    label: localeLabelOf(locale),
    hreflang: hreflangOf(locale),
    name: localeMeta[locale].name,
    href: targetPath(locale),
    active: locale === currentLocale,
}));
const currentLabel = localeLabelOf(currentLocale);
---

<div class="language-switcher">
    <button
        class="language-switcher-button"
        aria-label={`切换语言，当前：${currentLabel}`}
        aria-expanded="false"
    >
        <span class="language-icon">
            <DynamicIcon name="tabler:world" width="18" height="18" />
        </span>
        <span class="language-label">{currentLabel}</span>
    </button>
    <ul class="language-switcher-dropdown">
        {
            items.map((item) => (
                <li>
                    <a
                        href={item.href}
                        class:list={["language-switcher-link", { active: item.active }]}
                        hreflang={item.locale}
                        lang={item.locale}
                        data-hreflang={item.hreflang === item.locale ? undefined : item.hreflang}
                        aria-label={item.name}
                    >
                        {item.label}
                    </a>
                </li>
            ))
        }
    </ul>
</div>

<style>
    .language-switcher {
        position: relative;
        display: inline-flex;
        align-items: center;
    }

    .language-switcher-button {
        display: flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.35rem 0.6rem;
        background: transparent;
        border: 1px solid var(--color-border);
        border-radius: 6px;
        cursor: pointer;
        color: var(--color-text);
        font-size: 0.85em;
        font-family: var(--font-body);
        transition:
            background-color 0.2s,
            border-color 0.2s;
    }

    @media (hover: hover) {
        .language-switcher-button:hover {
            background-color: var(--color-hover);
            border-color: var(--color-accent);
        }
    }

    .language-icon {
        display: flex;
        align-items: center;
    }

    .language-switcher-dropdown {
        position: absolute;
        top: 100%;
        right: 0;
        margin-top: 0.35rem;
        padding: 0.35rem 0;
        background: var(--color-bg-surface);
        border: 1px solid var(--color-border);
        border-radius: 8px;
        box-shadow: var(--shadow-md);
        list-style: none;
        min-width: max-content;
        opacity: 0;
        visibility: hidden;
        transform: translateY(-8px);
        transition:
            opacity 0.2s,
            visibility 0.2s,
            transform 0.2s;
        z-index: 100;
    }

    @media (hover: hover) {
        .language-switcher:hover .language-switcher-dropdown {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
        }
    }
    .language-switcher:focus-within .language-switcher-dropdown,
    .language-switcher-button[aria-expanded="true"] + .language-switcher-dropdown {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
    }

    .language-switcher-link {
        display: block;
        padding: 0.5rem 1rem;
        color: var(--color-text);
        text-decoration: none;
        font-size: 0.9em;
        transition: background-color 0.2s;
    }

    @media (hover: hover) {
        .language-switcher-link:hover {
            background-color: var(--color-hover);
        }
    }

    .language-switcher-link.active {
        color: var(--color-accent);
        font-weight: 500;
    }

    @media screen and (max-width: 768px) {
        .language-label {
            display: none;
        }

        .language-switcher-button {
            padding: 0.35rem;
            min-width: 40px;
            min-height: 40px;
            justify-content: center;
        }
    }
</style>

<script>
    /**
     * 语言切换器的 href 是构建期按「当前这一页」算的，而 header 在 <main> 外、
     * 换页不替换 —— SPA 跳转后链接还指着首屏那一页（实测：/en/ → /en/blog/1/
     * 之后，「中文」仍指向 /，直接把人扔回首页）。
     *
     * 换页后从 head 的 hreflang 里取真值（SeoLinks 每页都输出，swup 的 updateHead
     * 会跟着换）。M2-11a：hreflang 与 locale 代码不再一一对应（zh-TW → zh-Hant-TW），
     * 所以映射走链接上的 data-hreflang；取不到 alternate 时**保留构建期算好的
     * href**，不再按只有中英两套的旧规则瞎拼。
     *
     * M2-11b（10 门语言）：data-hreflang **只在与 locale 代码不同时才输出**
     * （实际只有 zh-TW），其余按 hreflang 兜底；同时删掉没人读的 data-locale。
     * 原因不是洁癖：10 个链接 × 每页都渲染，archives 这类长列表页的 HTML
     * 预算只剩几百字节（perf-budget.py：list 105KB），多语言一注册就顶穿。
     */
    function altPath(hreflang: string): string | null {
        const link = document.querySelector<HTMLLinkElement>(
            `link[rel="alternate"][hreflang="${hreflang}"]`,
        );
        const href = link?.getAttribute("href");
        if (!href) return null;
        try {
            const url = new URL(href, location.origin);
            return url.pathname + url.search + url.hash;
        } catch {
            return href;
        }
    }

    function currentLocaleCode(codes: string[], path: string): string {
        // 最长前缀优先：/zh-TW/ 不能被 /zh 抢走
        const hit = codes
            .filter((code) => path === `/${code}/` || path.startsWith(`/${code}/`))
            .sort((a, b) => b.length - a.length)[0];
        return hit ?? "zh";
    }

    function syncLanguageSwitcher(): void {
        const root = document.querySelector(".language-switcher");
        if (!root) return;

        const path = location.pathname;
        const links = Array.from(
            root.querySelectorAll<HTMLAnchorElement>(".language-switcher-link"),
        );
        const codes = links
            .map((link) => link.getAttribute("hreflang"))
            .filter((code): code is string => Boolean(code));
        const current = currentLocaleCode(codes, path);

        for (const link of links) {
            const code = link.getAttribute("hreflang");
            if (!code) continue;
            const hreflang = link.getAttribute("data-hreflang") ?? code;
            const target = altPath(hreflang);
            if (target) link.setAttribute("href", target);
            link.classList.toggle("active", code === current);
        }

        const activeLink = links.find((link) => link.getAttribute("hreflang") === current);
        const label = activeLink?.textContent?.trim() ?? "";
        const btn = root.querySelector<HTMLButtonElement>(".language-switcher-button");
        const labelEl = root.querySelector<HTMLElement>(".language-label");
        if (label && labelEl && labelEl.textContent !== label) labelEl.textContent = label;
        if (btn && label) btn.setAttribute("aria-label", `切换语言，当前：${label}`);
    }

    (function () {
        const btn = document.querySelector<HTMLButtonElement>(".language-switcher-button");

        syncLanguageSwitcher();
        document.addEventListener("astro:page-load", syncLanguageSwitcher);

        if (!btn) return;

        btn.addEventListener("click", (e) => {
            e.stopPropagation();
            const expanded = btn.getAttribute("aria-expanded") === "true";
            btn.setAttribute("aria-expanded", String(!expanded));
        });

        // 点击外部关闭
        document.addEventListener("click", () => {
            btn.setAttribute("aria-expanded", "false");
        });

        // SPA 导航后重置
        document.addEventListener("astro:after-swap", () => {
            btn.setAttribute("aria-expanded", "false");
        });
    })();
</script>
