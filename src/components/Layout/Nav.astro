---
import { navLinks } from "~/config";
import { t, getLocale } from "~/utils/i18n";

const loc = getLocale(Astro.currentLocale || "zh");
const isEn = loc === "en";

const currentPath = Astro.url.pathname;

// href → i18n key 映射（href 以中文路径为准，en 页面统一加 /en 前缀）
const navKeyMap: Record<string, string> = {
    "/": "nav.home",
    "/blog/1/": "nav.blog",
    "/talks/": "nav.talks",
    "/albums/": "nav.albums",
    "/bangumi/": "nav.bangumi",
    "/friends/": "nav.friends",
    "/archives/": "nav.archives",
    "/tags/": "nav.tags",
    "/services/": "nav.services",
};

/** 按当前语言解析导航链接（en 页面 → /en...） */
const navHref = (href: string) => (isEn ? (href === "/" ? "/en/" : `/en${href}`) : href);

// 分页路由匹配：/blog/1/ → base=/blog/，匹配 /blog/2/、/blog/3/ 等
function isActive(href: string) {
    if (href === "/" || href === "/en/") return currentPath === href;
    const base = href.replace(/\/\d+\/$/, "/");
    return currentPath.startsWith(base);
}
---

<button
    id="nav-menu-btn"
    class="nav-menu-btn"
    aria-label={loc === "en" ? "Open menu" : "打开菜单"}
    aria-expanded="false"
    type="button"
>
    <span class="nav-menu-btn-icon">
        <span class="nav-menu-btn-bar"></span>
        <span class="nav-menu-btn-bar"></span>
        <span class="nav-menu-btn-bar"></span>
    </span>
</button>

<nav
    id="nav-dropdown"
    class="nav-dropdown"
    aria-label={loc === "en" ? "Main navigation" : "主导航"}
    inert
>
    <ul class="nav-dropdown-list" role="list">
        {
            navLinks.map((link) => {
                const label = navKeyMap[link.href] ? t(loc, navKeyMap[link.href]) : link.label;
                return (
                    <li>
                        <a
                            href={navHref(link.href)}
                            class:list={[
                                "nav-dropdown-link",
                                { active: isActive(navHref(link.href)) },
                            ]}
                        >
                            {label}
                        </a>
                    </li>
                );
            })
        }
        {
            /* M2-5：overlay 入口（键盘速查 / 手势速查）。手势入口只在移动断点出现
               （overlays.css 的 .nav-dropdown-extra--gesture），桌面端隐藏。
               `?` 也能直接开快捷键速查（src/scripts/overlay.ts）。 */
        }
        <li class="nav-dropdown-extra">
            <button
                type="button"
                class="nav-dropdown-link nav-dropdown-link--utility"
                data-ovl-open="shortcuts"
                data-ovl-locale={loc}
            >
                {isEn ? "Shortcuts" : "快捷键"}
            </button>
        </li>
        <li class="nav-dropdown-extra nav-dropdown-extra--gesture">
            <button
                type="button"
                class="nav-dropdown-link nav-dropdown-link--utility"
                data-ovl-open="gestures"
                data-ovl-locale={loc}
            >
                {isEn ? "Gestures" : "手势"}
            </button>
        </li>
    </ul>
</nav>

<script>
    /**
     * 导航高亮：`active` 类原本只在构建期算（isActive(currentPath)），
     * 换成 swup 后导航不参与替换，SPA 跳转时高亮永远停在首屏那一项。
     * 这里按 location.pathname 重算一次，并在每次 astro:page-load 后刷新。
     * 分页路由（/blog/1/）按 base（/blog/）匹配，与构建期口径保持一致。
     */
    function markActiveNav(): void {
        const path = location.pathname;
        document.querySelectorAll<HTMLAnchorElement>(".nav-dropdown-link").forEach((link) => {
            const href = link.getAttribute("href") || "";
            if (!href) return;
            const base = href.replace(/\/\d+\/$/, "/");
            const active = href === "/" || href === "/en/" ? path === href : path.startsWith(base);
            link.classList.toggle("active", active);
            if (active) link.setAttribute("aria-current", "page");
            else link.removeAttribute("aria-current");
        });
    }

    markActiveNav();
    document.addEventListener("astro:page-load", markActiveNav);

    let open = false;
    const supportsInert = "inert" in HTMLElement.prototype;

    const getBtn = () => document.getElementById("nav-menu-btn") as HTMLButtonElement | null;
    const getDropdown = () => document.getElementById("nav-dropdown") as HTMLElement | null;

    const setOpen = (v: boolean) => {
        open = v;
        const btn = getBtn();
        const dropdown = getDropdown();
        if (btn) {
            btn.setAttribute("aria-expanded", String(v));
            btn.classList.toggle("nav-menu-btn--open", v);
        }
        if (dropdown) {
            /* 关闭时只用 inert，不再叠 aria-hidden。
             *
             * inert 本身就等于「整棵子树从无障碍树移出 + 禁止聚焦 + 不可点击」，
             * 而 aria-hidden 只管「不让读屏读到」，两者叠在一起时 Chrome 会拦下来警告：
             *   Blocked aria-hidden on an element because its descendant retained focus
             * —— 换页时焦点还停在 .nav-dropdown-link 上（用户就是点它跳走的），
             * 而这里恰恰是在 astro:after-swap 里跑，于是每次从下拉菜单换页都报一条。
             * 只留 inert 后浏览器会自己把焦点移走，不再有「藏起带焦点的元素」这回事。
             * 不支持 inert 的老浏览器才退回 aria-hidden（此时没有 inert，也就不存在上面那条警告）。
             */
            dropdown.toggleAttribute("inert", !v);
            if (!supportsInert) dropdown.setAttribute("aria-hidden", String(!v));
            dropdown.classList.toggle("nav-dropdown--open", v);
        }
    };

    document.addEventListener("click", (e) => {
        const btn = getBtn();
        const dropdown = getDropdown();
        const target = e.target as Node;

        if (btn && btn.contains(target)) {
            e.stopPropagation();
            setOpen(!open);
            return;
        }

        if (open && dropdown && !dropdown.contains(target)) {
            setOpen(false);
        }
    });

    document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && open) {
            setOpen(false);
            getBtn()?.focus();
        }
    });

    /* M2-5：快捷键速查 / 手势速查入口 —— 见文末 is:inline 脚本。
       这里不留 import()：带动态 import 的 script 会被 Astro 提升成独立文件，
       等于给每页多加一个请求与 0.8KB 首屏 JS（实测 list 页 JS 会超预算）。 */

    window.addEventListener(
        "scroll",
        () => {
            if (open) setOpen(false);
        },
        { passive: true },
    );

    // 换页后把菜单真正收起来。之前这里只写了 `open = false`（只改局部变量），
    // 没走 setOpen：class / aria-expanded / inert 全都留在「打开」状态，
    // 菜单视觉上不消失；而 open 已经变 false，下一次点按钮等于「再打开一次」，
    // 于是表现为点两次才收得回去。导航栏在 <main> 外、不参与替换，所以必须显式收。
    document.addEventListener("astro:after-swap", () => {
        setOpen(false);
    });
</script>

<script is:inline>
    /* M2-5：快捷键 / 手势速查入口。
       overlay 基座是按需加载的（关闭态 0 请求 / 0 初始化），热身钩子由 Search.astro 的
       module 脚本注入（window.__ovlSheet）。这里只做转发 —— 本段是 is:inline，
       不会让 Nav 的 module script 变成独立首屏文件（那样每页多 0.8KB JS + 1 个请求）。 */
    (function () {
        function open(name, el) {
            // 基座已加载时它自己接管（避免同一次点击开两个面板）
            if (window.__ovlLoaded || !window.__ovlSheet) return;
            window.__ovlSheet(name, el);
        }
        document.addEventListener(
            "click",
            function (event) {
                var hit = event.target && event.target.closest;
                var trigger = hit && event.target.closest("[data-ovl-open]");
                if (!trigger) return;
                event.preventDefault();
                open(trigger.getAttribute("data-ovl-open") || "shortcuts", trigger);
            },
            true,
        );
        document.addEventListener(
            "keydown",
            function (event) {
                if (event.key !== "?" || event.metaKey || event.ctrlKey || event.altKey) return;
                var target = event.target;
                if (
                    target &&
                    target.closest &&
                    target.closest("input,textarea,select,[contenteditable=true]")
                )
                    return;
                event.preventDefault();
                open("shortcuts", document.getElementById("nav-menu-btn"));
            },
            true,
        );
    })();
</script>

<style>
    ul li {
        margin: 0.2rem;
    }

    .nav-menu-btn {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 6px 12px;
        border: none;
        border-radius: 8px;
        background: transparent;
        color: var(--color-text);
        font-size: 0.95em;
        font-weight: 600;
        font-family: var(--font-body);
        cursor: pointer;
        transition: background-color var(--duration-fast);
    }

    @media (hover: hover) {
        .nav-menu-btn:hover {
            background: var(--color-hover);
        }
    }

    .nav-menu-btn-icon {
        display: flex;
        flex-direction: column;
        gap: 4px;
        width: 18px;
    }

    .nav-menu-btn-bar {
        display: block;
        width: 18px;
        height: 2px;
        border-radius: 2px;
        background: var(--color-text);
        transition:
            transform 0.3s,
            opacity 0.3s;
    }

    .nav-menu-btn--open .nav-menu-btn-bar:nth-child(1) {
        transform: translateY(6px) rotate(45deg);
    }

    .nav-menu-btn--open .nav-menu-btn-bar:nth-child(2) {
        opacity: 0;
    }

    .nav-menu-btn--open .nav-menu-btn-bar:nth-child(3) {
        transform: translateY(-6px) rotate(-45deg);
    }

    @media screen and (max-width: 768px) {
        .nav-menu-btn-label {
            display: none;
        }

        .nav-menu-btn {
            padding: 6px 8px;
            min-width: 40px;
            min-height: 40px;
            justify-content: center;
        }
    }

    /* ── Dropdown panel ── */
    .nav-dropdown {
        position: fixed;
        top: 80px;
        left: 50%;
        transform: translateX(-50%) translateY(-8px);
        z-index: 10;
        width: calc(100% - 48px);
        max-width: var(--content-width-medium);
        padding: 0 32px;
        background: var(--color-bg-surface);
        background: color-mix(in srgb, var(--color-bg-surface) 90%, transparent);
        -webkit-backdrop-filter: blur(24px);
        backdrop-filter: blur(24px);
        border: 1px solid var(--color-border);
        border-radius: 28px;
        box-shadow: var(--shadow-lg);
        opacity: 0;
        pointer-events: none;
        transition:
            opacity 0.25s ease,
            transform 0.25s ease;
    }

    .nav-dropdown--open {
        opacity: 1;
        transform: translateX(-50%) translateY(0);
        pointer-events: auto;
    }

    .nav-dropdown-list {
        display: flex;
        justify-content: center;
        gap: 6px;
        list-style: none;
        margin: 0;
        padding: 0;
        flex-wrap: wrap;
    }

    .nav-dropdown-link {
        display: inline-flex;
        align-items: center;
        padding: 0.25em 0.6em;
        margin: 4px 0;
        border-radius: 10px;
        font-size: 1.05em;
        font-weight: 600;
        color: var(--color-text);
        text-decoration: none;
        white-space: nowrap;
        transition:
            color var(--duration-fast),
            background-color var(--duration-fast);
    }

    @media (hover: hover) {
        .nav-dropdown-link:hover {
            color: var(--color-accent);
            background: var(--color-hover);
        }
    }

    .nav-dropdown-link.active {
        color: var(--color-accent);
    }

    @media screen and (max-width: 768px) {
        .nav-dropdown {
            top: 72px;
            width: calc(100% - 144px);
            padding: 0 16px;
            border-radius: 32px;
        }

        .nav-dropdown-link {
            font-size: 0.95em;
            padding: 0.2em 0.4em;
        }
    }

    @media screen and (max-width: 450px) {
        .nav-dropdown {
            top: 64px;
            border-radius: 16px;
            padding: 6px 8px;
        }

        .nav-menu-btn {
            padding: 0;
            min-width: 40px;
            min-height: 40px;
            justify-content: center;
        }

        .nav-dropdown-list {
            gap: 4px;
        }

        .nav-dropdown-link {
            padding: 0 0.2em;
            margin: 0;
        }
    }
</style>
