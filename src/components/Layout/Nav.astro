---
import { navLinks } from "~/config";
import { t, getLocale, hasLocaleRoute, defaultLocale } from "~/utils/i18n";

const loc = getLocale(Astro.currentLocale || "zh");
const isEn = loc === "en";
const isDefault = loc === defaultLocale;

const currentPath = Astro.url.pathname;

// href → i18n key 映射（href 以中文路径为准，en 页面统一加 /en 前缀）
const navKeyMap: Record<string, string> = {
    "/": "nav.home",
    "/blog/1/": "nav.blog",
    "/talks/": "nav.talks",
    "/albums/": "nav.albums",
    "/bangumi/": "nav.bangumi",
    "/friends/": "nav.friends",
    "/archives/": "nav.archives",
    "/tags/": "nav.tags",
    "/services/": "nav.services",
};

/**
 * 按当前语言解析导航链接（M2-11a）。
 * - zh：原样；
 * - en：一律加 `/en` 前缀（既有手写路由，全站都有英文页）；
 * - 其余语言：只给 `[locale]` 模板真的建过的 5 个路由加前缀，其余（相册 /
 *   友人 / 番剧 …）该语言没有页面，**保持在中文路由** —— 宁可语言不一致，
 *   也不把人送进 404。
 */
const navHref = (href: string): string => {
    if (isDefault) return href;
    if (isEn) return href === "/" ? "/en/" : `/en${href}`;
    if (!hasLocaleRoute(href)) return href;
    return href === "/" ? `/${loc}/` : `/${loc}${href}`;
};

// 分页路由匹配：/blog/1/ → base=/blog/，匹配 /blog/2/、/blog/3/ 等
function isActive(href: string) {
    // 单段链接（"/"、"/en/"、"/ja/" …）必须精确匹配：否则 "/ja/" 会把
    // /ja/blog/1/ 也算成首页高亮（M2-11a）
    //
    // M6-1 修正：旧写法 `/^\/[^/]*\/$/.test("/")` 是 **false**（"只有 1 个斜杠"），
    // 于是 "/" 掉进下面的前缀分支 `currentPath.startsWith("/")` —— 全站每一页都把
    // 「首页」算成当前页。以前只表现为颜色多亮一项；M6-1 把导航做成胶囊后当前页是
    // 整颗填色 + aria-current="page"，同一屏会出现两颗"当前页"，读屏也会播报两次。
    const isSingleSegment = href === "/" || /^\/[^/]*\/$/.test(href);
    if (isSingleSegment && !href.startsWith("/blog/")) return currentPath === href;
    const base = href.replace(/\/\d+\/$/, "/");
    return currentPath.startsWith(base);
}
---

<button
    id="nav-menu-btn"
    class="nav-menu-btn"
    aria-label={loc === "en" ? "Open menu" : "打开菜单"}
    aria-expanded="false"
    type="button"
>
    <span class="nav-menu-btn-icon">
        <span class="nav-menu-btn-bar"></span>
        <span class="nav-menu-btn-bar"></span>
        <span class="nav-menu-btn-bar"></span>
    </span>
    <span class="nav-menu-btn-label">{isEn ? "Menu" : "菜单"}</span>
</button>

<nav
    id="nav-dropdown"
    class="nav-dropdown"
    aria-label={loc === "en" ? "Main navigation" : "主导航"}
    inert
>
    <ul class="nav-dropdown-list" role="list">
        {
            navLinks.map((link) => {
                const label = navKeyMap[link.href] ? t(loc, navKeyMap[link.href]) : link.label;
                const href = navHref(link.href);
                const active = isActive(href);
                return (
                    <li>
                        <a
                            href={href}
                            class:list={["nav-dropdown-link", { active }]}
                            aria-current={active ? "page" : undefined}
                        >
                            {label}
                        </a>
                    </li>
                );
            })
        }
        {
            /* M2-5：overlay 入口（键盘速查 / 手势速查）。手势入口只在移动断点出现
               （overlays.css 的 .nav-dropdown-extra--gesture），桌面端隐藏。
               `?` 也能直接开快捷键速查（src/scripts/overlay.ts）。 */
        }
        <li class="nav-dropdown-extra">
            <button
                type="button"
                class="nav-dropdown-link nav-dropdown-link--utility"
                data-ovl-open="shortcuts"
                data-ovl-locale={loc}
            >
                {isEn ? "Shortcuts" : "快捷键"}
            </button>
        </li>
        <li class="nav-dropdown-extra nav-dropdown-extra--gesture">
            <button
                type="button"
                class="nav-dropdown-link nav-dropdown-link--utility"
                data-ovl-open="gestures"
                data-ovl-locale={loc}
            >
                {isEn ? "Gestures" : "手势"}
            </button>
        </li>
    </ul>
</nav>

<script>
    /**
     * 导航高亮：`active` 类原本只在构建期算（isActive(currentPath)），
     * 换成 swup 后导航不参与替换，SPA 跳转时高亮永远停在首屏那一项。
     * 这里按 location.pathname 重算一次，并在每次 astro:page-load 后刷新。
     * 分页路由（/blog/1/）按 base（/blog/）匹配，与构建期口径保持一致。
     */
    function markActiveNav(): void {
        const path = location.pathname;
        document.querySelectorAll<HTMLAnchorElement>(".nav-dropdown-link").forEach((link) => {
            const href = link.getAttribute("href") || "";
            if (!href) return;
            const base = href.replace(/\/\d+\/$/, "/");
            // 与构建期同口径：单段链接（含 "/"）精确匹配，其余按 base 前缀匹配。
            // M6-1："/" 必须显式算作单段，否则 startsWith("/") 会把每一页都点亮。
            const isSingleSegment = href === "/" || /^\/[^/]*\/$/.test(href);
            const active =
                isSingleSegment && !href.startsWith("/blog/") ? path === href : path.startsWith(base);
            link.classList.toggle("active", active);
            if (active) link.setAttribute("aria-current", "page");
            else link.removeAttribute("aria-current");
        });
    }

    markActiveNav();
    document.addEventListener("astro:page-load", markActiveNav);

    let open = false;
    const supportsInert = "inert" in HTMLElement.prototype;

    const getBtn = () => document.getElementById("nav-menu-btn") as HTMLButtonElement | null;
    const getDropdown = () => document.getElementById("nav-dropdown") as HTMLElement | null;

    const setOpen = (v: boolean) => {
        open = v;
        const btn = getBtn();
        const dropdown = getDropdown();
        if (btn) {
            btn.setAttribute("aria-expanded", String(v));
            btn.classList.toggle("nav-menu-btn--open", v);
        }
        if (dropdown) {
            /* 关闭时只用 inert，不再叠 aria-hidden。
             *
             * inert 本身就等于「整棵子树从无障碍树移出 + 禁止聚焦 + 不可点击」，
             * 而 aria-hidden 只管「不让读屏读到」，两者叠在一起时 Chrome 会拦下来警告：
             *   Blocked aria-hidden on an element because its descendant retained focus
             * —— 换页时焦点还停在 .nav-dropdown-link 上（用户就是点它跳走的），
             * 而这里恰恰是在 astro:after-swap 里跑，于是每次从下拉菜单换页都报一条。
             * 只留 inert 后浏览器会自己把焦点移走，不再有「藏起带焦点的元素」这回事。
             * 不支持 inert 的老浏览器才退回 aria-hidden（此时没有 inert，也就不存在上面那条警告）。
             */
            dropdown.toggleAttribute("inert", !v);
            if (!supportsInert) dropdown.setAttribute("aria-hidden", String(!v));
            dropdown.classList.toggle("nav-dropdown--open", v);
        }
    };

    document.addEventListener("click", (e) => {
        const btn = getBtn();
        const dropdown = getDropdown();
        const target = e.target as Node;

        if (btn && btn.contains(target)) {
            e.stopPropagation();
            setOpen(!open);
            return;
        }

        if (open && dropdown && !dropdown.contains(target)) {
            setOpen(false);
        }
    });

    document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && open) {
            setOpen(false);
            getBtn()?.focus();
        }
    });

    /* M2-5：快捷键速查 / 手势速查入口 —— 见文末 is:inline 脚本。
       这里不留 import()：带动态 import 的 script 会被 Astro 提升成独立文件，
       等于给每页多加一个请求与 0.8KB 首屏 JS（实测 list 页 JS 会超预算）。 */

    window.addEventListener(
        "scroll",
        () => {
            if (open) setOpen(false);
        },
        { passive: true },
    );

    // 换页后把菜单真正收起来。之前这里只写了 `open = false`（只改局部变量），
    // 没走 setOpen：class / aria-expanded / inert 全都留在「打开」状态，
    // 菜单视觉上不消失；而 open 已经变 false，下一次点按钮等于「再打开一次」，
    // 于是表现为点两次才收得回去。导航栏在 <main> 外、不参与替换，所以必须显式收。
    document.addEventListener("astro:after-swap", () => {
        setOpen(false);
    });
</script>

<script is:inline>
    /* M2-5：快捷键 / 手势速查入口。
       overlay 基座是按需加载的（关闭态 0 请求 / 0 初始化），热身钩子由 Search.astro 的
       module 脚本注入（window.__ovlSheet）。这里只做转发 —— 本段是 is:inline，
       不会让 Nav 的 module script 变成独立首屏文件（那样每页多 0.8KB JS + 1 个请求）。 */
    (function () {
        function open(name, el) {
            // 基座已加载时它自己接管（避免同一次点击开两个面板）
            if (window.__ovlLoaded || !window.__ovlSheet) return;
            window.__ovlSheet(name, el);
        }
        document.addEventListener(
            "click",
            function (event) {
                var hit = event.target && event.target.closest;
                var trigger = hit && event.target.closest("[data-ovl-open]");
                if (!trigger) return;
                event.preventDefault();
                open(trigger.getAttribute("data-ovl-open") || "shortcuts", trigger);
            },
            true,
        );
        document.addEventListener(
            "keydown",
            function (event) {
                if (event.key !== "?" || event.metaKey || event.ctrlKey || event.altKey) return;
                var target = event.target;
                if (
                    target &&
                    target.closest &&
                    target.closest("input,textarea,select,[contenteditable=true]")
                )
                    return;
                event.preventDefault();
                open("shortcuts", document.getElementById("nav-menu-btn"));
            },
            true,
        );
    })();
</script>

<style>
    ul li {
        margin: 0.2rem;
    }

    /* M6-1：汉堡按钮收成 34px 面片胶囊，和搜索触发器/工具组同一档高度。 */
    .nav-menu-btn {
        display: flex;
        align-items: center;
        gap: var(--space-2, 8px);
        height: 34px;
        padding: 0 var(--space-3, 12px);
        border: 1px solid var(--shell-border);
        border-radius: var(--shell-radius-md);
        background: var(--shell-sunken);
        color: var(--shell-fg-muted);
        font-size: var(--text-sm, 0.875rem);
        font-weight: 500;
        font-family: var(--font-body);
        cursor: pointer;
        transition:
            background-color var(--duration-fast) var(--ease-out),
            color var(--duration-fast) var(--ease-out),
            border-color var(--duration-fast) var(--ease-out);
    }

    @media (hover: hover) {
        .nav-menu-btn:hover {
            background: var(--shell-sunken-strong);
            color: var(--shell-fg);
        }
    }

    .nav-menu-btn[aria-expanded="true"] {
        background: var(--shell-accent);
        border-color: var(--shell-accent);
        color: var(--shell-accent-fg);
    }

    .nav-menu-btn:focus-visible {
        outline: 2px solid var(--shell-ring);
        outline-offset: 2px;
    }

    .nav-menu-btn-icon {
        display: flex;
        flex-direction: column;
        gap: 3px;
        width: 16px;
    }

    .nav-menu-btn-bar {
        display: block;
        width: 16px;
        height: 2px;
        border-radius: 2px;
        background: currentColor;
        transition:
            transform 0.3s,
            opacity 0.3s;
    }

    .nav-menu-btn-label {
        line-height: 1;
        white-space: nowrap;
    }

    .nav-menu-btn--open .nav-menu-btn-bar:nth-child(1) {
        transform: translateY(5px) rotate(45deg);
    }

    .nav-menu-btn--open .nav-menu-btn-bar:nth-child(2) {
        opacity: 0;
    }

    .nav-menu-btn--open .nav-menu-btn-bar:nth-child(3) {
        transform: translateY(-5px) rotate(-45deg);
    }

    @media screen and (max-width: 768px) {
        .nav-menu-btn-label {
            display: none;
        }

        .nav-menu-btn {
            padding: 0;
            width: 34px;
            min-width: 34px;
            height: 34px;
            justify-content: center;
        }
    }

    /* ── Dropdown panel ──
       面板挂在页头正下方（top 走同一个 header 高度 token），里面是一排胶囊：
       常态透明、hover 换面片底、当前页整颗填强调色。 */
    .nav-dropdown {
        position: fixed;
        top: calc(var(--notice-height, 0px) + var(--shell-header-h) + var(--space-2, 8px));
        left: 50%;
        transform: translateX(-50%) translateY(-6px);
        z-index: 10;
        width: calc(100% - 2 * var(--space-6, 24px));
        max-width: var(--layout-content-wide, var(--content-width-max));
        padding: var(--space-3, 12px) var(--space-4, 16px);
        background: var(--shell-surface-translucent);
        -webkit-backdrop-filter: blur(20px) saturate(1.3);
        backdrop-filter: blur(20px) saturate(1.3);
        border: 1px solid var(--shell-border);
        border-radius: var(--shell-radius-xl);
        box-shadow: var(--shadow-4, var(--shadow-lg));
        opacity: 0;
        pointer-events: none;
        transition:
            opacity var(--duration-base, 0.2s) var(--ease-standard, ease),
            transform var(--duration-base, 0.2s) var(--ease-standard, ease);
    }

    .nav-dropdown--open {
        opacity: 1;
        transform: translateX(-50%) translateY(0);
        pointer-events: auto;
    }

    .nav-dropdown-list {
        display: flex;
        justify-content: center;
        gap: var(--space-1, 4px);
        list-style: none;
        margin: 0;
        padding: 0;
        flex-wrap: wrap;
    }

    .nav-dropdown-link {
        display: inline-flex;
        align-items: center;
        gap: var(--space-2, 8px);
        padding: 6px var(--space-3, 12px);
        border-radius: var(--shell-radius-pill);
        font-size: var(--text-sm, 0.875rem);
        font-weight: 500;
        line-height: 1.4;
        color: var(--shell-fg-muted);
        background: transparent;
        border: 0;
        cursor: pointer;
        text-decoration: none;
        white-space: nowrap;
        transition:
            color var(--duration-fast) var(--ease-out),
            background-color var(--duration-fast) var(--ease-out);
    }

    @media (hover: hover) {
        .nav-dropdown-link:hover {
            color: var(--shell-fg);
            background: var(--shell-sunken-strong);
        }
    }

    .nav-dropdown-link:focus-visible {
        outline: 2px solid var(--shell-ring);
        outline-offset: 2px;
    }

    /* 当前页：整颗胶囊填强调色（设计稿 data-active-classes = bg-primary-container） */
    .nav-dropdown-link.active,
    .nav-dropdown-link[aria-current="page"] {
        color: var(--shell-accent-fg);
        background: var(--shell-accent);
    }

    @media (hover: hover) {
        .nav-dropdown-link.active:hover,
        .nav-dropdown-link[aria-current="page"]:hover {
            color: var(--shell-accent-fg);
            background: var(--shell-accent-hover);
        }
    }

    .nav-dropdown-link--utility {
        color: var(--shell-fg-muted);
        background: transparent;
        border: 0;
    }

    @media screen and (max-width: 768px) {
        .nav-dropdown {
            width: calc(100% - 2 * var(--space-5, 20px));
            border-radius: var(--shell-radius-lg);
            padding: var(--space-2, 8px) var(--space-3, 12px);
        }

        .nav-dropdown-list {
            gap: 2px;
        }

        .nav-dropdown-link {
            font-size: var(--text-sm, 0.875rem);
            padding: 6px var(--space-2, 8px);
        }
    }

    @media screen and (max-width: 450px) {
        .nav-dropdown {
            width: calc(100% - 2 * var(--space-4, 16px));
            max-height: calc(100dvh - var(--shell-header-h) - var(--space-6, 24px));
            overflow-y: auto;
        }

        .nav-dropdown-link {
            padding: 6px var(--space-2, 8px);
        }
    }
</style>
