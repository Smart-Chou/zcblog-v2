---
/**
 * 上一篇 / 下一篇（M2-3 / P-02）
 *
 * 结构契约：`.post-nav` 必须存在 —— Toc.astro 的滚动定位用
 * `document.querySelector(".post-nav")` 算文章底部，缺了它目录会直接不初始化。
 * 链接类名 `.post-nav-link.prev/.next` 保留（旧样式/浮动布局的回退点）。
 */
import { getAdjacentPosts } from "~/utils/adjacent-posts";
import { getAllArticles } from "~/utils/article-stats";

interface Props {
    slug: string;
}

const { slug } = Astro.props;

// 语言由当前 URL 推导（英文文章页在 /en/article/ 下）
const isEn = Astro.url.pathname.startsWith("/en/");
const articlePrefix = isEn ? "/en/article" : "/article";
const toArticleUrl = (id: string) => `${articlePrefix}/${isEn ? id.replace(/-en$/, "") : id}/`;

// 用 getAdjacentPosts 获取同语言相邻文章 slug（模块级缓存，O(1) 索引查找）
const { prev: prevSlug, next: nextSlug } = await getAdjacentPosts(slug, isEn ? "en" : "zh");

// getAllArticles 由 Astro 内容层缓存，无额外开销
const allPosts = await getAllArticles();
const prevPost = prevSlug ? (allPosts.find((p) => p.id === prevSlug) ?? null) : null;
const nextPost = nextSlug ? (allPosts.find((p) => p.id === nextSlug) ?? null) : null;
---

{
    (prevPost || nextPost) && (
        <nav class="post-nav" aria-label={isEn ? "Adjacent posts" : "相邻文章"}>
            {prevPost && (
                <a href={toArticleUrl(prevPost.id)} class="post-nav-link prev" rel="prev">
                    <span class="post-nav-link__eyebrow">{isEn ? "Previous" : "上一篇"}</span>
                    <span class="post-nav-link__title">{prevPost.data.title}</span>
                </a>
            )}
            {nextPost && (
                <a href={toArticleUrl(nextPost.id)} class="post-nav-link next" rel="next">
                    <span class="post-nav-link__eyebrow">{isEn ? "Next" : "下一篇"}</span>
                    <span class="post-nav-link__title">{nextPost.data.title}</span>
                </a>
            )}
        </nav>
    )
}

