---
import PostCardShell from "~/components/UI/PostCardShell.astro";
import PostMeta from "~/components/Article/PostMeta.astro";

interface Props {
    title: string;
    description: string;
    publishedTime: Date;
    modifiedTime: Date | string;
    postUrl: string;
    wordCount: number;
    readTime: string;
    currentSlug: string;
    tags?: string[];
}

const {
    title,
    description,
    publishedTime,
    modifiedTime,
    postUrl,
    wordCount,
    readTime,
    currentSlug,
} = Astro.props;
---

<PostCardShell>
    <h2 class="post-card-title" aria-label={title}>{title}</h2>
    <p class="post-card-description">{description}</p>
    <PostMeta
        publishedTime={publishedTime}
        modifiedTime={modifiedTime}
        wordCount={wordCount}
        readTime={readTime}
        currentSlug={currentSlug}
    />
    <a href={postUrl} class="post-card-link" aria-label={`Read more: ${title}`}>Read More</a>
</PostCardShell>
