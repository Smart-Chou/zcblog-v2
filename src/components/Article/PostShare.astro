---
/**
 * 文章分享（构建期静态化 + 少量客户端增强）
 * - 站外分享链接在构建期拼接渲染为 <a>，无 JS 也可用
 * - 微信二维码在点击后才本地生成（share.ts 按需 import("uqr")，关闭态 0 字节 / 0 请求）
 * - 交互增强见 ~/scripts/share.ts（弹层 / 复制 / 系统分享 / 微信内提示 / Umami）
 *
 * M7-3a：分享入口条 + 微信二维码弹层的视觉换壳（selection §4.17 的壳子，不做海报生成）。
 * 结构与 class 钩子由 share.ts / overlay.ts 固定在契约里（D-0xxx）：
 *   [data-post-share] · .share-label · .share-icons · .share-icon[--native|--copy]
 *   .share-wechat-wrap[.open|.share-hidden|data-in-wechat] · .share-pop · .share-card
 *   .share-close[data-share-close] · .share-qr / .share-qr-img[data-share-qr]
 *   .share-qr-title · .share-qr-help · .share-in-wechat · .share-copied-chip
 *
 * M7-3c：弹层接 M7-3b-2 的构建期海报 `/poster/<slug>.png`（3:4 / 1200×1600）。
 *   · 桌面两栏（左海报预览 + 右 QR/平台/操作），移动单列 sheet；
 *   · 预览图**不带 src**，`data-share-poster="<slug>"` 由 share.ts 在打开弹层时才写
 *     src —— 关闭态 0 请求（e2e/share-poster.spec.ts 断言）；
 *   · 下载链接是静态 href + download（属性不触发请求）；
 *   · 「复制短链」没有短链后端：复制 canonical URL 并在 [data-share-note] 里
 *     明说降级（文案走 data-* 传给 share.ts，不动 i18n 词典）。
 */
import { share } from "~/config";
import { iconMarkup } from "~/components/Icons/icon-markup";
import { t, getLocale, contentLocaleOf } from "~/utils/i18n";
// M2-5：分享 sheet 的表皮（[data-overlay="share"] 规则在 overlays.css）
import "~/styles/pages/overlays.css";
// M7-3a：入口条 + 二维码弹层的换壳样式（只增不改 overlays.css / article.css）
import "~/styles/pages/share.css";

interface Props {
    title: string;
    description?: string;
    image?: string;
    slug?: string;
    locale?: string;
}

const { title, description = "", image = "", slug = "", locale: rawLocale = "zh" } = Astro.props;
const locale = getLocale(rawLocale);

interface Platform {
    zh: string;
    en: string;
    icon: string;
    href?: string;
    action?: "wechat" | "copy" | "native";
}

const enc = encodeURIComponent;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
const canonical = new URL(canonicalUrl);
/** 脚注用的站内路径（长路径在 CSS 里截断，不撑破卡片） */
const sharePath = `${canonical.host}${canonical.pathname}`;

const PLATFORMS: Record<string, Platform> = {
    wechat: { zh: "微信", en: "WeChat", icon: "tabler:brand-wechat", action: "wechat" },
    weibo: {
        zh: "微博",
        en: "Weibo",
        icon: "tabler:brand-weibo",
        href: `https://service.weibo.com/share/share.php?url=${enc(canonicalUrl)}&title=${enc(title)}${image ? `&pic=${enc(image)}` : ""}`,
    },
    qzone: {
        zh: "QQ空间",
        en: "Qzone",
        icon: "tabler:brand-qq",
        href: `https://sns.qzone.qq.com/cgi-bin/qzshare/cgi_qzshare_onekey?url=${enc(canonicalUrl)}&title=${enc(title)}&desc=${enc(description)}&summary=${enc(description)}`,
    },
    douban: {
        zh: "豆瓣",
        en: "Douban",
        icon: "tabler:brand-douban",
        href: `https://www.douban.com/share/service?href=${enc(canonicalUrl)}&name=${enc(title)}&comment=${enc(description)}${image ? `&image=${enc(image)}` : ""}`,
    },
    x: {
        zh: "X",
        en: "X",
        icon: "tabler:brand-x",
        href: `https://x.com/intent/post?url=${enc(canonicalUrl)}&text=${enc(title)}`,
    },
    telegram: {
        zh: "Telegram",
        en: "Telegram",
        icon: "tabler:brand-telegram",
        href: `https://t.me/share/url?url=${enc(canonicalUrl)}&text=${enc(title)}`,
    },
    facebook: {
        zh: "Facebook",
        en: "Facebook",
        icon: "tabler:brand-facebook",
        href: `https://www.facebook.com/sharer/sharer.php?u=${enc(canonicalUrl)}`,
    },
    reddit: {
        zh: "Reddit",
        en: "Reddit",
        icon: "tabler:brand-reddit",
        href: `https://www.reddit.com/submit?url=${enc(canonicalUrl)}&title=${enc(title)}`,
    },
    copy: { zh: "复制链接", en: "Copy link", icon: "tabler:copy", action: "copy" },
    native: { zh: "系统分享", en: "Share…", icon: "tabler:share-2", action: "native" },
};

const items = (share.enable ? share.sites : []).flatMap((id) => {
    const platform = PLATFORMS[id];
    return platform ? [{ id, ...platform }] : [];
});

const shareToLabel = t(locale, "article.shareTo");
const qrTitle = t(locale, "article.qrcode");
const closeLabel = locale === "en" ? "Close" : "关闭";
/** 平台计数：纯装饰的等宽小字（"10" 紧贴赤陶圆点），语言无关 */
const channelCount = String(items.length).padStart(2, "0");

/* ── M7-3c：海报预览 / 下载 / 短链降级（文案在组件内，不扩 i18n 词典） ── */
const isEn = locale === "en";
/** 构建期静态资产（M7-3b-2）；`<img>` 不带 src，打开弹层时由 share.ts 写入 */
const posterPath = slug ? `/poster/${slug}.png` : "";
const posterAlt = isEn ? `${title} — share poster` : `${title} 分享海报`;
const downloadLabel = isEn ? "Download poster" : "下载海报";
const shortlinkLabel = isEn ? "Copy short link" : "复制短链";
const shortlinkDegraded = isEn
    ? "Short links aren’t available yet — copied the full article link."
    : "暂无短链服务，已复制完整文章链接。";
const shortlinkError = isEn
    ? "Copy blocked by the browser — select the link at the foot of this card."
    : "浏览器拒绝了复制，请手动选取卡片底部的链接。";
/** 移动端把同一个入口改叫「分享海报」（弹层里已是海报单，不再是纯二维码） */
const posterEntryLabel = isEn ? "Share card" : "分享海报";
/** 弹层右栏的平台直链（与入口条同一批 href，构建期写好，无 JS 也能转发） */
const platformLinks = items.filter((item) => Boolean(item.href));
---

{
    items.length > 0 && (
        <div
            class="share-bar post-share"
            data-post-share
            data-share-url={canonicalUrl}
            data-share-title={title}
            data-share-slug={slug}
            data-share-poster-label={posterEntryLabel}
            data-share-shortlink-degraded={shortlinkDegraded}
            data-share-shortlink-error={shortlinkError}
        >
            <div class="share-head">
                <span class="share-label">{shareToLabel}</span>
                <span class="share-count" aria-hidden="true">
                    <span class="share-count-dot" />
                    {channelCount}
                </span>
            </div>
            <div class="share-icons">
                {items.map((item) => {
                    const label = item[contentLocaleOf(locale)] ?? item.zh;
                    const aria = `${shareToLabel} ${label}`;
                    const icon = iconMarkup(item.icon);
                    if (item.action === "wechat") {
                        return (
                            <span class="share-wechat-wrap">
                                <button
                                    type="button"
                                    class="share-icon"
                                    data-share-action="wechat"
                                    aria-label={aria}
                                    aria-expanded="false"
                                    title={label}
                                >
                                    <Fragment set:html={icon} />
                                </button>
                                <div class="share-pop" aria-hidden="true" aria-label={shareToLabel}>
                                    <div class="share-card">
                                        <div class="share-card-head">
                                            <span class="share-eyebrow" aria-hidden="true">
                                                Share&nbsp;card
                                            </span>
                                            <button
                                                type="button"
                                                class="share-close"
                                                data-share-close
                                                data-ovl-close
                                                aria-label={closeLabel}
                                            >
                                                <Fragment set:html={iconMarkup("tabler:x")} />
                                            </button>
                                        </div>
                                        <div class="share-modal">
                                            {posterPath && (
                                                <figure class="share-poster">
                                                    <div class="share-poster-frame">
                                                        <img
                                                            class="share-poster-img"
                                                            data-share-poster={slug}
                                                            alt={posterAlt}
                                                            width="1200"
                                                            height="1600"
                                                            decoding="async"
                                                        />
                                                    </div>
                                                    <figcaption class="share-poster-cap">
                                                        <span class="share-poster-tag">3:4</span>
                                                        <span class="share-poster-size">
                                                            1200 × 1600
                                                        </span>
                                                    </figcaption>
                                                </figure>
                                            )}
                                            <div class="share-panel">
                                                <div class="share-qr">
                                                    <p class="share-qr-title">{qrTitle}</p>
                                                    <div class="share-qr-img" data-share-qr />
                                                    <p class="share-qr-help">
                                                        {t(locale, "article.share.wechatHelper")}
                                                    </p>
                                                </div>
                                                <p class="share-in-wechat">
                                                    {t(locale, "article.share.inWechatHint")}
                                                </p>
                                                {platformLinks.length > 0 && (
                                                    <ul
                                                        class="share-platforms"
                                                        aria-label={shareToLabel}
                                                    >
                                                        {platformLinks.map((item) => (
                                                            <li>
                                                                <a
                                                                    class="share-platform"
                                                                    href={item.href}
                                                                    target="_blank"
                                                                    rel="noopener"
                                                                    data-share-platform={item.id}
                                                                >
                                                                    <Fragment
                                                                        set:html={iconMarkup(
                                                                            item.icon,
                                                                        )}
                                                                    />
                                                                    <span>
                                                                        {item[
                                                                            contentLocaleOf(locale)
                                                                        ] ?? item.zh}
                                                                    </span>
                                                                </a>
                                                            </li>
                                                        ))}
                                                    </ul>
                                                )}
                                                <div class="share-modal-actions">
                                                    <button
                                                        type="button"
                                                        class="share-action share-action--shortlink"
                                                        data-share-action="shortlink"
                                                    >
                                                        <Fragment
                                                            set:html={iconMarkup("tabler:copy")}
                                                        />
                                                        {shortlinkLabel}
                                                    </button>
                                                    {posterPath && (
                                                        <a
                                                            class="share-action share-action--download"
                                                            href={posterPath}
                                                            download={`${slug}-poster.png`}
                                                            data-share-download
                                                        >
                                                            <Fragment
                                                                set:html={iconMarkup(
                                                                    "tabler:photo",
                                                                )}
                                                            />
                                                            {downloadLabel}
                                                        </a>
                                                    )}
                                                </div>
                                                <p
                                                    class="share-note"
                                                    data-share-note
                                                    role="status"
                                                />
                                                <p class="share-url" aria-hidden="true">
                                                    {sharePath}
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </span>
                        );
                    }
                    if (item.action) {
                        return (
                            <button
                                type="button"
                                class:list={["share-icon", `share-icon--${item.action}`]}
                                data-share-action={item.action}
                                aria-label={aria}
                                title={label}
                            >
                                <Fragment set:html={icon} />
                                {item.action === "copy" && (
                                    <span class="share-copied-chip">
                                        {t(locale, "common.copied")}
                                    </span>
                                )}
                            </button>
                        );
                    }
                    return (
                        <a
                            class="share-icon"
                            href={item.href}
                            target="_blank"
                            rel="noopener"
                            data-share-platform={item.id}
                            aria-label={aria}
                            title={label}
                        >
                            <Fragment set:html={icon} />
                        </a>
                    );
                })}
            </div>
        </div>
    )
}

<!-- 样式链：article.css（存量骨架）→ overlays.css（弹层基座）→ share.css（M7-3a 换壳） -->

<script>
    import "~/scripts/share";
</script>
