---
/**
 * 文章面包屑（M2-3 / P-02）
 *
 * 移到标题上方（Stitch `toc` / `mobile_article_detail` 的位次），类名换到
 * `post-crumbs*` 作用域，与旧 `article.css` 的 `.breadcrumb*` 规则互不干扰。
 * 末项是当前页（aria-current="page"），窄屏用省略号截断而不是换行三行。
 */
import { normalizeTag } from "~/utils/article-stats";

interface Props {
    title: string;
    firstTag?: string;
    isEn?: boolean;
}

const { title, firstTag, isEn = false } = Astro.props;

const homeLabel = isEn ? "Blog" : "博客";
const homeUrl = isEn ? "/en/blog/1/" : "/blog/1/";
const normalizedTag = firstTag ? normalizeTag(firstTag) : "";
const tagUrl = normalizedTag ? `${isEn ? "/en" : ""}/tags/${normalizedTag}/` : "";
---

<nav class="post-crumbs" aria-label={isEn ? "Breadcrumb" : "面包屑"}>
    <ol class="post-crumbs__list">
        <li class="post-crumbs__item">
            <a href={homeUrl} class="post-crumbs__link">{homeLabel}</a>
        </li>
        {
            normalizedTag && (
                <li class="post-crumbs__item">
                    <a href={tagUrl} class="post-crumbs__link">
                        {normalizedTag}
                    </a>
                </li>
            )
        }
        <li class="post-crumbs__item">
            <span class="post-crumbs__current" aria-current="page">
                {title}
            </span>
        </li>
    </ol>
</nav>
