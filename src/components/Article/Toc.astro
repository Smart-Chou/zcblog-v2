---
/**
 * 目录（M6-3 重做）
 *
 * 形态（selection.md §4.2）：桌面 = 8/4 右栏里的 sticky 目录卡；移动 = 右侧滑出抽屉
 * （`screens/marx_s_blog_slide_over_toc_sheet`）。
 *
 * 三条不能丢的契约：
 *  1. **构建期渲染**（D-0082）：整份目录写进 HTML，tocbot 只做高亮/折叠增强。
 *  2. **无 JS 可读**：抽屉的开合是 HTML `popover` 的声明式行为 —— Esc 关闭、焦点回填到
 *     触发按钮、点遮罩 light-dismiss 都由浏览器负责，0 行 JS；脚本被禁用时目录照样能点。
 *  3. 类名指纹 `.toc` / `.toc-content` / `.toc-list(-item)` / `.toc-link` /
 *     `.post-toc__title` 不变：tocbot 配置、`.post-toc` 的 axe 作用域、e2e
 *     （`pages-article.spec.ts` 的 D-0082 断言）都按它们取元素。
 *
 * 触发按钮在 `MarkdownLayout.astro` 的 `.post-toolbar` 里（移动才出现），通过
 * `popovertarget="post-toc-drawer"` 指向本文件的 drawer id —— 两处字面量必须一致。
 */
import DynamicIcon from "~/components/Icons/DynamicIcon.astro";
import { tocNodes, type TocHeading } from "~/utils/toc";

interface Props {
    headings?: TocHeading[];
}

const { headings = [] } = Astro.props;

const nodes = tocNodes(headings);

// M2-3：目录框的标题与计数在构建期就有（不再依赖 tocbot 生成）
const isEn = Astro.url.pathname.startsWith("/en/");
const tocLabel = isEn ? "Contents" : "目录";
const closeLabel = isEn ? "Close contents" : "关闭目录";
/** 与 MarkdownLayout 里触发按钮的 popovertarget 是同一个 id */
const drawerId = "post-toc-drawer";
---

<div id={drawerId} class="post-toc-drawer" popover>
    <div class="post-toc-drawer__bar">
        <span class="post-toc-drawer__label">
            {tocLabel}
            {
                nodes.length > 0 && (
                    <span class="post-toc-drawer__count" aria-hidden="true">
                        {nodes.length}
                    </span>
                )
            }
        </span>
        <button
            class="post-toc-drawer__close"
            type="button"
            popovertarget={drawerId}
            popovertargetaction="hide"
            aria-label={closeLabel}
        >
            <DynamicIcon name="tabler:x" />
        </button>
    </div>
    <nav class="toc post-toc" aria-label={tocLabel}>
        <div class="post-toc__head">
            <span class="post-toc__title">{tocLabel}</span>
            {
                nodes.length > 0 && (
                    <span class="post-toc__count" aria-hidden="true">
                        {nodes.length}
                    </span>
                )
            }
        </div>
        <div class="toc-content">
            {
                nodes.length > 0 && (
                    <ol class="toc-list">
                        {nodes.map((node) => (
                            <li
                                class={`toc-list-item${node.children.length > 0 ? " is-collapsible" : ""}`}
                            >
                                <a href={`#${node.slug}`} class="toc-link">
                                    {node.text}
                                </a>
                                {node.children.length > 0 && (
                                    <ol class="toc-list">
                                        {node.children.map((child) => (
                                            <li class="toc-list-item">
                                                <a href={`#${child.slug}`} class="toc-link">
                                                    {child.text}
                                                </a>
                                            </li>
                                        ))}
                                    </ol>
                                )}
                            </li>
                        ))}
                    </ol>
                )
            }
        </div>
    </nav>
</div>

<script>
    import { onPageReady } from "~/utils/page-lifecycle";
    import tocbot from "tocbot";

    let tocAbortController: AbortController | null = null;

    onPageReady(() => {
        requestAnimationFrame(() => {
            // ---- Init tocbot（只做高亮/折叠，目录结构已在构建期） ----
            tocbot.init({
                tocSelector: ".toc-content",
                contentSelector: "#post-content",
                headingSelector: "h2, h3",
                headingsOffset: 100,
                scrollSmoothOffset: -100,
                scrollSmooth: false,
                enableUrlHashUpdateOnScroll: false,
                collapseDepth: 2,
                includeTitleTags: false,
                ignoreSelector: ".toc-ignore",
            });

            // tocbot 点击 TOC 链接时用 pushState 更新 hash，会产生历史记录
            // 拦截后改用 replaceState，确保点击多个目录项也只保留一条历史
            const _push = history.pushState.bind(history);
            history.pushState = function (state, title, url) {
                if (typeof url === "string" && url.startsWith("#")) {
                    return history.replaceState(state, title, url);
                }
                return _push(state, title, url);
            };

            // 页面切换时恢复原始 pushState，避免与其他库冲突
            document.addEventListener("astro:after-swap", function restore() {
                history.pushState = _push;
                document.removeEventListener("astro:after-swap", restore);
            });

            // ---- 激活路径管理：只高亮当前激活标题及其祖先 ----
            // M6-3 起目录改用 CSS sticky（不再由脚本算 fixed/absolute 贴底）：
            // 布局归样式表，脚本只管状态，SPA 换页也不再需要清 inline style。
            const tocRoot = document.querySelector(".toc.post-toc") as HTMLElement | null;
            const tocContent = tocRoot?.querySelector(".toc-content") as HTMLElement | null;
            if (!tocRoot || !tocContent) return;

            function updateActivePath() {
                const activeLink = tocRoot?.querySelector(".is-active-link") as HTMLElement | null;

                // 清除所有旧路径
                tocRoot?.querySelectorAll(".is-active-path").forEach((el) => {
                    el.classList.remove("is-active-path");
                });

                if (!activeLink) return;

                // 从激活链接向上遍历，标记所有祖先 .toc-list-item
                let el: HTMLElement | null = activeLink;
                while (el && el !== tocRoot) {
                    if (el.classList.contains("toc-list-item")) {
                        el.classList.add("is-active-path");
                    }
                    el = el.parentElement;
                }
            }

            // 首次加载：强制 tocbot 检测当前滚动位置的激活标题
            tocbot.refresh();
            // 等 tocbot 刷新完 DOM 后再更新路径
            requestAnimationFrame(() => {
                updateActivePath();
            });

            if (tocAbortController) {
                tocAbortController.abort();
            }
            tocAbortController = new AbortController();

            // ---- Hover 时阻止页面滚动，只滚目录 ----
            tocContent.addEventListener(
                "wheel",
                (e) => {
                    if (!tocRoot.matches(":hover")) return;
                    const { scrollTop, scrollHeight, clientHeight } = tocContent;
                    const atTop = scrollTop === 0;
                    const atBottom = scrollTop + clientHeight >= scrollHeight - 1;

                    if ((e.deltaY < 0 && atTop) || (e.deltaY > 0 && atBottom)) {
                        // 已经到边界，让页面接管滚动
                        return;
                    }
                    e.preventDefault();
                    tocContent.scrollTop += e.deltaY;
                },
                { passive: false, signal: tocAbortController.signal },
            );

            let ticking = false;
            window.addEventListener(
                "scroll",
                () => {
                    if (ticking) return;
                    ticking = true;
                    requestAnimationFrame(() => {
                        updateActivePath();
                        ticking = false;
                    });
                },
                { passive: true, signal: tocAbortController.signal },
            );
        });
    });
</script>
