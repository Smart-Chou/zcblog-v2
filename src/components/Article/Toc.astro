---
/**
 * 目录（M6-3 重做）
 *
 * 形态（selection.md §4.2）：桌面 = 8/4 右栏里的 sticky 目录卡；移动 = 右侧滑出抽屉
 * （`screens/marx_s_blog_slide_over_toc_sheet`）。
 *
 * 三条不能丢的契约：
 *  1. **构建期渲染**（D-0082）：整份目录写进 HTML，tocbot 只做高亮/折叠增强。
 *  2. **无 JS 可读**：抽屉的开合是 HTML `popover` 的声明式行为 —— Esc 关闭、焦点回填到
 *     触发按钮、点遮罩 light-dismiss 都由浏览器负责，0 行 JS；脚本被禁用时目录照样能点。
 *  3. 类名指纹 `.toc` / `.toc-content` / `.toc-list(-item)` / `.toc-link` /
 *     `.post-toc__title` 不变：tocbot 配置、`.post-toc` 的 axe 作用域、e2e
 *     （`pages-article.spec.ts` 的 D-0082 断言）都按它们取元素。
 *
 * 触发按钮在 `MarkdownLayout.astro` 的 `.post-toolbar` 里（移动才出现），通过
 * `popovertarget="post-toc-drawer"` 指向本文件的 drawer id —— 两处字面量必须一致。
 */
import DynamicIcon from "~/components/Icons/DynamicIcon.astro";
import { tocNodes, type TocHeading } from "~/utils/toc";

interface Props {
    headings?: TocHeading[];
}

const { headings = [] } = Astro.props;

const nodes = tocNodes(headings);

// M2-3：目录框的标题与计数在构建期就有（不再依赖 tocbot 生成）
const isEn = Astro.url.pathname.startsWith("/en/");
const tocLabel = isEn ? "Contents" : "目录";
const closeLabel = isEn ? "Close contents" : "关闭目录";
/** 与 MarkdownLayout 里触发按钮的 popovertarget 是同一个 id */
const drawerId = "post-toc-drawer";
---

<div id={drawerId} class="post-toc-drawer" popover>
    <div class="post-toc-drawer__bar">
        <span class="post-toc-drawer__label">
            {tocLabel}
            {
                nodes.length > 0 && (
                    <span class="post-toc-drawer__count" aria-hidden="true">
                        {nodes.length}
                    </span>
                )
            }
        </span>
        <button
            class="post-toc-drawer__close"
            type="button"
            popovertarget={drawerId}
            popovertargetaction="hide"
            aria-label={closeLabel}
        >
            <DynamicIcon name="tabler:x" />
        </button>
    </div>
    <nav class="toc post-toc" aria-label={tocLabel}>
        <div class="post-toc__head">
            <span class="post-toc__title">{tocLabel}</span>
            {
                nodes.length > 0 && (
                    <span class="post-toc__count" aria-hidden="true">
                        {nodes.length}
                    </span>
                )
            }
        </div>
        <div class="toc-content">
            {
                nodes.length > 0 && (
                    <ol class="toc-list">
                        {nodes.map((node) => (
                            <li
                                class={`toc-list-item${node.children.length > 0 ? " is-collapsible" : ""}`}
                            >
                                <a href={`#${node.slug}`} class="toc-link">
                                    {node.text}
                                </a>
                                {node.children.length > 0 && (
                                    <ol class="toc-list">
                                        {node.children.map((child) => (
                                            <li class="toc-list-item">
                                                <a href={`#${child.slug}`} class="toc-link">
                                                    {child.text}
                                                </a>
                                            </li>
                                        ))}
                                    </ol>
                                )}
                            </li>
                        ))}
                    </ol>
                )
            }
        </div>
    </nav>
</div>

<script>
    /**
     * N-7 · JS 余量回收（M5-14）
     *
     * 原来 `import tocbot from "tocbot"` 是**静态** import：tocbot 未压缩 44KB，
     * 打包后 12.9KB raw / 4.6KB gz，永远计入文章页静态 JS 图 —— 而它只做一件事：
     * 滚动时给当前标题所在的目录项加 `is-active-link`。目录结构本身是**构建期**
     * 由 Astro 渲染的（`<ol class="toc-list">` 已带 `is-collapsible`），tocbot 的
     * 默认行为反而是 `tocElement.innerHTML = ""` 把这份 DOM 清掉再自己重建一遍
     * （`skipRendering` 默认 false，见 tocbot.js:792）。
     *
     * 现在按项目既有模式（`annotation-layer` / `share` 同款）改成：
     * bootstrap 静态引入（onPageReady 只 493B，且已被 BaseLayout 等共享），
     * 真正的 tocbot 逻辑放进 `~/scripts/toc-highlight`，**目录进入视口或被交互时**
     * 才 `import()`。关闭态（目录不在视口 / 无目录）零请求、零字节。
     */
    import { onPageReady } from "~/utils/page-lifecycle";

    type TocBoot = { load: () => Promise<unknown>; armed: boolean };
    const w = window as unknown as { __tocBoot?: TocBoot };

    onPageReady(() => {
        const tocRoot = document.querySelector<HTMLElement>(".toc.post-toc");
        if (!tocRoot) return;

        const boot: TocBoot = (w.__tocBoot ??= {
            load: () => import("~/scripts/toc-highlight").then((m) => m.initTocHighlight()),
            armed: false,
        });

        if (boot.armed) return;
        boot.armed = true;

        // 兜底一：没有 IntersectionObserver（老 UA / 部分爬虫）→ 立即加载。
        if (typeof IntersectionObserver !== "function") {
            void boot.load();
            return;
        }

        /**
         * 兜底二（必须，实测出来的）：窄屏下目录走 `popover` 抽屉，`.toc.post-toc`
         * 及其父 `post-toc-drawer` 的 `getBoundingClientRect()` **全为 0**
         * （实测 756×413 视口：w=0 h=0 top=0，滚到底也不变）。IntersectionObserver
         * 对零尺寸目标永远不判 intersecting —— 纯 IO 方案在这个视口下把高亮彻底丢掉。
         *
         * 所以分三档：
         *   ① 目录没有布局尺寸（抽屉模式）= 不可见 → 等用户点开抽屉
         *      （`toggle` 事件 + `resize` 重试），**不预加载**；
         *   ② 有尺寸且在视口内 → 立即加载；
         *   ③ 有尺寸但在视口外 → IntersectionObserver 武装。
         */
        const hasLayout = () => tocRoot.getBoundingClientRect().height > 0;

        if (!hasLayout()) {
            // 抽屉模式：高亮只有在抽屉打开后才有意义。监听 popover 的 toggle。
            const drawer = tocRoot.closest<HTMLElement>(".post-toc-drawer");
            if (!drawer) return;

            const onToggle = () => {
                if (!hasLayout()) return;
                drawer.removeEventListener("toggle", onToggle);
                ARM_AND_LOAD();
            };
            drawer.addEventListener("toggle", onToggle);
            // 视口变化（旋转/拖宽）后抽屉可能变成 rail，再试一次
            document.addEventListener("astro:page-load", onToggle, { once: true });
            return;
        }

        ARM_AND_LOAD();

        function ARM_AND_LOAD() {
            const r = tocRoot.getBoundingClientRect();
            const vh = window.innerHeight || document.documentElement.clientHeight;
            // 已经在视口内（含 200px 预取带）→ 直接加载，不必等 IO
            if (r.top < vh + 200 && r.bottom > -200) {
                void boot.load();
                return;
            }
            const io = new IntersectionObserver(
                (entries) => {
                    if (!entries.some((e) => e.isIntersecting)) return;
                    io.disconnect();
                    void boot.load();
                },
                { rootMargin: "200px" },
            );
            io.observe(tocRoot);
        }
    });
</script>
