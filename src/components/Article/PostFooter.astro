---
/**
 * 文章页脚：标签 + 版权（M2-3 / P-02）
 *
 * 标签改用 M1 的 Tag atom（与首页/归档同一套 chip 语言）；`.post-tags-link`
 * 类保留在链接上 —— e2e/article.spec 的「文章页标签存在」按它计数。
 */
import { normalizeTag } from "~/utils/article-stats";
import Tag from "~/components/UI/atom/Tag.astro";
import PostCopyright from "~/components/Article/PostCopyright.astro";

interface Props {
    tags?: string[];
}

const { tags } = Astro.props;
const isEn = Astro.url.pathname.startsWith("/en/");
const tagPrefix = isEn ? "/en" : "";
---

<div class="post-footer">
    <div class="post-footer__tags post-tags post-card-tags post-card-tags-lists">
        {
            tags?.map((tag: string) => {
                const normalized = normalizeTag(tag);
                return (
                    <Tag
                        href={`${tagPrefix}/tags/${normalized}/`}
                        tone="neutral"
                        size="sm"
                        class="post-tags-link"
                    >
                        {normalized}
                    </Tag>
                );
            })
        }
    </div>
    <div class="post-footer__license post-tags post-card-tags post-card-tags-copyright">
        <PostCopyright />
    </div>
</div>

<!-- 样式已移到 src/styles/pages/article.css（M2-3：文章页自己的页面级样式表） -->
