---
import { config, waline, twikoo, umami } from "~/config";

// 仅把已启用且配置了地址的服务加进放行清单（避免空串/未启用域名污染 CSP）
const extraOrigins = [
    waline.enable && waline.serverUrl ? waline.serverUrl : null,
    // Twikoo（N-2b）：只放 `connect-src`，**不放 `script-src`**。
    // 原因：本项目走 npm 包 + `import("twikoo")`，脚本由 Vite 打包进 `'self'`；
    // 只有官方 CDN 那种 `<script src="https://cdn.jsdelivr.net/...">` 才需要放宽
    // `script-src`，而那等于允许运行任意第三方 JS、还要 SRI —— 见 H-12，未采用。
    //
    // `envId` 为空时 `.filter(Boolean)` 会把它滤掉，所以未部署云函数不会产生空串。
    twikoo.enable && twikoo.envId ? twikoo.envId : null,
    umami.enable && umami.umamiBaseUrl ? umami.umamiBaseUrl : null,
].filter(Boolean);

// 统计脚本（umami / gtag）走普通 async 加载，来源必须写进 script-src ——
// 之前只放进了 connect-src，结果 umami 与 gtag 在每个页面都被 CSP 拦下（生产站同样）。
// worker-src 只留 'self'：PWA 的 sw.js 需要它；partytown 已移除，不再需要 blob:。
const gaEnabled = Boolean(config.ga);

const scriptSrc = [
    "'self'",
    "'unsafe-inline'",
    "data:",
    "https://cdn.jsdelivr.net",
    "https://cdn.bootcdn.net",
    umami.enable && umami.umamiBaseUrl ? umami.umamiBaseUrl : null,
    gaEnabled ? "https://www.googletagmanager.com" : null,
]
    .filter(Boolean)
    .join(" ");

// `/radio/` 唯一在用的直播流 origin：Radio Paradise。
// 其官方 stream-links 页面向第三方播放器公开发放 URL（D-0170 PO 批准 A2）。
// 新增 origin 必须走 PO 单独批准，禁止 `*` 与宽泛 `https:`。
// 注：本串只经 `<meta http-equiv>` 下发，改 `_headers` 无效（见 m80-csp-media-src-20261112.md §1）。
const mediaSrc = ["'self'", "https://stream.radioparadise.com"].join(" ");

/**
 * `frame-src` 刻意保持最严的 `'self'` —— **不要为 Giscus（或任何评论/嵌入服务）放开**。
 *
 * D-0197（2026-11-20，PO 批准）已结案：本项目不支持 Giscus。
 *
 *   · Giscus 必须注入 `giscus.app` 的 iframe（官方 Enable giscus 原文），所以放开
 *     `frame-src` 是硬前置，没有别的接法；
 *   · **自托管免不掉这个代价**：查 `SELF-HOSTING.md` 确认，自托管只是把 origin 换成
 *     自己的域名，iframe 机制不变，`frame-src` 照样要放开；
 *   · 需求侧没有缺口：Twikoo 走 npm 包 + `import()`，脚本进 `'self'`，
 *     `script-src` 一字不改，只在 `connect-src` 加云函数域名。
 *
 * 换句话说：放开 `frame-src` 换不来任何 Twikoo 给不了的能力，只是把「本站可以内嵌
 * 一个第三方可执行文档」这个能力永久打开。这是本项目唯一的 iframe 通路，别为可选项付。
 *
 * 若将来确实要重启 Giscus：必须新开一条决策记录并取得 PO 批准，
 * **不能作为「顺手实现」夹带进其它卡**。
 */
const frameSrc = "'self'";

const connectSrc = [
    "'self'",
    ...extraOrigins,
    "https://v1.hitokoto.cn",
    "https://api.github.com",
    "https://cdn.jsdelivr.net",
    gaEnabled ? "https://www.googletagmanager.com https://www.google-analytics.com" : null,
]
    .filter(Boolean)
    .join(" ");
---

<!-- Content Security Policy -->
<meta
    http-equiv="Content-Security-Policy"
    content={`default-src 'self'; script-src ${scriptSrc}; worker-src 'self'; style-src 'self' 'unsafe-inline' https://cdn.bootcdn.net; font-src 'self' https://cdn.bootcdn.net; img-src 'self' data: https:; media-src ${mediaSrc}; connect-src ${connectSrc}; frame-src ${frameSrc}; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests`}
/>
