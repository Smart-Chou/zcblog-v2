---
import { t, defaultLocale, type Locale } from "~/utils/i18n";
import type { CollectionEntry } from "astro:content";

type PostEntry = CollectionEntry<"article">;

interface Props {
    posts: PostEntry[];
}

const { posts } = Astro.props;

const pathname = Astro.url.pathname;
const locale: Locale = pathname.startsWith("/en") ? "en" : defaultLocale;

// 文章链接按语言加前缀；英文页去掉 -en 后缀（中文页不裁剪，避免误伤 -en 结尾的中文 slug）
const articlePrefix = locale === "en" ? "/en/article" : "/article";
const toArticleUrl = (id: string) =>
    `${articlePrefix}/${locale === "en" ? id.replace(/-en$/, "") : id}/`;

function getImageUrl(image: PostEntry["data"]["image"]): string {
    if (!image || !image.url) return "";
    if (typeof image.url === "string") return image.url;
    return image.url.src;
}

const archiveUrl = locale === defaultLocale ? "/archives/" : "/en/archives/";

function formatDateFull(date: Date): string {
    return date.toLocaleDateString(locale === "en" ? "en-US" : "zh-CN", {
        year: "numeric",
        month: "short",
        day: "numeric",
    });
}
---

{
    posts.length > 0 && (
        <section>
            <div class="section-header">
                <h2 class="section-label">{t(locale, "stats.recentPosts")}</h2>
                <a class="section-link" href={archiveUrl}>
                    {t(locale, "common.viewAll")}
                    <span class="section-link-arrow" aria-hidden="true">
                        →
                    </span>
                </a>
            </div>
            <div class="posts-home stagger-children">
                {/* Featured post */}
                <article class="post-featured">
                    {posts[0].data.image && (
                        <img
                            src={getImageUrl(posts[0].data.image)}
                            alt={posts[0].data.image.alt}
                            width={720}
                            height={405}
                            class="post-featured-cover"
                            loading="lazy"
                            decoding="async"
                        />
                    )}
                    <div class="post-featured-body">
                        <span class="post-featured-label">Featured</span>
                        <h2 class="post-featured-title">{posts[0].data.title}</h2>
                        <span class="post-featured-date">
                            {formatDateFull(posts[0].data.pubDate)}
                        </span>
                    </div>
                    <a
                        href={toArticleUrl(posts[0].id)}
                        class="post-card-link"
                        aria-label={`${locale === "en" ? "Read" : "阅读"} ${posts[0].data.title}`}
                    />
                </article>

                {/* Secondary posts */}
                {posts.slice(1).map((post) => (
                    <article class="post-card">
                        <h2 class="post-card-title">{post.data.title}</h2>
                        <span class="post-card-meta">{formatDateFull(post.data.pubDate)}</span>
                        <a
                            href={toArticleUrl(post.id)}
                            class="post-card-link"
                            aria-label={`${locale === "en" ? "Read" : "阅读"} ${post.data.title}`}
                        />
                    </article>
                ))}
            </div>
        </section>
    )
}
