---
/**
 * Posts — 首页「最近文章」
 *
 * M2-2（D-0110）：featured 大卡 + 4 条列表；标题层级 h3（区块 h2 在页面里）。
 * 颜色 / 尺寸全部走 token，样式在 src/styles/pages/home.css。
 * 组件保持 Astro 静态输出，JS 0 字节。
 */
import { t, defaultLocale, type Locale } from "~/utils/i18n";
import { articleUrl } from "~/utils/article-url";
import Tag from "~/components/UI/atom/Tag.astro";
import Icon from "~/components/UI/atom/Icon.astro";
import type { CollectionEntry } from "astro:content";

type PostEntry = CollectionEntry<"article">;

interface Props {
    posts: PostEntry[];
    locale?: Locale;
}

const { posts, locale: localeProp } = Astro.props;

const locale: Locale =
    localeProp ?? (Astro.url.pathname.startsWith("/en") ? "en" : defaultLocale);

function imageUrl(image: PostEntry["data"]["image"]): string {
    if (!image || !image.url) return "";
    return typeof image.url === "string" ? image.url : image.url.src;
}

const archiveUrl = locale === defaultLocale ? "/archives/" : "/en/archives/";

function formatDate(date: Date): string {
    return date.toLocaleDateString(locale === "en" ? "en-US" : "zh-CN", {
        year: "numeric",
        month: "short",
        day: "numeric",
    });
}

const [featured, ...rest] = posts;
const featuredCover = featured ? imageUrl(featured.data.image) : "";
const featuredAlt = featured?.data.image?.alt || featured?.data.title || "";
---

{
    featured && (
        <section class="posts-section" aria-labelledby="home-posts-title">
            <div class="section-header">
                <h2 class="section-label" id="home-posts-title">
                    {t(locale, "stats.recentPosts")}
                </h2>
                <a class="section-link" href={archiveUrl}>
                    {t(locale, "common.viewAll")}
                    <Icon name="tabler:chevron-right" size="xs" />
                </a>
            </div>

            <article class="post-featured">
                {featuredCover && (
                    <div class="post-featured__media">
                        <img
                            src={featuredCover}
                            alt={featuredAlt}
                            width="720"
                            height="450"
                            loading="lazy"
                            decoding="async"
                        />
                    </div>
                )}
                <div class="post-featured__body">
                    <div class="post-featured__meta">
                        <span class="post-featured__badge">Featured</span>
                        <time
                            class="post-featured__time"
                            datetime={featured.data.pubDate.toISOString()}
                        >
                            {formatDate(featured.data.pubDate)}
                        </time>
                    </div>
                    <h3 class="post-featured__title">
                        <a href={articleUrl(featured)}>{featured.data.title}</a>
                    </h3>
                    <p class="post-featured__desc">{featured.data.description}</p>
                    {featured.data.tags.length > 0 && (
                        <ul class="post-tags">
                            {featured.data.tags.slice(0, 3).map((tag) => (
                                <li>
                                    <Tag size="sm">#{tag}</Tag>
                                </li>
                            ))}
                        </ul>
                    )}
                </div>
            </article>

            {rest.length > 0 && (
                <ol class="post-list">
                    {rest.map((post) => (
                        <li class="post-list__item">
                            <article class="post-item">
                                <div class="post-item__head">
                                    <h3 class="post-item__title">
                                        <a href={articleUrl(post)}>{post.data.title}</a>
                                    </h3>
                                    <time
                                        class="post-item__time"
                                        datetime={post.data.pubDate.toISOString()}
                                    >
                                        {formatDate(post.data.pubDate)}
                                    </time>
                                </div>
                                <p class="post-item__desc">{post.data.description}</p>
                                {post.data.tags.length > 0 && (
                                    <ul class="post-tags">
                                        {post.data.tags.slice(0, 2).map((tag) => (
                                            <li>
                                                <Tag size="sm">#{tag}</Tag>
                                            </li>
                                        ))}
                                    </ul>
                                )}
                            </article>
                        </li>
                    ))}
                </ol>
            )}
        </section>
    )
}
