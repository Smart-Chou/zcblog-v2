---
/**
 * Popular — 首页侧栏「近期热门」
 *
 * M2-2（D-0110）：Card atom（padding 由 src/styles/pages/home.css 的侧栏规则统一给）。
 * 数据仍来自 popular.json + config.popular；已删除/草稿的文章会被跳过。
 */
import { getCollection } from "astro:content";
import { popular as popularConfig } from "~/config";
import { t, type Locale } from "~/utils/i18n";
import { articleUrl } from "~/utils/article-url";
import Card from "~/components/UI/atom/Card.astro";
import Icon from "~/components/UI/atom/Icon.astro";
import popularData from "~/data/popular.json";

interface Props {
    locale: Locale;
}

const { locale } = Astro.props;

interface PopularEntry {
    slug: string;
    pv: number;
    lang?: string;
}

const items: PopularEntry[] = Array.isArray((popularData as { items?: PopularEntry[] }).items)
    ? (popularData as { items: PopularEntry[] }).items
    : [];

// 仅保留仍存在的文章（已删除/草稿的条目跳过），按语言归类，并按配置截取展示数量
let entries: { url: string; title: string; pubDate: Date }[] = [];
if (popularConfig.enable && items.length > 0) {
    const all = await getCollection("article", ({ data }) => !data.draft);
    const byId = new Map(all.map((post) => [post.id, post]));
    entries = items
        .filter((item) => (item.lang === "en") === (locale === "en"))
        .map((item) => byId.get(item.slug))
        .filter((post): post is NonNullable<typeof post> => Boolean(post))
        .slice(0, popularConfig.limit)
        .map((post) => ({
            url: articleUrl(post),
            title: post.data.title,
            pubDate: post.data.pubDate,
        }));
}

const viewAllUrl = locale === "en" ? "/en/blog/1/" : "/blog/1/";

function formatDate(date: Date): string {
    return date.toLocaleDateString(locale === "en" ? "en-US" : "zh-CN", {
        year: "numeric",
        month: "short",
        day: "numeric",
    });
}
---

{
    entries.length > 0 && (
        <Card
            as="section"
            variant="raised"
            padding="none"
            class="popular-section"
            labelledby="home-popular-title"
        >
            <div class="section-header">
                <h2 class="section-label" id="home-popular-title">
                    {t(locale, "home.popularTitle")}
                </h2>
                <a class="section-link" href={viewAllUrl}>
                    {t(locale, "common.viewAll")}
                    <Icon name="tabler:chevron-right" size="xs" />
                </a>
            </div>
            <ol class="popular-list">
                {entries.map((post, index) => (
                    <li class="popular-item">
                        <a class="popular-link" href={post.url}>
                            <span class="popular-rank">{String(index + 1).padStart(2, "0")}</span>
                            <span class="popular-title">{post.title}</span>
                            <time class="popular-date" datetime={post.pubDate.toISOString()}>
                                {formatDate(post.pubDate)}
                            </time>
                        </a>
                    </li>
                ))}
            </ol>
        </Card>
    )
}
