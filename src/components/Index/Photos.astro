---
/**
 * Photos — 首页「近期光影」
 *
 * M2-2（D-0110）：4 列方图（<768 两列），取最近 4 张带日期的照片。
 * 图片保留 width/height，避免 CLS；样式在 src/styles/pages/home.css。
 */
import albums from "~/data/albums.json";
import { getPicImageUrl } from "~/utils";
import { t, defaultLocale, type Locale } from "~/utils/i18n";
import Icon from "~/components/UI/atom/Icon.astro";

interface Props {
    title: string;
    locale: Locale;
}

const { title, locale } = Astro.props;

function extractDate(alt: string): Date | null {
    const match = alt.match(/(\d{4}-\d{2}-\d{2})\s*(\d{2}:\d{2}:\d{2})?/);
    if (!match) return null;
    const dateStr = match[2] ? `${match[1]}T${match[2]}` : `${match[1]}T00:00:00`;
    return new Date(dateStr);
}

const MAX_PHOTOS = 4;
const allPhotos = albums.flatMap((album) =>
    album.photos.map((p) => ({
        url: getPicImageUrl(p.url, 480),
        title: p.alt || p.description || "",
    })),
);
const withDates = allPhotos
    .map((p) => ({ ...p, _date: extractDate(p.title) }))
    .filter((p) => p._date !== null);
const photos = withDates
    .sort((a, b) => b._date!.getTime() - a._date!.getTime())
    .slice(0, MAX_PHOTOS);

const albumsUrl = locale === defaultLocale ? "/albums/" : "/en/albums/";
---

{
    photos.length > 0 && (
        <section class="photos-section" aria-labelledby="home-photos-title">
            <div class="section-header">
                <h2 class="section-label" id="home-photos-title">
                    {title}
                </h2>
                <a class="section-link" href={albumsUrl}>
                    {t(locale, "common.viewAll")}
                    <Icon name="tabler:chevron-right" size="xs" />
                </a>
            </div>
            <ul class="photos-grid">
                {photos.map((photo) => (
                    <li class="photo-item">
                        <figure class="photo-figure">
                            <img
                                class="photo-image"
                                src={photo.url}
                                alt={photo.title}
                                width="400"
                                height="400"
                                loading="lazy"
                                decoding="async"
                            />
                            <figcaption class="photo-caption">{photo.title}</figcaption>
                        </figure>
                    </li>
                ))}
            </ul>
        </section>
    )
}
