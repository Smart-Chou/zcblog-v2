---
/**
 * Talk — 首页「最新随笔」ticker
 *
 * M2-2（D-0110）：包一层 section-header（标题由页面注入），卡片样式在 pages/home.css。
 * reduced-motion：只渲染第一条，不启动轮换（§3.0-6）。
 */
import items from "~/data/talks.json";
import { t, defaultLocale, type Locale } from "~/utils/i18n";
import Icon from "~/components/UI/atom/Icon.astro";

interface Props {
    title: string;
    locale: Locale;
}

const { title, locale } = Astro.props;
const itemsJson = JSON.stringify(items);
const talksUrl = locale === defaultLocale ? "/talks/" : "/en/talks/";
---

{
    items.length > 0 && (
        <section class="talk-section" aria-labelledby="home-talk-title">
            <div class="section-header">
                <h2 class="section-label" id="home-talk-title">
                    {title}
                </h2>
                <a class="section-link" href={talksUrl}>
                    {t(locale, "common.viewAll")}
                    <Icon name="tabler:chevron-right" size="xs" />
                </a>
            </div>
            <div class="talk-card">
                <div class="talk-wrap">
                    <ul class="talk-list" data-items={itemsJson} />
                </div>
            </div>
        </section>
    )
}

<script>
    const DURATION = 6000;
    let intervalId: ReturnType<typeof setInterval> | null = null;
    let timeoutId: ReturnType<typeof setTimeout> | null = null;

    function initTalk() {
        const list = document.querySelector(".talk-list") as HTMLElement | null;
        if (!list) return;

        destroyTalk();

        let items: Array<{ datetime: string; display: string; url: string; content: string }> = [];
        try {
            items = JSON.parse(list.dataset.items || "[]");
        } catch {
            items = [];
        }
        if (!items.length) return;

        let index = 0;

        function render() {
            const item = items[index];
            // 用 DOM API 替代 innerHTML，防止 XSS
            const li = document.createElement("li");

            const span = document.createElement("span");
            span.className = "datetime";
            span.title = item.datetime;
            span.textContent = item.display;

            const a = document.createElement("a");
            a.href = item.url;
            a.textContent = item.content;

            li.appendChild(span);
            li.appendChild(a);

            list!.replaceChildren(li);
        }

        render();

        // 减弱动效：只显示最新一条，不做 6s 轮换（位移 0）
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

        intervalId = setInterval(() => {
            index = (index + 1) % items.length;
            list!.style.opacity = "0";
            list!.style.transform = "translateY(-8px)";
            timeoutId = setTimeout(() => {
                render();
                list!.style.opacity = "1";
                list!.style.transform = "translateY(0)";
            }, 250);
        }, DURATION);
    }

    function destroyTalk() {
        if (intervalId != null) {
            clearInterval(intervalId);
            intervalId = null;
        }
        if (timeoutId != null) {
            clearTimeout(timeoutId);
            timeoutId = null;
        }
    }

    document.addEventListener("astro:before-swap", destroyTalk);
    document.addEventListener("astro:page-load", initTalk);

    // initial call (fires before astro:page-load on first visit)
    initTalk();
</script>
