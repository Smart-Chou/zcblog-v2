---
/**
 * Media — 书影音面板（首页侧栏「文化生活」内的两个小节）
 *
 * M2-2（D-0110）：新增 level（默认 2），侧栏里用 3，避免出现两个同级 h2。
 * 内部仍是 CardGrid（legacy UI，M3 再 atom 化）。
 */
import CardGrid from "~/components/UI/CardGrid.astro";
import { t, type Locale } from "~/utils/i18n";
import Icon from "~/components/UI/atom/Icon.astro";

interface Media {
    url: string;
    rating: number;
    ratingNum?: number;
    title: string;
    link?: string;
}

interface Props {
    title: string;
    items: Media[];
    href?: string;
    limit?: number;
    locale: Locale;
    level?: 2 | 3;
}

const { title, items, href = "#", limit, locale, level = 2 } = Astro.props;
const displayItems = limit ? items.slice(0, limit) : items;
const Heading = `h${level}` as "h2" | "h3";
---

{
    displayItems.length > 0 && (
        <div class="media-panel">
            <div class="section-header">
                <Heading class="section-label">{title}</Heading>
                <a class="section-link" href={href}>
                    {t(locale, "common.viewAll")}
                    <Icon name="tabler:chevron-right" size="xs" />
                </a>
            </div>
            <CardGrid items={displayItems} />
        </div>
    )
}
