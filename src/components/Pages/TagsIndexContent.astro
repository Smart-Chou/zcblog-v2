---
/**
 * P-03 · 标签索引（M2-4）
 *
 * 版式：marx_s_blog_archives_tags_2 的「权重排序标签图谱」——单列网格、
 * 高频 12 个用大号胶囊、长尾用小号胶囊，计数留在胶囊内部。
 * - 只做渲染层：标签统计仍走 utils/article-stats（normalizeTag 口径未改）。
 * - 样式在 src/styles/pages/tags.css。**本组件不写 `<style>`**：Astro 会给
 *   每个元素加 data-astro-cid-*，272 个标签会把 HTML 撑出列表页预算（≤105KB）。
 * - 390 宽不溢出：胶囊 flex-wrap + max-inline-size:100%。
 */
import { getAllTags, getAllArticles, normalizeTag } from "~/utils/article-stats";
import { filterByLang } from "~/utils/article-url";
import BaseLayout from "~/layouts/BaseLayout.astro";
import Author from "~/components/UI/Author.astro";
import Link from "~/components/UI/atom/Link.astro";
import { site } from "~/config";
import { t, getLocale, contentLocaleOf, type Locale } from "~/utils/i18n";

interface Props {
    locale?: string;
}

const { locale = "zh" } = Astro.props;
const loc: Locale = getLocale(locale);
const isEn = loc === "en";

// 仅统计当前语言文章的标签（双语完整化，2026-10；M2-11a：新语言回退 zh 文章）
const allPosts = filterByLang(await getAllArticles(), contentLocaleOf(loc));

const allTags = getAllTags(allPosts);
const tagCounts = allTags.reduce<Record<string, number>>((acc, tag) => {
    const key = normalizeTag(tag);
    acc[key] = (acc[key] || 0) + 1;
    return acc;
}, {});

const sortedTags = Object.entries(tagCounts)
    .map(([name, count]) => ({ name, count }))
    .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name));

const tagPrefix = isEn ? "/en/tags" : "/tags";
const allPostsHref = isEn ? "/en/blog/1/" : "/blog/1/";

/** 权重视觉分级：前 12 高、前 48 中、其余长尾（纯展示，不改排序）。 */
const weightOf = (index: number) => (index < 12 ? 3 : index < 48 ? 2 : 1);
---

<BaseLayout
    locale={loc}
    title={`${t(loc, "tags.title")} - ${site.title}`}
    description={`${t(loc, "tags.description")} - ${site.title}`}
    image={`${Astro.site + site.coverImage}`}
    imageAlt={t(loc, "tags.title")}
    keywords={["Tags"]}
    publishedTime={new Date()}
    modifiedTime={new Date()}
    noindex={true}
>
    <div class="tags-hub">
        <header class="tags-hero">
            <p class="tags-kicker">{isEn ? "TAXONOMY · TAG GRAPH" : "标签 · 图谱"}</p>
            <h1 class="tags-title">{t(loc, "tags.title")}</h1>
            <p class="tags-lede">{t(loc, "tags.subtitle")}</p>
            <p class="tags-meta">
                <span>{isEn ? `${sortedTags.length} tags` : `${sortedTags.length} 个标签`}</span>
                <span>{isEn ? `${allPosts.length} posts` : `${allPosts.length} 篇文章`}</span>
            </p>
        </header>

        <section class="tags-graph" aria-labelledby="tags-graph-title">
            <div class="tags-section-header">
                <h2 id="tags-graph-title" class="tags-section-title">
                    {isEn ? "Weighted tag graph" : "高频热度图谱"}
                </h2>
                <Link href={allPostsHref} variant="standalone" class="tags-section-link">
                    {isEn ? "All posts" : "全部文章"} →
                </Link>
            </div>

            <ul class="tag-cloud" data-count={sortedTags.length}>
                {
                    sortedTags.map(({ name, count }, index) => (
                        <li class="tag-cloud__item" data-weight={weightOf(index)}>
                            <a class="tag-cloud__link" href={`${tagPrefix}/${name}/`}>
                                {name}
                                <span class="tag-cloud__count">{count}</span>
                            </a>
                        </li>
                    ))
                }
            </ul>
        </section>

        <Author />
    </div>
</BaseLayout>
