---
/**
 * P-03 · 标签索引（M6-4 / marx_s_blog_archives_tags_1 右栏 + archives_tags_2 Matrix）
 *
 * Stitch 没有给独立的标签页：本页 = 把桌面归档稿右栏的「热门标签云」按整页重排，
 * 并把移动稿的 Matrix 视图作为移动形态 —— 0 新设计、0 新截图依赖，数据口径不变。
 *
 * - 272+ 标签**纯 CSS 分列**（`columns` + `break-inside: avoid`），不引入 JS 图谱 / d3；
 *   首屏无脚本即可读（本组件没有 `<script>`，也不写 `<style>`：样式在 tags.css，
 *   否则 272 个元素各带一份 data-astro-cid-* 会把 HTML 撑出列表页预算）。
 * - `.tag-cloud__item[data-weight]`（3 = 前 12 / 2 = 前 48 / 1 = 长尾）是既有 e2e 与
 *   视觉分级的公共契约，保留；`.tags-meta` 的第一个数字仍是标签总数（e2e 断言）。
 * - 移动端「编年时空 / 标签图谱」胶囊与 /archives/ 同一套（两条既有路由，非新路由）。
 */
import { getAllTags, getAllArticles, normalizeTag } from "~/utils/article-stats";
import { filterByLang } from "~/utils/article-url";
import BaseLayout from "~/layouts/BaseLayout.astro";
import Author from "~/components/UI/Author.astro";
import Icon from "~/components/UI/atom/Icon.astro";
import { site } from "~/config";
import { t, getLocale, contentLocaleOf, type Locale } from "~/utils/i18n";

interface Props {
    locale?: string;
}

const { locale = "zh" } = Astro.props;
const loc: Locale = getLocale(locale);
const isEn = loc === "en";

// 仅统计当前语言文章的标签（双语完整化，2026-10；M2-11a：新语言回退 zh 文章）
const allPosts = filterByLang(await getAllArticles(), contentLocaleOf(loc));

const allTags = getAllTags(allPosts);
const tagCounts = allTags.reduce<Record<string, number>>((acc, tag) => {
    const key = normalizeTag(tag);
    acc[key] = (acc[key] || 0) + 1;
    return acc;
}, {});

const sortedTags = Object.entries(tagCounts)
    .map(([name, count]) => ({ name, count }))
    .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name));

const totalTags = sortedTags.length;
const totalCount = allPosts.length;
const references = sortedTags.reduce((sum, tag) => sum + tag.count, 0);
const singleUse = sortedTags.filter((tag) => tag.count === 1).length;
const topCount = sortedTags[0]?.count ?? 0;

const tagPrefix = isEn ? "/en/tags" : "/tags";
const allPostsHref = isEn ? "/en/blog/1/" : "/blog/1/";
const archivesHref = isEn ? "/en/archives/" : "/archives/";
const tagsHref = isEn ? "/en/tags/" : "/tags/";

/** 权重分级：featured 行 = 前 12 高，长尾里前 36 个中号、其余小号（纯展示，不改排序）。 */
const viewSwitchLabel = isEn ? "Archives and tags views" : "归档与标签视图";

const stats = [
    { value: String(totalTags), label: isEn ? "tags" : "个标签", icon: "tabler:tags" },
    {
        value: String(references),
        label: isEn ? "references" : "次标签引用",
        icon: "tabler:stack-2",
    },
    { value: String(singleUse), label: isEn ? "used once" : "个只用过一次", icon: "tabler:tool" },
];
---

<BaseLayout
    locale={loc}
    title={`${t(loc, "tags.title")} - ${site.title}`}
    description={`${t(loc, "tags.description")} - ${site.title}`}
    image={`${Astro.site + site.coverImage}`}
    imageAlt={t(loc, "tags.title")}
    keywords={["Tags"]}
    publishedTime={new Date()}
    modifiedTime={new Date()}
    noindex={true}
>
    <div class="tags-hub">
        <header class="tags-hero">
            <div class="tags-hero__main">
                <p class="badge-section">
                    <span class="badge-status-dot" aria-hidden="true"></span>
                    {isEn ? "TAXONOMY · TAG MATRIX" : "TAXONOMY · 标签图谱"}
                </p>
                <h1 class="tags-title">{t(loc, "tags.title")}</h1>
                <p class="tags-lede">{t(loc, "tags.subtitle")}</p>
                <p class="tags-meta mono-label">
                    <span>{isEn ? `${totalTags} tags` : `${totalTags} 个标签`}</span>
                    <span>{isEn ? `${totalCount} posts` : `${totalCount} 篇文章`}</span>
                    <span>{isEn ? `top tag ×${topCount}` : `最高频 ×${topCount}`}</span>
                </p>
            </div>
        </header>

        <nav class="tags-switch" aria-label={viewSwitchLabel}>
            <a class="tags-switch__item" href={archivesHref}>
                <Icon name="tabler:clock" size="sm" />
                <span>{isEn ? "Timeline" : "编年时空"}</span>
            </a>
            <a class="tags-switch__item" href={tagsHref} aria-current="page">
                <Icon name="tabler:tags" size="sm" />
                <span>{isEn ? "Matrix" : "标签图谱"}</span>
            </a>
        </nav>

        <section class="tags-stats" aria-label={isEn ? "Tag statistics" : "标签统计"}>
            {
                stats.map((stat) => (
                    <article class="tags-stat">
                        <Icon name={stat.icon} size="sm" class="tags-stat__icon" />
                        <span class="mono-metric tags-stat__value">{stat.value}</span>
                        <span class="tags-stat__label">{stat.label}</span>
                    </article>
                ))
            }
        </section>

        <section class="tags-graph" aria-labelledby="tags-graph-title">
            <div class="tags-section-header">
                <div class="tags-section-header__main">
                    <h2 id="tags-graph-title" class="tags-section-title">
                        {isEn ? "Weighted tag matrix" : "高频热度图谱"}
                    </h2>
                    <p class="tags-section-note">
                        {
                            isEn
                                ? "Sorted by weight: the first 12 are the primary topics; the tail is long and quiet. Pure CSS columns, no script."
                                : "按权重排序：前 12 是主主题，长尾很长也很安静 —— 纯 CSS 分列，无脚本。"
                        }
                    </p>
                </div>
                <a class="tags-section-link mono-label" href={allPostsHref}>
                    {isEn ? "All posts" : "全部文章"} →
                </a>
            </div>

            <ul class="tag-cloud tag-cloud--featured" data-count="12">
                {
                    sortedTags.slice(0, 12).map(({ name, count }) => (
                        <li class="tag-cloud__item" data-weight="3">
                            <a class="tag-cloud__link" href={`${tagPrefix}/${name}/`}>
                                {name}
                                <span class="tag-cloud__count">{count}</span>
                            </a>
                        </li>
                    ))
                }
            </ul>

            <ul class="tag-cloud tag-cloud--tail" data-count={totalTags - 12}>
                {
                    sortedTags.slice(12).map(({ name, count }, index) => (
                        <li class="tag-cloud__item" data-weight={index < 36 ? 2 : 1}>
                            <a class="tag-cloud__link" href={`${tagPrefix}/${name}/`}>
                                {name}
                                <span class="tag-cloud__count">{count}</span>
                            </a>
                        </li>
                    ))
                }
            </ul>
        </section>

        <Author />
    </div>
</BaseLayout>
