---
/**
 * P-05 · 友链页（M2-6a）
 *
 * 结构（沿用 M2-2/M2-4 的编辑式版面语言：mono kicker + 衬线标题 + accent 短尺）：
 *   1. hero        —— h1 / 一句话定位 / 友人计数 / 跳到申请
 *   2. 朋友的小站  —— 三态：ok（卡片网格）/ empty（空态块）/ error（警示块）
 *   3. 申请友链    —— 本站信息（可复制）+ 三步流程 + 模板 + GitHub 入口
 *   4. 注意事项    —— 四条互换规则
 *   5. 评论区      —— 放在 `.friends` 之外：第三方组件不进页面主体的样式/a11y 范围
 *
 * 约束：
 * - 数据只来自 props.feed（friends adapter 的产物）；本组件 0 数据、0 站点私有文案。
 * - 样式在 src/styles/pages/friends.css（0 颜色字面量、尺寸全部 token）。
 * - 标题层级 h1 → h2 → h3，任何一态都不跳级（e2e 覆盖）。
 * - 空态/错误态都是页面状态：路由照常 200，申请入口与评论不受影响。
 */
import BaseLayout from "~/layouts/BaseLayout.astro";
import Card from "~/components/UI/atom/Card.astro";
import Icon from "~/components/UI/atom/Icon.astro";
import Alert from "~/components/UI/atom/Alert.astro";
import FriendPill from "~/components/UI/FriendPill.astro";
import FriendCard from "~/components/UI/FriendCard.astro";
import FriendApply from "~/components/UI/FriendApply.astro";
import WalineComment from "~/components/UI/WalineComment.astro";
import { site, author, waline, friendsPage } from "~/config";
import siteAvatar from "~/assets/logo.svg";
import { t, getLocale, type Locale } from "~/utils/i18n";
import type { FriendsFeed } from "~/data/adapters/friends";

interface Props {
    locale?: string;
    /** friends adapter 的三态产物；缺省为空态（组件被单独渲染时也不炸）。 */
    feed?: FriendsFeed;
    /**
     * 友圈文章（构建期快照归一化产物）。M8-5a：空数组 = 快照缺失/为空/全条目非法
     * → 整个「友圈」区块不渲染（不留空壳），页面其余部分照常。
     */
    articles?: readonly FriendsArticle[];
}

/** 友圈文章条目（与 FriendCard 的 props 同形）。 */
interface FriendsArticle {
    site: string;
    title: string;
    url: string;
    updated: string;
    avatar?: string;
}

const { locale = "zh", feed, articles = [] } = Astro.props;
const loc: Locale = getLocale(locale);
const isEn = loc === "en";

const resolved: FriendsFeed = feed ?? {
    status: "empty",
    items: [],
    total: 0,
    dropped: 0,
    issue: { code: "source-missing" },
};

const siteInfo = {
    name: site.title,
    description: t(loc, "site.subtitle"),
    link: site.url,
    avatar: `${site.url}/${author.avatar}`,
};

const siteInfoFields = [
    { key: "siteName", label: t(loc, "friends.fieldLabels.siteName"), value: siteInfo.name },
    {
        key: "siteDescription",
        label: t(loc, "friends.fieldLabels.siteDescription"),
        value: siteInfo.description,
    },
    { key: "siteLink", label: t(loc, "friends.fieldLabels.siteLink"), value: siteInfo.link },
    { key: "avatarLink", label: t(loc, "friends.fieldLabels.avatarLink"), value: siteInfo.avatar },
];

const templateText = siteInfoFields.map((field) => `${field.label}：${field.value}`).join("\n");
const templatePlaceholder = siteInfoFields
    .map((field) => `${field.label}：${isEn ? "<your site info>" : "<你的站点信息>"}`)
    .join("\n");

const steps = [
    { title: t(loc, "friends.steps.step1Title"), text: t(loc, "friends.steps.step1Desc") },
    { title: t(loc, "friends.steps.step2Title"), text: t(loc, "friends.steps.step2Desc") },
    { title: t(loc, "friends.steps.step3Title"), text: t(loc, "friends.steps.step3Desc") },
];

const notes = [
    { title: t(loc, "friends.notes.exchangeTitle"), text: t(loc, "friends.notes.exchangeDesc") },
    {
        title: t(loc, "friends.notes.maintenanceTitle"),
        text: t(loc, "friends.notes.maintenanceDesc"),
    },
    { title: t(loc, "friends.notes.contentTitle"), text: t(loc, "friends.notes.contentDesc") },
    { title: t(loc, "friends.notes.siteTitle"), text: t(loc, "friends.notes.siteDesc") },
];

const countLabel = isEn ? `${resolved.total} friends` : `${resolved.total} 位友人`;
---

<BaseLayout
    locale={loc}
    title={`${t(loc, "friends.title")} - ${site.title}`}
    description={`${t(loc, "friends.description")} - ${site.title}`}
    image={`${Astro.site + site.coverImage}`}
    imageAlt={t(loc, "friends.title")}
    keywords={["Friends", "友链", "RSS"]}
>
    <article
        class="friends"
        data-friends-status={resolved.status}
        data-friends-total={resolved.total}
        aria-labelledby="friends-title"
    >
        <header class="friends-hero">
            <p class="friends-kicker">{isEn ? "FRIENDS · RSS" : "友人 · RSS"}</p>
            <h1 class="friends-title" id="friends-title">{t(loc, "friends.title")}</h1>
            <p class="friends-lede">{t(loc, "friends.description")}</p>
            <div class="friends-hero__meta">
                <span class="friends-count">
                    <Icon name="tabler:heart-handshake" size="xs" />
                    {countLabel}
                </span>
                <a class="friends-jump" href="#friends-apply">
                    {t(loc, "friends.addFriend")}
                    <Icon name="tabler:chevron-right" size="xs" />
                </a>
            </div>
        </header>

        <section class="friends-section" id="friends-list" aria-labelledby="friends-list-title">
            <div class="friends-section__head">
                <h2 class="friends-section__title" id="friends-list-title">
                    {isEn ? "Friends' sites" : "朋友的小站"}
                </h2>
                <p class="friends-section__meta">
                    {isEn ? "Each card opens in a new tab" : "每张卡片在新标签页打开"}
                </p>
            </div>

            {
                resolved.status === "ok" && (
                    <ul class="friends-grid" role="list">
                        {resolved.items.map((friend) => (
                            <FriendPill
                                name={friend.name}
                                url={friend.url}
                                avatar={friend.avatar}
                                description={friend.description}
                            />
                        ))}
                    </ul>
                )
            }

            {
                resolved.status === "error" && (
                    <div
                        class="friends-state"
                        data-friends-error={resolved.issue?.code ?? "unknown"}
                    >
                        <Alert
                            tone="warning"
                            title={isEn ? "Friend links could not be read" : "友链数据读取失败"}
                        >
                            {isEn
                                ? "The friend-link file exists but its shape is invalid, so nothing is listed here. The application steps and comments below are unaffected."
                                : "友链数据文件存在但格式不合法，这里暂不列出。下方的申请流程与评论区不受影响。"}
                        </Alert>
                        <p class="friends-state__hint">
                            {isEn
                                ? `Reason code: ${resolved.issue?.code ?? "unknown"}`
                                : `原因代码：${resolved.issue?.code ?? "unknown"}`}
                        </p>
                    </div>
                )
            }

            {
                resolved.status === "empty" && (
                    <div
                        class="friends-state friends-state--empty"
                        data-friends-empty={resolved.issue?.code ?? "unknown"}
                    >
                        <span class="friends-state__icon" aria-hidden="true">
                            <Icon name="tabler:user-circle" size="lg" />
                        </span>
                        <p class="friends-state__title">
                            {isEn ? "No friend links yet" : "还没有友链"}
                        </p>
                        <p class="friends-state__text">
                            {isEn
                                ? "This site has not published a friends list yet — you can be the first one here."
                                : "这个站点还没挂上友链，欢迎成为这里的第一位。"}
                        </p>
                        <a class="friends-state__cta" href="#friends-apply">
                            {t(loc, "friends.addFriend")}
                            <Icon name="tabler:chevron-right" size="xs" />
                        </a>
                    </div>
                )
            }
        </section>

        {
            articles.length > 0 && (
                <section
                    class="friends-section"
                    id="friends-feed"
                    aria-labelledby="friends-feed-title"
                >
                    <div class="friends-section__head">
                        <h2 class="friends-section__title" id="friends-feed-title">
                            {isEn ? "Latest from friends" : "友圈最新文章"}
                        </h2>
                        <p class="friends-section__meta">
                            {isEn
                                ? `${articles.length} posts from friends' RSS`
                                : `来自友链 RSS 的 ${articles.length} 篇文章`}
                        </p>
                    </div>

                    <ul class="friends-articles" role="list" data-friends-feed={articles.length}>
                        {articles.map((article) => (
                            <FriendCard
                                as="li"
                                site={article.site}
                                name={article.site}
                                avatar={article.avatar}
                                title={article.title}
                                url={article.url}
                                updated={article.updated}
                            />
                        ))}
                    </ul>
                </section>
            )
        }

        <section class="friends-section" id="friends-apply" aria-labelledby="friends-apply-title">
            <div class="friends-section__head">
                <h2 class="friends-section__title" id="friends-apply-title">
                    {t(loc, "friends.steps.title")}
                </h2>
                <p class="friends-section__meta">{t(loc, "friends.note")}</p>
            </div>

            <div class="friends-apply">
                <Card variant="raised" padding="lg" as="div" class="friends-panel">
                    <div class="friends-identity">
                        <img
                            class="friends-identity__avatar"
                            src={siteAvatar.src}
                            alt=""
                            width="48"
                            height="48"
                            loading="lazy"
                            decoding="async"
                        />
                        <div class="friends-identity__text">
                            <h3 class="friends-identity__name">{siteInfo.name}</h3>
                            <p class="friends-identity__desc">{siteInfo.description}</p>
                        </div>
                    </div>

                    <dl class="friends-fields">
                        {
                            siteInfoFields.map((field) => (
                                <div class="friends-field">
                                    <dt class="friends-field__label">{field.label}</dt>
                                    <dd class="friends-field__value">
                                        <span class="friends-field__text">{field.value}</span>
                                        <button
                                            class="friends-copy"
                                            type="button"
                                            data-copy={field.value}
                                            data-copied-label={t(loc, "common.copied")}
                                            aria-label={`${t(loc, "friends.copy")}：${field.label}`}
                                        >
                                            <span class="friends-copy__glyph friends-copy__glyph--copy">
                                                <Icon name="tabler:copy" size="xs" />
                                            </span>
                                            <span class="friends-copy__glyph friends-copy__glyph--done">
                                                <Icon name="tabler:check" size="xs" />
                                            </span>
                                        </button>
                                    </dd>
                                </div>
                            ))
                        }
                    </dl>
                </Card>

                <Card variant="raised" padding="lg" as="div" class="friends-panel">
                    <ol class="friends-steps">
                        {
                            steps.map((step, index) => (
                                <li class="friends-step">
                                    <div class="friends-step__body">
                                        <h3 class="friends-step__title">{step.title}</h3>
                                        <p class="friends-step__text">{step.text}</p>
                                        {index === 1 && (
                                            <div class="friends-template">
                                                <pre
                                                    class="friends-template__code"
                                                    set:text={templateText}
                                                />
                                                <button
                                                    class="friends-copy friends-copy--template"
                                                    type="button"
                                                    data-copy={templatePlaceholder}
                                                    data-copied-label={t(loc, "common.copied")}
                                                    aria-label={t(loc, "friends.copyTemplate")}
                                                >
                                                    <span class="friends-copy__glyph friends-copy__glyph--copy">
                                                        <Icon name="tabler:copy" size="xs" />
                                                    </span>
                                                    <span class="friends-copy__glyph friends-copy__glyph--done">
                                                        <Icon name="tabler:check" size="xs" />
                                                    </span>
                                                </button>
                                            </div>
                                        )}
                                    </div>
                                </li>
                            ))
                        }
                    </ol>

                    {
                        friendsPage.friendLinkApplyUrl && (
                            <a
                                class="friends-gh"
                                href={friendsPage.friendLinkApplyUrl}
                                target="_blank"
                                rel="noopener noreferrer"
                            >
                                <Icon name="tabler:brand-github" size="xs" />
                                {t(loc, "friends.steps.viaGithub")}
                            </a>
                        )
                    }
                </Card>
            </div>
        </section>

        <section class="friends-section" aria-labelledby="friends-notes-title">
            <div class="friends-section__head">
                <h2 class="friends-section__title" id="friends-notes-title">
                    {t(loc, "friends.notes.title")}
                </h2>
                <p class="friends-section__meta">
                    {isEn ? "Read before you apply" : "申请前请先读一遍"}
                </p>
            </div>
            <ul class="friends-notes" role="list">
                {
                    notes.map((note) => (
                        <li class="friends-note">
                            <strong class="friends-note__title">{note.title}</strong>
                            <span class="friends-note__text">{note.text}</span>
                        </li>
                    ))
                }
            </ul>
        </section>
    </article>

    {
        /* M8-5c：申请弹层（原生 dialog，关闭态 hidden；触发入口 = 上面那张卡里的「通过 GitHub 申请」） */
    }
    <FriendApply locale={loc} />

    {waline.enable && <WalineComment locale={loc} />}
</BaseLayout>

<script>
    /**
     * 复制按钮：事件委托 → swup 换页后无需重新绑定。
     * 非安全上下文（http）下 clipboard 不可用：静默降级，按钮本身仍可聚焦、可读。
     */
    const FEEDBACK_MS = 1500;

    document.addEventListener("click", async (event) => {
        const target = event.target as HTMLElement | null;
        const button = target?.closest<HTMLButtonElement>("[data-copy]");
        if (!button) return;

        const text = button.dataset.copy ?? "";
        if (!text) return;

        const originalLabel = button.getAttribute("aria-label");
        try {
            await navigator.clipboard.writeText(text);
        } catch {
            return;
        }

        button.classList.add("is-copied");
        if (button.dataset.copiedLabel) {
            button.setAttribute("aria-label", button.dataset.copiedLabel);
        }
        window.setTimeout(() => {
            button.classList.remove("is-copied");
            if (originalLabel) button.setAttribute("aria-label", originalLabel);
        }, FEEDBACK_MS);
    });
</script>
