---
/**
 * P-06 · 随笔页（M2-6b 初版；M8-6-3 视觉重做 = `talks_blinko_1` 桌面 / `talks_blinko_2` 移动）
 *
 * 结构（M8-6-3）：
 *   1. 页头   —— `PageHero`（kicker / h1 / lede / 统计行 / 来源站入口）；h1 保留语义类 `.talks-title`
 *   2. 两栏   —— ≥1024：左 3.5 栅 sticky 筛选（话题云）+ 右时间流；<1024：筛选降级为顶部横滑、正文单列
 *   3. 时间流 —— `SectionHead`（meta「最新在上」）+ `<ol>` + 轨道 + 日期列 + `EssayItem`
 *   4. 空/错态 —— `DataState`（error 态内建 Alert warning + 原因码）
 *
 * 约束：
 * - 数据只来自 props.feed（talks adapter 的产物）；本组件 0 数据、0 站点私有文案。
 * - 样式在 src/styles/pages/talks.css（0 颜色字面量、尺寸全部 token）。
 * - 标题层级 h1 → h2，任何一态都不跳级（e2e 覆盖）。
 * - 空态/错误态都是页面状态：路由照常 200，评论区照常渲染。
 * - **0 客户端 JS**：sticky 与顶部横滑都是纯 CSS（R4：列表页 JS 预算 28 KB）。
 */
import BaseLayout from "~/layouts/BaseLayout.astro";
import PageHero from "~/components/UI/molecule/PageHero.astro";
import SectionHead from "~/components/UI/atom/SectionHead.astro";
import DataState from "~/components/UI/molecule/DataState.astro";
import Tag from "~/components/UI/atom/Tag.astro";
import EssayItem from "~/components/UI/EssayItem.astro";
import WalineComment from "~/components/UI/WalineComment.astro";
import { site, author, waline } from "~/config";
import { talksPage } from "~/config/ui";
import logo from "~/assets/logo.svg";
import { t, getLocale, type Locale } from "~/utils/i18n";
import type { TalksFeed } from "~/data/adapters/talks";

interface Props {
    locale?: string;
    /** talks adapter 的三态产物；缺省为空态（组件被单独渲染时也不炸）。 */
    feed?: TalksFeed;
}

const { locale = "zh", feed } = Astro.props;
const loc: Locale = getLocale(locale);
const isEn = loc === "en";

const resolved: TalksFeed = feed ?? {
    status: "empty",
    items: [],
    total: 0,
    dropped: 0,
    tags: [],
    newest: null,
    issue: { code: "source-missing" },
};

const authorName = author.type;
const avatar = logo.src;

const formatDay = (iso: string | null) =>
    iso === null
        ? ""
        : new Intl.DateTimeFormat(isEn ? "en-US" : "zh-CN", {
              year: "numeric",
              month: "short",
              day: "numeric",
          }).format(new Date(iso));

const newestLabel = formatDay(resolved.newest);
const countLabel = isEn ? `${resolved.total} entries` : `${resolved.total} 条`;
const tagCountLabel = isEn ? `${resolved.tags.length} topics` : `${resolved.tags.length} 个话题`;
const MAX_TAGS = 24;

/**
 * 页头统计行（P3-03）：
 * - 条数 chip **恒在**（0 条也报 0，避免「空页头」）；
 * - 标签数 chip 仅当 tags.length > 0；
 * - 最近时间 chip 仅当 adapter 给出 newest。
 */
const heroMeta = [
    { icon: "tabler:message-chatbot-filled", label: countLabel },
    ...(resolved.tags.length > 0
        ? [{ icon: "tabler:tags", label: tagCountLabel }]
        : []),
    ...(newestLabel ? [{ label: isEn ? `latest ${newestLabel}` : `最近 ${newestLabel}`, quiet: true }] : []),
];

/** 左栏筛选只在 ok 态且有话题时存在（P3-07：空态不渲染话题云）。 */
const hasTopics = resolved.status === "ok" && resolved.tags.length > 0;
const issueCode = resolved.issue?.code ?? "unknown";
---

<BaseLayout
    locale={loc}
    title={`${t(loc, "talks.title")} - ${site.title}`}
    description={`${t(loc, "talks.description")} - ${site.title}`}
    image={`${Astro.site + site.coverImage}`}
    imageAlt={t(loc, "talks.title")}
    keywords={["Talks", "随笔", "碎碎念", "Blinko"]}
>
    <article
        class="talks"
        data-talks-status={resolved.status}
        data-talks-total={resolved.total}
        aria-labelledby="talks-title"
    >
        <PageHero
            kicker={isEn ? "TALKS · MEMOS" : "随笔 · 碎念"}
            title={t(loc, "talks.title")}
            lede={t(loc, "talks.subtitle")}
            meta={heroMeta}
            id="talks-title"
            titleClass="talks-title"
        >
            {
                talksPage.sourceUrl && (
                    <a
                        class="talks-source"
                        href={talksPage.sourceUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        {isEn
                            ? `Open ${talksPage.sourceName ?? "source"}`
                            : `去${talksPage.sourceName ?? "来源"}看`}
                        <span class="talks-source__arrow" aria-hidden="true">↗</span>
                    </a>
                )
            }
        </PageHero>

        <div class:list={["talks-layout", hasTopics && "talks-layout--two-col"]}>
            {
                hasTopics && (
                    <aside class="talks-filters" aria-labelledby="talks-topics-title">
                        <SectionHead
                            id="talks-topics-title"
                            title={isEn ? "Topics" : "话题"}
                            meta={isEn ? "By frequency" : "按出现次数排序"}
                        />
                        <ul class="talks-topics" role="list">
                            {resolved.tags.slice(0, MAX_TAGS).map((tag) => (
                                <li class="talks-topic">
                                    <Tag tone="neutral" size="sm">
                                        #{tag.name}
                                        <span class="talks-topic__count">
                                            {isEn ? `${tag.count}×` : `${tag.count} 次`}
                                        </span>
                                    </Tag>
                                </li>
                            ))}
                        </ul>
                    </aside>
                )
            }

            <section class="talks-main" aria-labelledby="talks-timeline-title">
                <SectionHead
                    id="talks-timeline-title"
                    title={isEn ? "Timeline" : "时间线"}
                    meta={isEn ? "Newest first" : "最新在上"}
                />

                {
                    resolved.status === "ok" && (
                        <div class="talks-track">
                            {/* 轨道用真实元素画，不用 ::before：绝对定位的伪元素会让 axe 判定
                                「背景色无法确定」，把整条时间线的对比度检查降级成 incomplete。 */}
                            <span class="talks-rail" aria-hidden="true" />
                            <ol class="talks-timeline" role="list">
                                {resolved.items.map((item) => (
                                    <li class="talks-entry">
                                        <p class="talks-entry__day">
                                            <time datetime={item.ts === null ? undefined : item.time}>
                                                {formatDay(item.time) || item.time}
                                            </time>
                                        </p>
                                        <EssayItem
                                            item={item}
                                            author={authorName}
                                            avatar={avatar}
                                            locale={loc}
                                        />
                                    </li>
                                ))}
                            </ol>
                        </div>
                    )
                }

                {
                    resolved.status === "error" && (
                        <div class="talks-state" data-talks-error={issueCode}>
                            <DataState
                                kind="error"
                                title={isEn ? "Talk data could not be read" : "随笔数据读取失败"}
                                message={
                                    isEn
                                        ? "The talk file exists but its shape is invalid, so nothing is listed here. Everything else on this page still works."
                                        : "随笔数据文件存在但格式不合法，这里暂不列出。页面其余部分不受影响。"
                                }
                                code={issueCode}
                                codeLabel={isEn ? "Reason code" : "原因代码"}
                            />
                        </div>
                    )
                }

                {
                    resolved.status === "empty" && (
                        <div class="talks-state" data-talks-empty={issueCode}>
                            <DataState
                                kind="empty"
                                icon="tabler:message-chatbot-filled"
                                title={isEn ? "No talks yet" : "还没有随笔"}
                                message={
                                    isEn
                                        ? "This site has not connected its talk source yet — the page stays up, just empty."
                                        : "这个站点还没接入随笔数据源。空态也是页面的一部分：路由照常可访问。"
                                }
                            />
                        </div>
                    )
                }
            </section>
        </div>
    </article>

    {waline.enable && <WalineComment locale={loc} />}
</BaseLayout>
