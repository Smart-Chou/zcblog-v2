---
/**
 * P-03 · 标签详情（M2-4 建，M6-4 换皮）
 *
 * 版式：与 /tags/ 同一套页头（badge + 衬线标题 + lede + 等宽计数），文章列表**复用**
 * `TagsPostCard`（`.post-card` / `.post-card-link` 契约不动，e2e 依赖它们）。
 * - 只做渲染层：标签页路由与分页 URL 规则不动（G2 契约，见 utils/tag-paths）。
 * - 样式在 src/styles/pages/tags.css。
 */
import type { CollectionEntry } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";
import TagsPostCard from "~/components/Article/TagsPostCard.astro";
import EmptyState from "~/components/UI/EmptyState.astro";
import Icon from "~/components/UI/atom/Icon.astro";
import { site } from "~/config";
import { enrichPost } from "~/utils/get-posts-with-meta";
import { t, getLocale, type Locale } from "~/utils/i18n";

interface Props {
    locale?: string;
    articles: CollectionEntry<"article">[];
}

const { locale = "zh", articles } = Astro.props;
const loc: Locale = getLocale(locale);
const isEn = loc === "en";

const tag = (Astro.params.tag as string) || "";

const postsWithMeta = articles.map((post: CollectionEntry<"article">) => enrichPost(post));
const latestModified = postsWithMeta[0]?.modifiedTime || new Date();
const tagsHref = isEn ? "/en/tags/" : "/tags/";
const countLabel = isEn
    ? `${postsWithMeta.length} ${postsWithMeta.length === 1 ? "post" : "posts"} tagged “${tag}”`
    : `${postsWithMeta.length} 篇文章标签为 “${tag}”`;
---

<BaseLayout
    locale={loc}
    title={`# ${tag} - ${site.title}`}
    description={`${tag} - ${site.description}`}
    image={`${Astro.site + site.coverImage}`}
    imageAlt={tag}
    keywords={[tag]}
    publishedTime={new Date()}
    modifiedTime={latestModified}
    noindex={true}
>
    <div class="tag-detail">
        <header class="tag-detail__hero">
            <p class="badge-section tags-kicker">
                <span class="badge-status-dot" aria-hidden="true"></span>
                {isEn ? "TAGS · INDEX" : "TAGS · 标签索引"}
            </p>
            <h1 class="tag-detail__title">
                <span class="tag-detail__hash" aria-hidden="true">#</span>
                {tag}
            </h1>
            <p class="tag-detail__lede">{countLabel}</p>
            <a href={tagsHref} class="tag-detail__back mono-label">
                <Icon name="tabler:chevron-left" size="sm" />
                {isEn ? "All tags" : "全部标签"}
            </a>
        </header>

        {
            postsWithMeta.length > 0 ? (
                <div class="posts tag-detail__posts">
                    {postsWithMeta.map((post) => (
                        <TagsPostCard
                            title={post.data.title}
                            description={post.data.description || post.excerpt}
                            tags={post.data.tags || []}
                            postUrl={`${isEn ? "/en/article" : "/article"}/${isEn ? (post.slug || post.id).replace(/-en$/, "") : post.slug || post.id}/`}
                            publishedTime={post.data.pubDate}
                            modifiedTime={post.modifiedTime}
                            wordCount={post.wordCount}
                            readTime={post.readTime}
                            currentSlug={post.slug}
                        />
                    ))}
                </div>
            ) : (
                <EmptyState
                    title={t(loc, "tags.emptyTitle")}
                    message={t(loc, "tags.emptyMessage", { tag })}
                />
            )
        }
    </div>
</BaseLayout>
