---
/**
 * DynamicIcon — 图标实例（sprite 引用）
 *
 * 图形本体在构建期生成的 public/icons.svg 里（scripts/generate-icons.js），这里只输出
 * `<svg viewBox><use href="/icons.svg?v=<hash>#id"></use></svg>`，每页 HTML 因此不再重复
 * 携带几百字节的 path 数据。class/width/height/style 语义与原内联版本一致；
 * 少数自带内部引用的图标（logos:telegram / mingcute:github-line）自动回退内联。
 */
import { iconMarkup } from "~/components/Icons/icon-markup";

interface Props {
    name: string;
    class?: string;
    width?: number | string;
    height?: number | string;
    style?: string;
}

const { name, class: className, width, height, style } = Astro.props;

const markup = iconMarkup(name, { class: className, width, height, style });
---

{markup ? <Fragment set:html={markup} /> : <span>?</span>}
