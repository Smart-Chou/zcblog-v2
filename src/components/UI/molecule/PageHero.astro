---
/**
 * PageHero — DESIGN.md §5.6.13（molecule，M8-6-0）
 *
 * 6 页内容的统一页头：kicker（mono 大写 + accent 短尺）+ h1 + lede + meta 行 + 可选分隔线。
 * 只出结构，不出页面专属视觉（chip 的语义、区块间距归页卡）。
 *
 * 断点契约（@media 只允许 450 / 768 / 1024）：
 *   ≥768  h1 = --text-4xl(44)，lede 保持 --text-base
 *   ≤768  h1 降 --text-3xl(32)，lede 不降（正文可读性优先）
 *   ≤450  底部 padding --space-6 → --space-4，chip 行 gap --space-3 → --space-2
 * h1 禁止 clamp() / vw（D-0149 / D1）。
 *
 * 空值：kicker 空 → 短尺一起不渲染；lede 空 → 不留空 div；meta 空 → 整行不渲染。
 * 依赖白名单：Icon。JS 0 字节。
 */
import Icon from "../atom/Icon.astro";

export interface Props {
    /** mono 大写标签，前置 accent 短尺（装饰）；空则不渲染整行。 */
    kicker?: string;
    /** h1 文本。 */
    title: string;
    /** 副文案，单段；空则不渲染。 */
    lede?: string;
    /** 页头统计/状态行；`quiet` = fg-muted 弱化档。 */
    meta?: Array<{ icon?: string; label: string; quiet?: boolean }>;
    /** 底部 1px 分隔线，默认 true（系列页传 false）。 */
    divider?: boolean;
    /** h1 的 id（供 `aria-labelledby`）；与 `slug` 至少给一个。 */
    id?: string;
    /** 未给 `id` 时的兜底：h1 id = `${slug}-title`。 */
    slug?: string;
    /**
     * h1 的额外语义类（附加在 `.page-hero__title` 之后，不替换）。
     * 只用于页面的既有契约选择器（如赞赏 `donations-title`、随笔 `talks-title`），
     * 不改任何视觉：`.page-hero__title` 的排版规则仍然生效。
     */
    titleClass?: string;
    class?: string;
}

const {
    kicker,
    title,
    lede,
    meta = [],
    divider = true,
    id,
    slug,
    titleClass,
    class: className,
} = Astro.props;

const titleId = id ?? (slug ? `${slug}-title` : undefined);
const hasMeta = meta.length > 0;
const hasActions = Astro.slots.has("default");
---

<header class:list={["page-hero", divider && "page-hero--divider", className]}>
    {
        kicker && (
            <p class="page-hero__kicker">
                <span class="page-hero__rule" aria-hidden="true" />
                <span class="page-hero__kicker-text">{kicker}</span>
            </p>
        )
    }
    <h1 class:list={["page-hero__title", titleClass]} id={titleId}>{title}</h1>
    {lede && <p class="page-hero__lede">{lede}</p>}
    {
        (hasMeta || hasActions) && (
            <div class="page-hero__footer">
                {hasMeta && (
                    <ul class="page-hero__meta">
                        {meta.map((item) => (
                            <li
                                class:list={[
                                    "page-hero__chip",
                                    item.quiet && "page-hero__chip--quiet",
                                ]}
                            >
                                {item.icon && <Icon name={item.icon} size="xs" />}
                                <span class="page-hero__chip-label">{item.label}</span>
                            </li>
                        ))}
                    </ul>
                )}
                {hasActions && (
                    <div class="page-hero__actions">
                        <slot />
                    </div>
                )}
            </div>
        )
    }
</header>

<style>
    .page-hero {
        display: flex;
        flex-direction: column;
        gap: var(--space-3);
        box-sizing: border-box;
        padding-block-end: var(--space-6);
        font-family: var(--font-sans);
    }

    .page-hero--divider {
        border-block-end: 1px solid var(--color-border-subtle);
    }

    .page-hero__kicker {
        display: inline-flex;
        align-items: center;
        gap: var(--space-2);
        margin: 0;
        color: var(--color-fg-muted);
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        letter-spacing: var(--tracking-wide);
        line-height: var(--leading-tight);
        text-transform: uppercase;
    }

    /* 短尺长度取 --space-12（48），源码不出现尺寸字面量。 */
    .page-hero__rule {
        flex: none;
        inline-size: var(--space-12);
        block-size: 2px;
        background-color: var(--color-accent-solid);
    }

    .page-hero__kicker-text {
        min-inline-size: 0;
    }

    .page-hero__title {
        margin: 0;
        color: var(--color-fg-heading);
        font-family: var(--font-serif);
        font-size: var(--text-4xl);
        font-weight: var(--font-weight-regular);
        letter-spacing: var(--tracking-tight);
        line-height: var(--leading-tight);
        text-wrap: balance;
    }

    .page-hero__lede {
        max-inline-size: var(--measure-prose);
        margin: 0;
        color: var(--color-fg-default);
        font-size: var(--text-base);
        line-height: var(--leading-relaxed);
    }

    .page-hero__footer {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-3);
        margin-block-start: var(--space-1);
    }

    .page-hero__meta {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-3);
        margin: 0;
        padding: 0;
        list-style: none;
        color: var(--color-fg-default);
        font-size: var(--text-xs);
        line-height: var(--leading-tight);
    }

    .page-hero__chip {
        display: inline-flex;
        align-items: center;
        gap: var(--space-1);
        min-inline-size: 0;
    }

    .page-hero__chip--quiet {
        color: var(--color-fg-muted);
    }

    .page-hero__actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-2);
        margin-inline-start: auto;
    }

    @media (max-width: 768px) {
        .page-hero__title {
            font-size: var(--text-3xl);
        }
    }

    @media (max-width: 450px) {
        .page-hero {
            padding-block-end: var(--space-4);
        }

        .page-hero__meta,
        .page-hero__footer {
            gap: var(--space-2);
        }
    }
</style>
