---
import "~/styles/comments.css";
import { waline } from "~/config";

interface Props {
    locale?: string;
}

const { locale = "zh" } = Astro.props;
const isEn = locale === "en";
---

<!-- 样式基线在 src/styles/article.css（D-0085）；M7-2a 的移动抽屉外壳在 src/styles/comments.css -->{
    waline.enable && (
        <div id="comment-wrapper" data-waline-locale={locale}>
            <button id="waline-toggle" type="button" aria-expanded="false" aria-controls="waline">
                {isEn ? "Show Comments" : "展开评论"}
            </button>
            {/* M7-2a：移动端（≤640）是贴底抽屉，桌面（≥641）整个外壳
                `display: contents`，评论仍是正文流内联块 —— 一套 DOM 两形态。 */}
            <div id="waline-drawer" class="comment-drawer" data-state="closed">
                <div class="comment-drawer__scrim" data-drawer-dismiss aria-hidden="true" />
                <div class="comment-drawer__sheet">
                    <div class="comment-drawer__bar">
                        <span class="comment-drawer__grip" aria-hidden="true" />
                        <div class="comment-drawer__head">
                            <div class="comment-drawer__heading">
                                <h2 class="comment-drawer__title" id="waline-drawer-title">
                                    {isEn ? "Comments" : "评论"}
                                </h2>
                                <p class="comment-drawer__meta">
                                    <span class="comment-drawer__dot" aria-hidden="true" />
                                    Waline · {isEn ? "loaded on demand" : "按需加载"}
                                </p>
                            </div>
                            <button
                                type="button"
                                class="comment-drawer__close"
                                data-drawer-dismiss
                                aria-label={isEn ? "Close comments" : "关闭评论"}
                            >
                                <svg
                                    width="16"
                                    height="16"
                                    viewBox="0 0 16 16"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="1.6"
                                    stroke-linecap="round"
                                    aria-hidden="true"
                                >
                                    <path d="M4 4l8 8M12 4l-8 8" />
                                </svg>
                            </button>
                        </div>
                    </div>
                    <div class="comment-drawer__body" id="waline-drawer-body">
                        <div id="waline" />
                    </div>
                </div>
            </div>
        </div>
    )
}

<script>
    import { onPageReady } from "~/utils/page-lifecycle";
    import walineCssUrl from "@waline/client/waline.css?url";
    import walineMetaCssUrl from "@waline/client/waline-meta.css?url";

    // 评论实例懒加载（2026-10-03）：只用到 destroy()，用结构化最小接口
    let walineInstance: { destroy: () => void } | null = null;
    let walineInitializing = false;
    let commentDrawer: { toggle: () => void; reset: () => void } | null = null;

    // Waline 样式改为点击展开时注入（Astro 会把脚本里 import 的 CSS 静态挂到页面，
    // 用 ?url 拿资源地址、运行时按需插入 <link>，避免文章页白载 36KB 评论样式）
    const injectedStyles = new Set<string>();
    function ensureStylesheet(href: string): Promise<void> {
        if (!href || injectedStyles.has(href)) return Promise.resolve();
        injectedStyles.add(href);
        return new Promise((resolve) => {
            const link = document.createElement("link");
            link.rel = "stylesheet";
            link.href = href;
            link.onload = () => resolve();
            link.onerror = () => resolve();
            document.head.appendChild(link);
        });
    }

    const toggleLabels: Record<string, { show: string; hide: string }> = {
        zh: { show: "展开评论", hide: "收起评论" },
        en: { show: "Show Comments", hide: "Hide Comments" },
    };

    function getWalineLocale(): string {
        const wrapper = document.getElementById("comment-wrapper");
        return wrapper?.dataset.walineLocale || "zh";
    }

    async function doInitWaline() {
        if (walineInitializing || walineInstance) return;
        // 配置在这里才取（M8-9）：`~/config` 静态 import 会把整份站点配置
        // （含 feature 表，共 4.1KB gz）拖进每个含评论区的页面首屏，而它只在
        // 真正初始化评论时被读一次。动态 import 不改变任何取值语义。
        const { waline } = await import("~/config");
        const walineElement = document.getElementById("waline");
        if (!waline.enable || !walineElement) {
            console.error("Required elements or configuration are missing.");
            return;
        }

        walineInitializing = true;
        try {
            // 文案表单独成 chunk：初始脚本只留 show/hide 两个按钮文案，省约 1 KB gzip。
            const { walineLocales } = await import("~/scripts/waline-i18n");
            // 懒加载：客户端 JS + 样式均在首次展开评论时才加载
            const [{ init }] = await Promise.all([
                import("@waline/client"),
                ensureStylesheet(walineCssUrl),
                ensureStylesheet(walineMetaCssUrl),
            ]);
            const loc = getWalineLocale();
            const locale = walineLocales[loc] || walineLocales.zh;

            const origin = waline.serverUrl;
            const walineConfig = {
                el: "#waline",
                serverURL: origin,
                comment: true,
                locale,
                path: walineElement.dataset.walinePath!,
                lang: waline.lang,
                pageSize: waline.pageSize,
                // 浏览量由 ~/utils/waline-pageview 单独上报（避免懒初始化丢计数/双计数）
                meta: ["nick", "mail", "link"],
                requiredMeta: ["nick", "mail"],
                login: "disable",
                search: waline.search,
                dark: 'html[data-theme="dark"]',
                emoji: [
                    "https://cdn.jsdelivr.net/npm/@waline/emojis@1.4.0/qq",
                    "https://cdn.jsdelivr.net/npm/@waline/emojis@1.4.0/bilibili",
                    "https://cdn.jsdelivr.net/npm/@waline/emojis@1.4.0/tieba",
                    "https://cdn.jsdelivr.net/npm/@waline/emojis@1.4.0/weibo",
                ],
                wordLimit: [0, 1000],
                reaction: true as boolean | string[],
                codeSyntaxHighlight: true,
                imageUploader: () => {
                    console.warn("Waline 图片上传功能暂未开放");
                    return Promise.reject(new Error("图片上传功能暂未开放"));
                },
            };

            if (waline.whiteList.includes(location.pathname)) {
                walineConfig.reaction =
                    typeof waline.reaction === "boolean" && waline.reaction === true
                        ? []
                        : (waline.reaction as string[]);
            }

            // 注：入口守卫（上方 walineInitializing || walineInstance 判断）已保证此处实例必为空，
            // 旧的「销毁旧实例」防御分支为死代码（TS 亦报 never），2026-10 审计中移除。
            walineInstance = init(walineConfig);
        } finally {
            walineInitializing = false;
        }
    }

    function destroyWaline() {
        if (walineInstance) {
            try {
                walineInstance.destroy();
            } catch {
                // 忽略 AbortError
            }
            walineInstance = null;
        }
    }

    // ── M7-2a：移动评论抽屉（≤640）。桌面走原来的内联展开，一行行为不变 ──
    const MOBILE_QUERY = "(max-width: 640px)";

    function isMobileDrawer() {
        return window.matchMedia(MOBILE_QUERY).matches;
    }

    // 按钮文案 / active / aria-expanded / #waline.visible 统一由这里同步，
    // 避免「抽屉关了但按钮还写着收起评论」这类半截状态。
    function syncCommentUi(visible: boolean) {
        const toggle = document.getElementById("waline-toggle");
        const walineEl = document.getElementById("waline");
        if (!toggle || !walineEl) return;
        const labels = toggleLabels[getWalineLocale()] || toggleLabels.zh;
        walineEl.classList.toggle("visible", visible);
        toggle.classList.toggle("active", visible);
        toggle.textContent = visible ? labels.hide : labels.show;
        toggle.setAttribute("aria-expanded", String(visible));
    }

    async function getCommentDrawer() {
        if (commentDrawer) return commentDrawer;
        const { initCommentDrawer } = await import("~/scripts/comment-drawer");
        commentDrawer = initCommentDrawer({
            onShow: () => {
                syncCommentUi(true);
                if (!walineInstance) {
                    requestAnimationFrame(() => {
                        doInitWaline();
                    });
                }
            },
            onHide: () => syncCommentUi(false),
        });
        return commentDrawer;
    }

    function setupWalineToggle() {
        const toggle = document.getElementById("waline-toggle");
        const walineEl = document.getElementById("waline");
        if (!toggle || !walineEl) return;

        if (toggle.dataset.walineReady) return;
        toggle.dataset.walineReady = "true";

        toggle.addEventListener("click", () => {
            // 移动：按钮 = 打开抽屉；桌面：按钮 = 原地展开（原行为）
            if (isMobileDrawer()) {
                void getCommentDrawer().then((drawer) => drawer?.toggle());
                return;
            }

            if (walineInstance) {
                syncCommentUi(!walineEl.classList.contains("visible"));
            } else {
                syncCommentUi(true);
                requestAnimationFrame(() => {
                    doInitWaline();
                });
            }
        });
    }

    // SPA 导航：重置评论 UI（评论区改为点击“展开评论”后才初始化）
    onPageReady(() => {
        const toggle = document.getElementById("waline-toggle");
        const walineEl = document.getElementById("waline");
        if (!toggle || !walineEl) return;

        // 重置 UI 状态（抽屉/内联两种形态都要复位，回填滚动不该跨页生效）
        commentDrawer?.reset();
        commentDrawer = null;
        const drawer = document.getElementById("waline-drawer");
        if (drawer) {
            drawer.dataset.state = "closed";
            drawer.removeAttribute("role");
            drawer.removeAttribute("aria-modal");
            drawer.removeAttribute("aria-labelledby");
        }
        document.documentElement.classList.remove("comment-drawer-open");
        syncCommentUi(false);
        toggle.style.display = "";

        setupWalineToggle();
    });

    // View Transitions 切换前清理，避免 AbortError
    document.addEventListener("astro:before-swap", () => {
        commentDrawer?.reset();
        commentDrawer = null;
        destroyWaline();
    });

    // 页面卸载时清理
    window.addEventListener("beforeunload", () => {
        destroyWaline();
    });

    // 首次加载：仅挂载按钮；评论实例在首次点击“展开评论”时懒加载
    setupWalineToggle();
</script>
