---
/**
 * EssayItem —— 随笔卡片（P-06 · M2-6b）
 *
 * 只渲染 adapter 归一化后的 `TalkEntry`：本组件不读数据源、不做状态判定。
 * 颜色全部来自 tokens；间距/字号走 --space-* / --text-*；样式在本文件作用域内。
 *
 * a11y：
 * - 头像是装饰（作者名紧邻），alt=""；时间用 <time datetime>，只有解析成功时才带。
 * - 原文入口是新标签页外链，rel=noopener noreferrer；可读名称由 aria-label 承担。
 * - 配图带 width/height（防 CLS）与逐张 alt（内容图，不是装饰）。
 */
import { Image } from "astro:assets";
import Icon from "~/components/UI/atom/Icon.astro";
import type { TalkEntry } from "~/data/adapters/talks";
import type { Locale } from "~/utils/i18n";

interface Props {
    item: TalkEntry;
    /** 作者名（站点配置注入，组件不写死任何人名）。 */
    author: string;
    /** 头像 URL（站点注入）。 */
    avatar: string;
    locale?: Locale;
}

const { item, author, avatar, locale = "zh" } = Astro.props;
const isEn = locale === "en";

const dateLabel =
    item.ts === null
        ? item.time
        : new Intl.DateTimeFormat(isEn ? "en-US" : "zh-CN", {
              year: "numeric",
              month: "short",
              day: "numeric",
          }).format(new Date(item.ts));

const imageAlt = (index: number) =>
    isEn ? `${author} - talk photo ${index + 1}` : `${author} 的随笔配图 ${index + 1}`;
---

<article class="essay-card" data-talk-id={item.id}>
    <header class="essay-card__head">
        <img
            class="essay-card__avatar"
            src={avatar}
            alt=""
            width="40"
            height="40"
            loading="lazy"
            decoding="async"
        />
        <div class="essay-card__meta">
            <span class="essay-card__author">{author}</span>
            {
                dateLabel && (
                    <time
                        class="essay-card__time"
                        datetime={item.ts === null ? undefined : item.time}
                    >
                        {dateLabel}
                    </time>
                )
            }
        </div>
        {
            item.url && (
                <a
                    class="essay-card__source"
                    href={item.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={isEn ? "Open this talk on the source" : "在原文站点打开这条随笔"}
                >
                    <Icon name="tabler:arrow-up-right" size="xs" />
                </a>
            )
        }
    </header>

    {
        item.tags.length > 0 && (
            <ul class="essay-card__tags" role="list">
                {item.tags.map((tag) => (
                    <li class="essay-card__tag">#{tag}</li>
                ))}
            </ul>
        )
    }

    <p class="essay-card__text" set:text={item.text} />

    {
        item.images.length > 0 && (
            <div class="essay-card__images" data-count={Math.min(item.images.length, 4)}>
                {item.images.map((image, index) => (
                    <Image
                        src={image}
                        alt={imageAlt(index)}
                        width={320}
                        height={320}
                        class="essay-card__image"
                        loading="lazy"
                        decoding="async"
                    />
                ))}
            </div>
        )
    }
</article>

<style>
    .essay-card {
        display: flex;
        flex-direction: column;
        gap: var(--space-3);
        box-sizing: border-box;
        padding: var(--space-5);
        border: 1px solid var(--color-border-subtle);
        border-radius: var(--radius-lg);
        background-color: var(--color-bg-surface);
        box-shadow: var(--shadow-1);
    }

    .essay-card__head {
        display: flex;
        align-items: center;
        gap: var(--space-3);
    }

    .essay-card__avatar {
        inline-size: var(--space-10);
        block-size: var(--space-10);
        border-radius: var(--radius-pill);
        object-fit: cover;
        flex: none;
        background-color: var(--color-bg-muted);
    }

    .essay-card__meta {
        display: flex;
        flex-direction: column;
        gap: var(--space-1);
        min-inline-size: 0;
        flex: 1;
    }

    .essay-card__author {
        font-family: var(--font-sans);
        font-size: var(--text-sm);
        font-weight: var(--font-weight-semibold);
        color: var(--color-fg-heading);
        line-height: var(--leading-tight);
    }

    .essay-card__time {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        letter-spacing: var(--tracking-wide);
        color: var(--color-fg-muted);
        line-height: var(--leading-none);
    }

    .essay-card__source {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex: none;
        inline-size: var(--space-8);
        block-size: var(--space-8);
        border: 1px solid var(--color-border-subtle);
        border-radius: var(--radius-pill);
        color: var(--color-fg-muted);
        text-decoration: none;
        transition:
            color var(--duration-fast) var(--ease-standard),
            border-color var(--duration-fast) var(--ease-standard);
    }

    @media (hover: hover) {
        .essay-card__source:hover {
            color: var(--color-fg-link);
            border-color: var(--color-border-accent);
        }
    }

    .essay-card__source:focus-visible {
        outline: 2px solid var(--color-ring-focus);
        outline-offset: 2px;
    }

    .essay-card__tags {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-2);
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .essay-card__tag {
        padding-inline: var(--space-2);
        padding-block: var(--space-1);
        border: 1px solid var(--color-border-subtle);
        border-radius: var(--radius-pill);
        background-color: var(--color-bg-muted);
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        line-height: var(--leading-none);
        color: var(--color-fg-default);
    }

    .essay-card__text {
        margin: 0;
        font-family: var(--font-sans);
        font-size: var(--text-base);
        line-height: var(--leading-normal);
        color: var(--color-fg-default);
        white-space: pre-wrap;
        overflow-wrap: anywhere;
    }

    .essay-card__images {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: var(--space-2);
        max-inline-size: 36rem;
    }

    .essay-card__images[data-count="1"] {
        grid-template-columns: minmax(0, 1fr);
    }

    .essay-card__images[data-count="3"],
    .essay-card__images[data-count="4"] {
        grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .essay-card__image {
        inline-size: 100%;
        block-size: auto;
        aspect-ratio: 1;
        object-fit: cover;
        border-radius: var(--radius-sm);
        border: 1px solid var(--color-border-subtle);
        background-color: var(--color-bg-muted);
    }

    @media (max-width: 640px) {
        .essay-card {
            padding: var(--space-4);
        }

        .essay-card__images[data-count="3"],
        .essay-card__images[data-count="4"] {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .essay-card__source {
            transition: none;
        }
    }
</style>
