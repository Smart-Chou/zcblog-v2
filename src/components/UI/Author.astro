---
import { Image } from "astro:assets";
import authorImg from "~/assets/logo.svg";
import DynamicIcon from "~/components/Icons/DynamicIcon.astro";
import { author, categories, socialLinks, site } from "~/config";

// 作者一句话简介：取站点描述的第二句，避免与 hero slogan 重复
const bioParts = site.description
    .split("。")
    .map((s) => s.trim())
    .filter(Boolean);
const authorBio = bioParts[1] ? `${bioParts[1]}。` : site.subtitle;
---

<div class="author">
    <Image
        src={authorImg}
        alt="Author"
        class="author-image"
        width={90}
        height={90}
        loading="eager"
        fetchpriority="high"
        decoding="async"
    />
    <p class="author-site-title">{author.type}</p>
    <p class="author-intro">{authorBio}</p>
    <p class="author-links">
        {
            categories.map((categorie) => (
                <a
                    href={
                        /^(https?:)?\/\//.test(categorie.url)
                            ? categorie.url
                            : `${Astro.url.pathname.startsWith("/en/") ? "/en" : ""}${categorie.url}`
                    }
                    title={categorie.title}
                    rel="noopener noreferrer"
                    class="has-tooltip"
                    style={categorie.style}
                    aria-label={categorie.title}
                >
                    <DynamicIcon name={categorie.svg} />
                </a>
            ))
        }
    </p>
    <p class="author-links">
        {
            socialLinks.map((social) => (
                <a
                    data-key={`social-${social.title}`}
                    href={social.url}
                    target="_blank"
                    title={social.title}
                    rel="noopener noreferrer"
                    class="has-tooltip"
                    style={social.style}
                    aria-label={social.title}
                >
                    <DynamicIcon name={social.svg} />
                </a>
            ))
        }
    </p>
</div>

<!-- 样式已移到 src/styles/article.css（D-0085：并入全局样式链，避免文章页单独拉一份 CSS） -->

<style>
    /* 命中区下限（WCAG 2.2 2.5.8 / axe target-size ≥ 24px）。
       Author 的观感样式在全局 article.css，但 /design/components/* 的文档页不加载那张表，
       示例区的图标链接会退化成 14×17 的裸 <a>（axe serious）。这里只兜尺寸，并且用 :where()
       把优先级压到 0 —— 加载了 article.css 的页面仍用它的 34px，两处取值不打架。 */
    :where(.author-links a) {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 24px;
        min-height: 24px;
    }
</style>
