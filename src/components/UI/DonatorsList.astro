---
/**
 * DonatorsList —— 赞赏者名单（P-07 · M2-6b）
 *
 * 只渲染 adapter 归一化后的 `Donator[]`（名字必填、金额已校验、日期已归一）。
 * 设计取舍（相对旧版）：
 * - 日期不再「只在 hover 时显示」：hover 才可见的信息在触摸/键盘下等于不存在。
 * - 头像没有就渲染首字，不请求占位图；有头像时 alt=""（名字紧邻）。
 * - 金额为 0 表示「心意已收、未记账」，此时不渲染 ¥0.00。
 */
import type { Donator } from "~/data/adapters/donate";
import type { Locale } from "~/utils/i18n";

interface Props {
    donators: Donator[];
    /** 币种符号（adapter 给，缺省 ¥）。 */
    currency?: string;
    locale?: Locale;
}

const { donators, currency = "¥", locale = "zh" } = Astro.props;
const isEn = locale === "en";

const formatAmount = (amount: number) =>
    Number.isInteger(amount) ? String(amount) : amount.toFixed(2);

const formatDate = (date: string) => {
    if (!date) return "";
    const parsed = new Date(`${date}T00:00:00`);
    if (Number.isNaN(parsed.getTime())) return date;
    return new Intl.DateTimeFormat(isEn ? "en-US" : "zh-CN", {
        year: "numeric",
        month: "short",
        day: "numeric",
    }).format(parsed);
};
---

<ul class="donators" role="list">
    {
        donators.map((donator) => (
            <li class="donator">
                <span class="donator__avatar" aria-hidden="true">
                    {donator.avatar ? (
                        <img
                            src={donator.avatar}
                            alt=""
                            width="44"
                            height="44"
                            loading="lazy"
                            decoding="async"
                        />
                    ) : (
                        <span class="donator__initial">{donator.name.slice(0, 2)}</span>
                    )}
                </span>
                <div class="donator__body">
                    <div class="donator__top">
                        <span class="donator__name">{donator.name}</span>
                        {donator.amount > 0 && (
                            <span class="donator__amount">
                                {currency}
                                {formatAmount(donator.amount)}
                            </span>
                        )}
                    </div>
                    {donator.message && <p class="donator__message">{donator.message}</p>}
                    {donator.date && (
                        <time class="donator__date" datetime={donator.date}>
                            {formatDate(donator.date)}
                        </time>
                    )}
                </div>
            </li>
        ))
    }
</ul>

<style>
    .donators {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
        gap: var(--space-4);
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .donator {
        display: flex;
        align-items: flex-start;
        gap: var(--space-3);
        box-sizing: border-box;
        padding: var(--space-4);
        border: 1px solid var(--color-border-subtle);
        border-radius: var(--radius-lg);
        background-color: var(--color-bg-surface);
    }

    .donator__avatar {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex: none;
        inline-size: var(--space-11);
        block-size: var(--space-11);
        border-radius: var(--radius-pill);
        overflow: hidden;
        background-color: var(--color-accent-subtle);
        /* 首字压在 accent-subtle 上：--color-fg-link 在暗色只有 3.52，改用默认前景色 */
        color: var(--color-fg-default);
        font-family: var(--font-serif);
        font-size: var(--text-lg);
        font-weight: var(--font-weight-semibold);
    }

    .donator__avatar img {
        inline-size: 100%;
        block-size: 100%;
        object-fit: cover;
    }

    .donator__body {
        display: flex;
        flex-direction: column;
        gap: var(--space-1);
        min-inline-size: 0;
        flex: 1;
    }

    .donator__top {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: var(--space-2);
    }

    .donator__name {
        font-family: var(--font-sans);
        font-size: var(--text-base);
        font-weight: var(--font-weight-semibold);
        color: var(--color-fg-heading);
        overflow-wrap: anywhere;
    }

    .donator__amount {
        flex: none;
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        font-weight: var(--font-weight-medium);
        color: var(--color-fg-link);
        font-variant-numeric: tabular-nums;
    }

    .donator__message {
        margin: 0;
        font-size: var(--text-sm);
        line-height: var(--leading-snug);
        color: var(--color-fg-default);
        overflow-wrap: anywhere;
    }

    .donator__date {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        color: var(--color-fg-muted);
        letter-spacing: var(--tracking-wide);
    }
</style>
