---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
    href: string;
    image?: ImageMetadata | string;
    dataSrc?: string;
    alt: string;
    aspectRatio?: string;
    placeholderEmoji?: string;
    target?: string;
    rel?: string;
    class?: string;
    /**
     * 表面语言（M6-1，可选）。默认不传 = 与 M6-1 之前逐字节一致的输出。
     * - `media`（默认）：卡片自带表面（圆角 + 阴影），用于独立摆放的媒体卡。
     * - `plain`：不画自己的表面，交给外层卡片/列表行。
     */
    variant?: "media" | "plain";
    /** 齐平网格（M6-1，可选）：去圆角/阴影，图片铺满格子（相册 3 列 flush 用）。 */
    flush?: boolean;
    "data-tags"?: string;
}

const {
    href,
    image,
    dataSrc,
    alt,
    aspectRatio = "2/3",
    placeholderEmoji = "📷",
    target,
    rel,
    class: className,
    variant,
    flush = false,
    ...rest
} = Astro.props;
---

<a
    href={href}
    class:list={[
        "media-card",
        {
            "media-card--plain": variant === "plain",
            "media-card--flush": flush,
        },
        className,
    ]}
    target={target}
    rel={rel}
    {...rest}
>
    <div class="media-cover" style={`aspect-ratio: ${aspectRatio}`}>
        {
            image ? (
                typeof image === "string" ? (
                    <img src={image} alt={alt} class="cover-img" loading="lazy" decoding="async" />
                ) : (
                    <Image src={image} alt={alt} class="cover-img" />
                )
            ) : dataSrc ? (
                <img
                    data-src={dataSrc}
                    alt={alt}
                    class="cover-img"
                    loading="lazy"
                    decoding="async"
                />
            ) : (
                <div class="cover-placeholder">{placeholderEmoji}</div>
            )
        }
        <slot name="badges" />
        <div class="media-overlay">
            <slot name="overlay" />
        </div>
    </div>
</a>

<style>
    .media-card {
        display: block;
        text-decoration: none;
        border-radius: var(--shell-radius-xl);
        overflow: hidden;
        background: var(--shell-surface);
        box-shadow: var(--shadow-1, var(--shadow-sm));
        transition:
            transform var(--duration-slow) var(--ease-out),
            box-shadow var(--duration-slow) var(--ease-out),
            border-color var(--duration-slow) var(--ease-out);
    }

    @media (hover: hover) {
        .media-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-4, var(--shadow-xl));
        }
    }

    /* variant="plain"：表面交给外层 */
    .media-card--plain {
        background: transparent;
        box-shadow: none;
    }

    @media (hover: hover) {
        .media-card--plain:hover {
            transform: none;
            box-shadow: none;
        }
    }

    /* flush：网格齐平，圆角/阴影全部撤掉 */
    .media-card--flush {
        border-radius: 0;
        box-shadow: none;
    }

    @media (hover: hover) {
        .media-card--flush:hover {
            transform: none;
            box-shadow: none;
        }
    }

    .media-cover {
        position: relative;
        overflow: hidden;
    }

    .media-card--flush .media-cover {
        border-radius: var(--shell-radius-md);
    }

    .cover-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform var(--duration-slow) var(--ease-out);
    }

    @media (hover: hover) {
        .media-card:hover .cover-img {
            transform: scale(1.05);
        }
    }

    .media-card--flush:hover .cover-img {
        transform: scale(1.02);
    }

    .cover-placeholder {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--shell-sunken, #f0f0f0);
        font-size: 3rem;
    }

    .media-overlay {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        padding: 12px;
        background: linear-gradient(transparent, rgba(0, 0, 0, 0.8));
        color: white;
    }
</style>
