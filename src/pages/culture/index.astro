---
/**
 * C-2 文化聚合（M2-9，中文路由）
 * ------------------------------------------------------------------
 * 这一页只做一件事：把「已经存在的」三个收藏页摆成一个入口目录。
 * 它不是第四个数据源，也不搬子页正文 —— 番剧 / 豆瓣 / 歌单的正文仍在原路由，
 * 这里只给路标（刻意不做 301：旧地址就是正文地址，搬了反而断外链）。
 *
 * 三条判据（本卡核心，e2e 逐条断言）：
 * 1. **缺实体则不渲染**：条目数为 0、数据形状不合法（bangumi/douban 静态 JSON
 *    没通过形状探针、music 实体没过 normalizeCollection）时，那张卡整张不出现，
 *    而不是渲染一张「0 条」的空卡。
 * 2. **只链接已存在的路由**：`routeExists()` 直接查 `src/pages/<href>/index.astro`
 *    是否真的在仓库里；目标页被删了，入口自己就消失，不会留下通向 404 的链接。
 *    英文页查 `/en/...`，因为中英是两套文件。
 * 3. **计数只有一个出处**：条数 / 分类构成 / 年份跨度全部由本文件从数据算好，
 *    卡片只负责排版；歌单与豆瓣音乐的同源 4 条在这里去重，页面因此敢同时报
 *    「原始 45 / 去重后 41」两个数。
 *
 * 构建期开关（只用于验收与截图，不改数据）：
 *   PUBLIC_CULTURE_OMIT=music,douban   按 id 剔除来源（模拟「缺实体」）
 *   PUBLIC_CULTURE_STATE=empty         三个来源全剔除（走空态）
 */
import { existsSync } from "node:fs";
import path from "node:path";

import "~/styles/tokens/tokens.css";
import "~/styles/pages/entities.css";
import "~/styles/pages/culture.css";

import BaseLayout from "~/layouts/BaseLayout.astro";
import PageHero from "~/components/UI/molecule/PageHero.astro";
import SectionHead from "~/components/UI/atom/SectionHead.astro";
import DataState from "~/components/UI/molecule/DataState.astro";
import CultureGrid from "~/components/Culture/CultureGrid.astro";
import CultureRail from "~/components/Culture/CultureRail.astro";
import CultureHeatmap from "~/components/Culture/CultureHeatmap.astro";
import type { CultureMedia } from "~/components/Culture/CultureItemCard.astro";
import type { CultureEntry, CultureStat } from "~/components/Culture/CultureCard.astro";
import { site } from "~/config";
import bangumiJson from "~/data/bangumi.json";
import doubanJson from "~/data/douban.json";
import { music, musicMeta } from "~/data/entities/music";
import { musicArtistCount, musicSpec, musicYearSpan, normalizeCollection } from "~/types/entities";
import { getLocale, t } from "~/utils/i18n";

const loc = getLocale(Astro.currentLocale || "zh");
const isEn = loc === "en";

/* ───────────────────── 1. 路由探针 ─────────────────────────── */

/** 只认真实的页面文件：`/music/` → `src/pages/music/index.astro`。 */
const PAGES_ROOT = path.resolve(process.cwd(), "src/pages");
const routeExists = (href: string): boolean =>
    existsSync(path.join(PAGES_ROOT, href.replace(/^\/+|\/+$/g, ""), "index.astro"));

/* ───────────────────── 2. 三个来源的实体探针 ───────────────── */

/** bangumi.json 的形状（只取本页要用的两栏）。 */
interface BangumiItem {
    updated_at?: string;
    subject?: { date?: string };
}

/** douban.json 的形状（只取本页要用的三栏）。 */
interface DoubanItem {
    title?: string;
    url?: string;
    type?: string;
    date?: string;
    rating?: number;
    status?: string;
}

const BANGUMI_KEYS = ["anime", "book", "music", "game", "tv"] as const;
const bangumiRaw = bangumiJson as unknown as Record<string, BangumiItem[] | undefined>;
const bangumiGroups = BANGUMI_KEYS.map((key) => ({
    key,
    label: t(loc, `bangumi.categories.${key}`),
    items: Array.isArray(bangumiRaw[key]) ? (bangumiRaw[key] as BangumiItem[]) : [],
})).filter((group) => group.items.length > 0);
const bangumiTotal = bangumiGroups.reduce((sum, group) => sum + group.items.length, 0);
const bangumiYears = bangumiGroups
    .flatMap((group) => group.items.map((item) => item.subject?.date ?? ""))
    .filter((date) => /^\d{4}/.test(date))
    .map((date) => date.slice(0, 4))
    .sort();
const bangumiFirst = bangumiYears.at(0);
const bangumiLast = bangumiYears.at(-1);
const bangumiSpan =
    bangumiFirst && bangumiLast
        ? bangumiFirst === bangumiLast
            ? bangumiFirst
            : `${bangumiFirst}–${bangumiLast}`
        : "";
const bangumiSnapshot = bangumiGroups
    .flatMap((group) => group.items.map((item) => (item.updated_at ?? "").slice(0, 10)))
    .filter(Boolean)
    .sort()
    .at(-1);

const DOUBAN_TYPES = ["book", "movie", "music"] as const;
const doubanItems: DoubanItem[] = Array.isArray(doubanJson) ? (doubanJson as DoubanItem[]) : [];
const doubanGroups = DOUBAN_TYPES.map((type) => ({
    type,
    label: t(loc, `douban.tabs.${type}`),
    items: doubanItems.filter((item) => item.type === type),
})).filter((group) => group.items.length > 0);
const doubanTotal = doubanGroups.reduce((sum, group) => sum + group.items.length, 0);
const doubanSnapshot =
    doubanItems
        .map((item) => (item.date ?? "").slice(0, 10))
        .filter(Boolean)
        .sort()
        .at(-1) ?? "";

/** 歌单走实体契约：形状不合法 = 没有实体 = 入口不渲染（不是「0 条的空卡」）。 */
const musicFeed = normalizeCollection(music, musicMeta, musicSpec, {});
const musicTracks = musicFeed.status === "ok" ? musicFeed.items : [];
const musicSingles = musicTracks.filter((track) => track.format === "single").length;
const musicAlbums = musicTracks.filter((track) => track.format === "album").length;

/* ───────────────────── 3. 同源去重 ─────────────────────────── */

/** 豆瓣条目 id：`https://music.douban.com/subject/5064190/` → `5064190`。 */
const doubanSubjectId = (url: string | undefined): string => {
    const match = /subject\/(\d+)/.exec(url ?? "");
    return match ? match[1] : "";
};
const doubanSubjectIds = new Set(
    doubanItems.map((item) => doubanSubjectId(item.url)).filter(Boolean),
);
const musicSharedTracks = musicTracks.filter((track) =>
    (track.links ?? []).some((link) => doubanSubjectIds.has(doubanSubjectId(link.href))),
);

/* ───────────────────── 4. 三个入口的候选 ───────────────────── */

type Candidate = Omit<CultureEntry, "index">;

const bangumiLabels = bangumiGroups.map((group) => group.label).join(isEn ? ", " : "、");
const bangumiNote = isEn
    ? `An export of my Bangumi account, split into ${bangumiLabels}${bangumiSnapshot ? ` (snapshot ${bangumiSnapshot})` : ""}.`
    : `Bangumi 账号导出的收藏，按${bangumiLabels}分栏${bangumiSnapshot ? `（${bangumiSnapshot} 快照）` : ""}。`;

const doubanLabels = doubanGroups.map((group) => group.label).join(isEn ? ", " : "、");
const doubanNote = isEn
    ? `${doubanLabels} recorded on Douban: rating, status and a link to each subject${doubanSnapshot ? ` (${doubanSnapshot} snapshot)` : ""}.`
    : `豆瓣上的${doubanLabels}记录：评分、状态与条目链接${doubanSnapshot ? `（${doubanSnapshot} 快照）` : ""}。`;

const musicNote = isEn
    ? `${musicTracks.length} records picked out of the Douban music list into their own playlist — links out, no hosted audio.`
    : `从豆瓣音乐里挑出的 ${musicTracks.length} 张，独立成一页歌单 —— 有外链，不托管音频。`;

const stat = (label: string, value: string): CultureStat => ({ label, value });

const candidates: Candidate[] = [
    {
        id: "bangumi",
        href: isEn ? "/en/bangumi/" : "/bangumi/",
        count: bangumiTotal,
        kicker: isEn ? "BANGUMI · ACCOUNT EXPORT" : "BANGUMI · 账号导出",
        title: isEn ? "Bangumi" : "番剧",
        note: bangumiNote,
        stats: [
            stat(isEn ? "records" : "记录", String(bangumiTotal)),
            stat(isEn ? "categories" : "分类", String(bangumiGroups.length)),
            stat(isEn ? "years" : "年份", bangumiSpan),
        ],
        breakdown: bangumiGroups.map((group) => `${group.label} ${group.items.length}`),
    },
    {
        id: "douban",
        href: isEn ? "/en/douban/" : "/douban/",
        count: doubanTotal,
        kicker: isEn ? "DOUBAN · FETCHED SNAPSHOT" : "DOUBAN · 抓取快照",
        title: isEn ? "Douban" : "豆瓣书影音",
        note: doubanNote,
        stats: [
            stat(isEn ? "records" : "记录", String(doubanTotal)),
            stat(isEn ? "categories" : "分类", String(doubanGroups.length)),
            stat(isEn ? "snapshot" : "快照", doubanSnapshot),
        ],
        breakdown: doubanGroups.map((group) => `${group.label} ${group.items.length}`),
    },
    {
        id: "music",
        href: isEn ? "/en/music/" : "/music/",
        count: musicTracks.length,
        kicker: isEn ? "DOUBAN MUSIC · HAND-PICKED" : "DOUBAN MUSIC · 人工挑选",
        title: isEn ? "Playlist" : "歌单",
        note: musicNote,
        stats: [
            stat(isEn ? "works" : "作品", String(musicTracks.length)),
            stat(isEn ? "artists" : "主艺人", String(musicArtistCount(musicTracks))),
            stat(isEn ? "years" : "年份", musicYearSpan(musicTracks)),
        ],
        breakdown: [
            ...(musicSingles > 0 ? [`${isEn ? "Singles" : "单曲"} ${musicSingles}`] : []),
            ...(musicAlbums > 0 ? [`${isEn ? "Albums" : "专辑"} ${musicAlbums}`] : []),
        ],
    },
];

/* ───────────────────── 5. 条件渲染 ─────────────────────────── */

const CULTURE_IDS = ["bangumi", "douban", "music"] as const;

const omitted = new Set(
    String(import.meta.env.PUBLIC_CULTURE_OMIT ?? "")
        .split(",")
        .map((value) => value.trim())
        .filter(Boolean),
);
const forcedEmpty = import.meta.env.PUBLIC_CULTURE_STATE === "empty";
const hidden = new Set<string>(forcedEmpty ? [...CULTURE_IDS] : [...omitted]);

const entries: CultureEntry[] = candidates
    .filter((entry) => entry.count > 0 && !hidden.has(entry.id) && routeExists(entry.href))
    .map((entry, index) => ({ ...entry, index: String(index + 1).padStart(2, "0") }));

const rawTotal = entries.reduce((sum, entry) => sum + entry.count, 0);
const showsMusic = entries.some((entry) => entry.id === "music");
const showsDouban = entries.some((entry) => entry.id === "douban");
/** 只有在两张卡都在场时才谈得上「同源」；缺一张就无从比对，不去编一个数。 */
const overlap = showsMusic && showsDouban ? musicSharedTracks.length : 0;
const uniqueTotal = rawTotal - overlap;

/* ───────────────────── 6. 文案 ─────────────────────────────── */

const ledeBase = isEn
    ? "Anime, Douban books-and-screens, and the playlist — three entries pointing at three pages that already exist. If a source has no data, or its page is gone, its entry simply isn't here: this page only lists places you can actually go."
    : "番剧、豆瓣书影音、歌单 —— 三个入口，指向站里已经存在的三页。哪个来源没有数据、或者那一页不在了，这里就不会出现它的入口：这一页只列真的能进去的地方。";

const ledeDedupe =
    overlap > 0
        ? isEn
            ? `${rawTotal} records counted; ${overlap} of them are the playlist and Douban music seeing the same entry twice, so ${uniqueTotal} unique.`
            : `数下来 ${rawTotal} 条，其中 ${overlap} 条是歌单与豆瓣音乐的同一条记录，去重后 ${uniqueTotal} 条。`
        : "";

/** 顺序说明只列真的在页面上的入口：缺了一个来源时，别在标题旁边点它的名。 */
const orderLabel = entries.map((entry) => entry.title).join(" → ");

/* ───────────────────── 7. 文化生活四段轨（M8-6-2） ─────────── */

/**
 * 四段轨只吃真实字段：标题 / 年份 / 集数或卷数 / 我的评分 / 分类标签。
 * **没有**观看进度：bangumi 的 `ep_status` 全库为 0，稿子上的「Ep 09 / 12」「75%」
 * 在数据里不存在，画出来就是造假（G-07）。缺字段就少一行，不补 0。
 */
interface BangumiSubject {
    id?: number;
    date?: string | null;
    name?: string;
    name_cn?: string;
    eps?: number;
    volumes?: number;
}

interface BangumiCollection {
    rate?: number;
    tags?: string[];
    subject?: BangumiSubject;
}

const bgmCollection = bangumiJson as unknown as Record<string, BangumiCollection[] | undefined>;
const bgmHref = (id: number | undefined) => (id ? `https://bgm.tv/subject/${id}` : "");
const yearOf = (value?: string | null) =>
    /^\d{4}/.test(value ?? "") ? String(value).slice(0, 4) : "";

const pickTag = (tags?: string[]) => (tags ?? []).find((tag) => tag.trim().length > 0);

const bangumiMedia = (
    key: "anime" | "book" | "tv" | "music",
    unit: "话" | "卷" | "",
): CultureMedia[] =>
    [...(bgmCollection[key] ?? [])]
        .sort((a, b) => (b.rate ?? 0) - (a.rate ?? 0))
        .flatMap((item) => {
            const subject = item.subject ?? {};
            const title = (subject.name_cn || subject.name || "").trim();
            const href = bgmHref(subject.id);
            if (!title || !href) return [];
            const year = yearOf(subject.date);
            const amount = unit === "卷" ? subject.volumes : unit === "话" ? subject.eps : 0;
            const parts = [year, amount && unit ? `${amount} ${unit}` : ""].filter(Boolean);
            return [
                {
                    id: `bgm-${subject.id}`,
                    title,
                    meta:
                        parts.length > 0
                            ? parts.join(" · ")
                            : isEn
                              ? "Year not recorded"
                              : "年份未录",
                    rating:
                        (item.rate ?? 0) > 0
                            ? isEn
                                ? `My rating ${item.rate} / 10`
                                : `我的评分 ${item.rate} / 10`
                            : undefined,
                    tag: pickTag(item.tags),
                    href,
                    source: "Bangumi",
                } satisfies CultureMedia,
            ];
        });

const DOUBAN_STATUS: Record<string, { zh: string; en: string }> = {
    wish: { zh: "想读/想看", en: "wishlist" },
    watching: { zh: "在看", en: "watching" },
    watched: { zh: "看过", en: "watched" },
    listened: { zh: "听过", en: "listened" },
};

const doubanMedia = (type: "book" | "movie" | "music"): CultureMedia[] =>
    doubanItems
        .filter((item) => item.type === type)
        .flatMap((item) => {
            const href = /^https?:\/\//.test(item.url ?? "") ? String(item.url) : "";
            const title = (item.title ?? "").trim();
            if (!title || !href) return [];
            const status = DOUBAN_STATUS[item.status ?? ""];
            const parts = [yearOf(item.date), status ? (isEn ? status.en : status.zh) : ""].filter(
                Boolean,
            );
            return [
                {
                    id: `douban-${doubanSubjectId(href) || title}`,
                    title,
                    meta:
                        parts.length > 0
                            ? parts.join(" · ")
                            : isEn
                              ? "Date not recorded"
                              : "日期未录",
                    rating:
                        (item.rating ?? 0) > 0
                            ? isEn
                                ? `Douban ${item.rating} / 5`
                                : `豆瓣 ${item.rating} / 5`
                            : undefined,
                    tag: isEn ? "Douban" : "豆瓣",
                    href,
                    source: isEn ? "Douban" : "豆瓣",
                } satisfies CultureMedia,
            ];
        });

const musicMedia: CultureMedia[] = musicTracks.flatMap((track) => {
    const href = (track.links ?? []).find((link) => /^https?:\/\//.test(link.href))?.href ?? "";
    if (!href) return [];
    return [
        {
            id: `music-${doubanSubjectId(href) || track.title}`,
            title: track.title,
            meta: [track.artist, track.year].filter(Boolean).join(" · "),
            tag: track.format === "single" ? (isEn ? "Single" : "单曲") : isEn ? "Album" : "专辑",
            href,
            source: isEn ? "Playlist" : "歌单",
        } satisfies CultureMedia,
    ];
});

interface CultureRailData {
    id: string;
    title: string;
    meta: string;
    items: CultureMedia[];
}

const cultureRails: CultureRailData[] = [
    {
        id: "anime",
        title: isEn ? "Anime" : "番剧",
        meta: isEn ? "Bangumi collection · by my rating" : "Bangumi 收藏 · 按我的评分",
        items: bangumiMedia("anime", "话"),
    },
    {
        id: "bookshelf",
        title: isEn ? "Bookshelf" : "书架",
        meta: isEn ? "Bangumi manga + Douban books" : "Bangumi 漫画/小说 + 豆瓣图书",
        items: [...bangumiMedia("book", "卷"), ...doubanMedia("book")],
    },
    {
        id: "cinema",
        title: isEn ? "Cinema" : "电影",
        meta: isEn ? "Douban films + Bangumi series" : "豆瓣影视 + Bangumi 剧集",
        items: [...doubanMedia("movie"), ...bangumiMedia("tv", "话")],
    },
    {
        id: "music",
        title: isEn ? "Music" : "音乐",
        meta: isEn ? "Playlist + Bangumi soundtracks" : "歌单 + Bangumi 原声",
        items: [...musicMedia, ...bangumiMedia("music", "")],
    },
].filter((rail) => rail.items.length > 0);

/* ───────────────────── 8. 豆瓣入账热力图（M8-6-2） ─────────── */

/** 只吃 `douban.json` 的 `date`（入账/抓取时间戳）；**不用** bangumi `updated_at`。 */
const doubanDayCounts = doubanItems.reduce<Record<string, number>>((acc, item) => {
    const day = (item.date ?? "").slice(0, 10);
    if (!/^\d{4}-\d{2}-\d{2}$/.test(day)) return acc;
    acc[day] = (acc[day] ?? 0) + 1;
    return acc;
}, {});
const heatmapDays = Object.entries(doubanDayCounts)
    .map(([date, count]) => ({ date, count }))
    .sort((a, b) => a.date.localeCompare(b.date));
const heatmapYear =
    heatmapDays.length > 0
        ? Number(heatmapDays.at(-1)!.date.slice(0, 4))
        : new Date().getFullYear();
const heatmapActiveDays = heatmapDays.filter((day) => day.count > 0).length;
const heatmapTotal = heatmapDays.reduce((sum, day) => sum + day.count, 0);

const MONTHS_ZH = [
    "1月",
    "2月",
    "3月",
    "4月",
    "5月",
    "6月",
    "7月",
    "8月",
    "9月",
    "10月",
    "11月",
    "12月",
];
const MONTHS_EN = [
    "Jan",
    "Feb",
    "Mar",
    "Apr",
    "May",
    "Jun",
    "Jul",
    "Aug",
    "Sep",
    "Oct",
    "Nov",
    "Dec",
];
const WEEK_ZH = ["周一", "", "周三", "", "周五", "", "周日"];
const WEEK_EN = ["Mon", "", "Wed", "", "Fri", "", "Sun"];

const copy2 = isEn
    ? {
          railKicker: "CULTURAL LIFE · FOUR RAILS",
          railsTitle: "What I'm reading, watching and listening to",
          railsMeta: `Four rails · ${cultureRails.length} with content`,
          heatmapTitle: `Douban entry dates · ${heatmapYear}`,
          heatmapLegendLow: "few",
          heatmapLegendHigh: "many",
          heatmapLegendLabel: "Entry-count scale, light to dark",
          heatmapSummary: `${heatmapTotal} entries on ${heatmapActiveDays} day(s) in ${heatmapYear}.`,
          heatmapFootnote:
              "Only the `date` field of douban.json (the day an entry entered the archive). Bangumi's updated_at is a fetch snapshot, so it is not used here.",
          months: MONTHS_EN,
          weekRows: WEEK_EN,
      }
    : {
          railKicker: "文化生活 · 四段轨",
          railsTitle: "正在追、正在读、正在看、正在听",
          railsMeta: `四段轨 · ${cultureRails.length} 段有内容`,
          heatmapTitle: `豆瓣入账日期 · ${heatmapYear}`,
          heatmapLegendLow: "较少",
          heatmapLegendHigh: "频繁",
          heatmapLegendLabel: "入账条数色阶，由浅到深",
          heatmapSummary: `${heatmapYear} 年累计 ${heatmapActiveDays} 天有入账，共 ${heatmapTotal} 条。`,
          heatmapFootnote:
              "只统计 douban.json 的 date 字段（条目进库的那一天）；bangumi 的 updated_at 是抓取快照，不用来做热力图。",
          months: MONTHS_ZH,
          weekRows: WEEK_ZH,
      };

const copy = isEn
    ? {
          kicker: "CULTURE · COLLECTIONS",
          title: "Culture",
          lede: ledeDedupe ? `${ledeBase} ${ledeDedupe}` : ledeBase,
          listTitle: "Entries",
          listMeta: `Fixed order · ${orderLabel}`,
          entriesLabel: `${entries.length} ${entries.length === 1 ? "entry" : "entries"}`,
          uniqueLabel: `${uniqueTotal} unique records`,
          rawLabel: `${rawTotal} raw · ${overlap} shared`,
          note: "Conditional, not decorative: every count and category is read out of the data files. When a source is empty, malformed, or its target route is not in the repo, the card is not rendered at all — never an entry that leads to a 404.",
          emptyTitle: "None of the three sources has anything to show",
          emptyText:
              "The Bangumi, Douban and playlist data files are all empty, so there are no entries here. The empty state is part of the page: the route still resolves, and entries appear on their own once there is data.",
          breakdownLabel: "Composition",
      }
    : {
          kicker: "CULTURE · 收藏目录",
          title: "文化",
          lede: ledeDedupe ? `${ledeBase} ${ledeDedupe}` : ledeBase,
          listTitle: "入口",
          listMeta: `固定顺序 · ${orderLabel}`,
          entriesLabel: `${entries.length} 个入口`,
          uniqueLabel: `${uniqueTotal} 条记录（去重后）`,
          rawLabel: `${rawTotal} 条原始 · ${overlap} 条同源`,
          note: "条件渲染不是装饰：条目数与分类构成都从数据文件里数出来，某个来源为空、格式不合法、或目标路由不在仓库里时，整张卡不渲染 —— 而不是留一个通向 404 的入口。",
          emptyTitle: "三个来源暂时都没有可展示的记录",
          emptyText:
              "番剧、豆瓣、歌单的数据文件都没数，所以这一页没有入口。空态也是页面的一部分：路由照常可访问，有数据时入口会自己出现。",
          breakdownLabel: "分类构成",
      };
---

<BaseLayout
    locale={loc}
    title={`${copy.title} - ${site.title}`}
    description={ledeBase}
    keywords={["Culture", "文化", "Bangumi", "番剧", "豆瓣", "Douban", "歌单", "Playlist"]}
>
    <article
        class="entities entities--culture"
        data-culture-status={entries.length > 0 ? "ok" : "empty"}
        data-culture-entries={entries.length}
        data-culture-raw={rawTotal}
        data-culture-unique={uniqueTotal}
        data-culture-overlap={overlap}
        data-culture-hidden={[...hidden].join(",")}
        aria-labelledby="culture-title"
    >
        <PageHero
            kicker={copy.kicker}
            title={copy.title}
            lede={copy.lede}
            id="culture-title"
            meta={[
                { icon: "tabler:stack-2", label: copy.entriesLabel },
                { icon: "tabler:circle-check", label: copy.uniqueLabel },
                ...(overlap > 0 ? [{ label: copy.rawLabel, quiet: true }] : []),
            ]}
        />

        <section class="entities-section" aria-labelledby="culture-entries-title">
            <SectionHead id="culture-entries-title" title={copy.listTitle} meta={copy.listMeta} />

            {
                entries.length > 0 ? (
                    <>
                        <CultureGrid entries={entries} breakdownLabel={copy.breakdownLabel} />
                        <p class="culture-note">{copy.note}</p>
                    </>
                ) : (
                    <DataState
                        kind="empty"
                        icon="tabler:library-photo"
                        title={copy.emptyTitle}
                        message={copy.emptyText}
                        class="culture-empty"
                    />
                )
            }
        </section>

        {
            entries.length > 0 && (
                <section class="culture-rails" aria-labelledby="culture-rails-title">
                    <p class="culture-rails__kicker">{copy2.railKicker}</p>
                    <h2 class="culture-rails__title" id="culture-rails-title">
                        {copy2.railsTitle}
                    </h2>
                    <p class="culture-rails__meta">{copy2.railsMeta}</p>
                    <div class="culture-rails__list">
                        {cultureRails.map((rail) => (
                            <CultureRail
                                id={rail.id}
                                title={rail.title}
                                meta={rail.meta}
                                items={rail.items}
                            />
                        ))}
                    </div>
                </section>
            )
        }

        {
            entries.length > 0 && heatmapDays.length > 0 && (
                <CultureHeatmap
                    id="culture-heatmap-title"
                    year={heatmapYear}
                    days={heatmapDays}
                    title={copy2.heatmapTitle}
                    legendLow={copy2.heatmapLegendLow}
                    legendHigh={copy2.heatmapLegendHigh}
                    legendLabel={copy2.heatmapLegendLabel}
                    summary={copy2.heatmapSummary}
                    footnote={copy2.heatmapFootnote}
                    months={copy2.months}
                    weekRows={copy2.weekRows}
                />
            )
        }
    </article>
</BaseLayout>
