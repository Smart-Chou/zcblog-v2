---
/**
 * C-1 游戏（M2-7b；M8-6-1 视觉重做 = 桌面 `gaming_hub_2` / 移动 `gaming_hub_1`）
 * ------------------------------------------------------------------
 * 结构（M8-6-1）：
 *   1. 页头   —— `PageHero`（kicker / h1 `#games-title` / lede / 统计行）
 *   2. 分组   —— `SectionHead`（固定顺序 在玩 → 已通关 → 待玩 → 搁置）+ 卡网格
 *   3. 空/错态 —— `DataState`（error 态内建 Alert warning + mono 原因码）
 *   4. 串流拓扑 —— 只桌面渲染（≤767 隐藏）：节点全部取自设备清单的真实记录
 *
 * 三条诚实性红线：
 *   - 数据只有真实记录：`games.ts` 为空时走**设计内的空态**，不填示例条目、不填 0 小时 / 0 分。
 *   - 卡片无封面字段、无进度分母 → 色块 banner + 时长文本，不渲染 `role="progressbar"`。
 *   - 拓扑不编参数：角色、型号、规格行都来自 `devices.ts`（同一份站点数据），没有就整节点不渲染。
 *
 * 0 客户端 JS：分组顺序、卡片网格、拓扑隐藏全是纯 CSS（列表页 JS 预算 28 KB）。
 * 构建期可用 `PUBLIC_GAMES_STATE=empty|error` 预览另两态（验收/截图用，不改数据文件）。
 */
import "~/styles/tokens/tokens.css";
import "~/styles/pages/entities.css";
import "~/styles/pages/games.css";
import BaseLayout from "~/layouts/BaseLayout.astro";
import PageHero from "~/components/UI/molecule/PageHero.astro";
import SectionHead from "~/components/UI/atom/SectionHead.astro";
import DataState from "~/components/UI/molecule/DataState.astro";
import Icon from "~/components/UI/atom/Icon.astro";
import GameCard from "~/components/C/GameCard.astro";
import { devices } from "~/data/entities/devices";
import { games, gamesMeta } from "~/data/entities/games";
import {
    GAME_STATUS_ORDER,
    formatUpdated,
    gameSpec,
    gameStatusLabel,
    normalizeCollection,
} from "~/types/entities";
import { getLocale } from "~/utils/i18n";
import { site } from "~/config";

const loc = getLocale(Astro.currentLocale || "zh");
const isEn = loc === "en";

const feed = normalizeCollection(games, gamesMeta, gameSpec, {
    force: import.meta.env.PUBLIC_GAMES_STATE,
});

// 组内排序：有年份的按年份倒序（新玩过的在上面），没年份的按标题。
const items = [...feed.items].sort(
    (a, b) => (b.year ?? "").localeCompare(a.year ?? "") || a.title.zh.localeCompare(b.title.zh),
);

const groups = GAME_STATUS_ORDER.map((status) => ({
    status,
    label: gameStatusLabel(status, loc),
    items: items.filter((game) => game.status === status),
})).filter((group) => group.items.length > 0);

// 序号按视觉顺序编（分组之后）：先编号再分组会让屏幕上的序号跳号。
const ordinalOf = new Map(
    groups.flatMap((group) => group.items).map((game, position) => [game.id, position + 1]),
);

const finishedCount = items.filter((game) => game.status === "finished").length;
const totalHours = items.reduce((sum, game) => sum + (game.hours ?? 0), 0);

const copy = isEn
    ? {
          kicker: "GAMES · THE LOG",
          title: "Games",
          lede: "What I played and what happened to it. Grouped by state instead of a scoreboard: playing, finished, waiting, set aside.",
          gameOne: "games",
          finishedOne: "finished",
          hoursOne: "hours logged",
          updatedPrefix: "data updated",
          emptyTitle: "No games logged yet",
          emptyText:
              "This site has not filled in its game data yet. The empty state is part of the page: the route still resolves.",
          errorTitle: "Game data could not be read",
          errorText:
              "The game file exists but its shape is invalid, so nothing is listed here. The rest of the page still works.",
          reason: "Reason code",
          topologyTitle: "Hardware & streaming topology",
          topologyMeta: "The host stays wired; only clients go wireless",
          topologyFoot: "Nodes come straight from the device log — no invented specs.",
          topologyLink: "All devices",
          roles: {
              host: "HOST · streaming server",
              routing: "ROUTING · network",
              desk: "DESK · wired client",
              portable: "PORTABLE · wireless client",
          },
      }
    : {
          kicker: "游戏 · 游玩记录",
          title: "游戏",
          lede: "玩过什么、后来怎么样了。按状态分组而不是排成就榜：在玩、已通关、待玩、搁置。",
          gameOne: "款游戏",
          finishedOne: "款通关",
          hoursOne: "小时记录",
          updatedPrefix: "数据更新于",
          emptyTitle: "还没有游戏记录",
          emptyText: "这个站点还没填游戏数据。空态也是页面的一部分：路由照常可访问。",
          errorTitle: "游戏数据读取失败",
          errorText: "游戏数据文件存在但格式不合法，这里暂不列出。页面其余部分不受影响。",
          reason: "原因代码",
          topologyTitle: "设备与串流拓扑",
          topologyMeta: "服务端插网线，无线只做客户端",
          topologyFoot: "节点取自设备清单的真实记录，不编参数。",
          topologyLink: "查看全部设备",
          roles: {
              host: "宿主机 · 串流服务端",
              routing: "网络骨干 · 路由",
              desk: "工位桌面 · 有线客户端",
              portable: "移动端 · 无线客户端",
          },
      };

const updatedLabel = formatUpdated(feed.updated, feed.ageDays, isEn ? "en" : "zh");
const issueCode = feed.issue?.code ?? "unknown";

/**
 * 页头统计行（P1-03）：
 * - 总数 chip **恒在**（0 条也报 0，避免空页头）；
 * - 已通关 chip 仅当 finishedCount > 0；小时 chip 仅当 totalHours > 0；
 * - 更新时间 chip 仅当 feed.updated 非空。
 */
const heroMeta = [
    { icon: "tabler:device-gamepad-2", label: `${items.length} ${copy.gameOne}` },
    ...(finishedCount > 0
        ? [{ icon: "tabler:trophy", label: `${finishedCount} ${copy.finishedOne}` }]
        : []),
    ...(totalHours > 0 ? [{ icon: "tabler:clock", label: `${totalHours} ${copy.hoursOne}` }] : []),
    ...(updatedLabel ? [{ label: `${copy.updatedPrefix} ${updatedLabel}`, quiet: true }] : []),
];

/**
 * 串流拓扑（P1-07）：只桌面。角色 → 设备清单里的真实条目；
 * 型号 / 规格行全部来自 `devices.ts`，缺设备就整节点不渲染（不留空壳卡）。
 */
const deviceById = new Map(devices.map((device) => [device.id, device]));
const topology = (
    [
        { id: "windows-laptop", role: copy.roles.host, icon: "tabler:server" },
        { id: "openwrt-router", role: copy.roles.routing, icon: "tabler:world" },
        { id: "imac", role: copy.roles.desk, icon: "tabler:devices" },
        { id: "macbook", role: copy.roles.portable, icon: "tabler:device-gamepad-2" },
    ] as const
).flatMap((entry) => {
    const device = deviceById.get(entry.id);
    if (!device) return [];
    return [
        { role: entry.role, icon: entry.icon, name: device.name, specs: device.specs.slice(0, 3) },
    ];
});
---

<BaseLayout
    locale={loc}
    title={`${copy.title} - ${site.title}`}
    description={copy.lede}
    keywords={["Games", "游戏", "游玩记录", "Steam"]}
>
    <article
        class="entities entities--games"
        data-games-status={feed.status}
        data-games-total={feed.total}
        data-games-groups={groups.length}
        data-games-stale={String(feed.stale)}
        data-games-updated={feed.updated ?? ""}
        aria-labelledby="games-title"
    >
        <PageHero
            kicker={copy.kicker}
            title={copy.title}
            lede={copy.lede}
            meta={heroMeta}
            id="games-title"
        />

        {
            feed.status === "ok" && feed.issue?.code === "entry-dropped" && (
                <p class="entities-notice" data-games-dropped={feed.dropped}>
                    {isEn
                        ? `${feed.dropped} entries failed validation and are not listed below.`
                        : `有 ${feed.dropped} 条数据未通过校验，未在下方列出。`}
                </p>
            )
        }

        <div class="game-sections">
            {
                feed.status === "ok" &&
                    groups.map((group) => (
                        <section
                            class="entities-section"
                            aria-labelledby={`game-state-${group.status}`}
                        >
                            <SectionHead
                                id={`game-state-${group.status}`}
                                title={group.label}
                                meta={`${group.items.length} ${copy.gameOne}`}
                            />
                            <ol class="game-grid" role="list">
                                {group.items.map((game) => (
                                    <GameCard
                                        game={game}
                                        index={ordinalOf.get(game.id) ?? 1}
                                        locale={loc}
                                    />
                                ))}
                            </ol>
                        </section>
                    ))
            }

            {
                feed.status === "error" && (
                    <div class="game-state" data-games-error={issueCode}>
                        <DataState
                            kind="error"
                            title={copy.errorTitle}
                            message={copy.errorText}
                            code={issueCode}
                            codeLabel={copy.reason}
                        />
                    </div>
                )
            }

            {
                feed.status === "empty" && (
                    <div class="game-state" data-games-empty={issueCode}>
                        <DataState
                            kind="empty"
                            icon="tabler:device-gamepad-2"
                            title={copy.emptyTitle}
                            message={copy.emptyText}
                        />
                    </div>
                )
            }
        </div>

        {
            topology.length > 0 && (
                <section class="game-topology" aria-labelledby="game-topology-title">
                    <SectionHead
                        id="game-topology-title"
                        title={copy.topologyTitle}
                        meta={copy.topologyMeta}
                    />
                    <ul class="game-topology__grid" role="list">
                        {topology.map((node) => (
                            <li class="game-topology__node">
                                <p class="game-topology__role">
                                    <Icon name={node.icon} size="xs" />
                                    {node.role}
                                </p>
                                <p class="game-topology__name">{node.name}</p>
                                <ul class="game-topology__specs" role="list">
                                    {node.specs.map((spec) => (
                                        <li class="game-topology__spec">{spec}</li>
                                    ))}
                                </ul>
                            </li>
                        ))}
                    </ul>
                    <p class="game-topology__foot">
                        <span>{copy.topologyFoot}</span>
                        <a class="game-topology__link" href={isEn ? "/en/devices/" : "/devices/"}>
                            {copy.topologyLink}
                            <span class="game-topology__arrow" aria-hidden="true">
                                ↗
                            </span>
                        </a>
                    </p>
                </section>
            )
        }
    </article>
</BaseLayout>
