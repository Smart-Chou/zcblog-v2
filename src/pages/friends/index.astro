---
/**
 * P-05 友链（中文路由）
 * M2-6a：页面视觉全部走 src/styles/pages/friends.css + tokens.css；本文件只做「取数 + 交给组件」。
 *
 * 数据注入：`src/data/<friendsPage.dataFile>`（默认 friends.json）→ friends adapter。
 * 槽位文件缺失 / 内容为空 → 空态；内容坏 → 错误态；两种都是页面状态，路由永远 200。
 * 构建期可用 `FRIENDS_STATE=empty|error` 预览另两态（验收/截图用，不改数据文件）。
 */
import "~/styles/tokens/tokens.css";
import "~/styles/pages/friends.css";
import { getLocale } from "~/utils/i18n";
import { friendsPage } from "~/config";
import { loadSiteFriends } from "~/data/adapters/friends";
import FriendsContent from "~/components/Pages/FriendsContent.astro";

const locale = getLocale(Astro.currentLocale || "zh");
const feed = loadSiteFriends(friendsPage.dataFile);
---

<FriendsContent locale={locale} feed={feed} />
