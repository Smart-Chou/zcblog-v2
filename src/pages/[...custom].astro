---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Author from "~/components/UI/Author.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
    const pages = await getCollection("pages");
    return pages.map((page) => ({
        params: { custom: page.id },
        props: { page },
    }));
}

const { page } = Astro.props;
const { Content } = await render(page);
---

<BaseLayout title={page.data.title} description={page.data.description || ""} noEnAlternate>
    <div class="legal-container">
        <h1>{page.data.title}</h1>
        <Content />
        <Author />
    </div>
</BaseLayout>

<style>
    .legal-container {
        max-width: 800px;
        margin: 0 auto;
        padding: 2rem 1.5rem;
    }

    .legal-container :global(h1) {
        font-size: 2rem;
        font-weight: 700;
        margin-bottom: 1.5rem;
        color: var(--color-title);
    }

    .legal-container :global(h2) {
        font-size: 1.25rem;
        font-weight: 600;
        margin-top: 2rem;
        margin-bottom: 1rem;
        color: var(--color-title);
    }

    .legal-container :global(p) {
        color: var(--color-text);
        line-height: 1.8;
        margin-bottom: 1rem;
    }

    .legal-container :global(a) {
        color: var(--color-accent);
        /* M2-13a：正文链接只靠颜色区分（link-in-text-block 2.32:1 < 3:1 要求）。
           常驻下划线是非颜色线索，色觉障碍用户也能认出这是链接。 */
        text-decoration: underline;
        text-decoration-thickness: 1px;
        text-underline-offset: 0.2em;
    }

    @media (hover: hover) {
        .legal-container :global(a:hover) {
            text-decoration-thickness: 2px;
        }
    }

    .legal-container :global(ul),
    .legal-container :global(ol) {
        color: var(--color-text);
        line-height: 1.8;
        margin-bottom: 1rem;
        padding-left: 1.5rem;
    }

    .legal-container :global(li) {
        margin-bottom: 0.5rem;
    }

    .legal-container :global(table) {
        width: 100%;
        border-collapse: collapse;
        margin: 1rem 0;
    }

    .legal-container :global(th),
    .legal-container :global(td) {
        border: 1px solid var(--color-border);
        padding: 0.75rem;
        text-align: left;
    }

    .legal-container :global(th) {
        background: var(--color-bg-surface);
        font-weight: 600;
    }

    .legal-container :global(td) {
        background: var(--color-bg);
    }

    .legal-container :global(strong) {
        color: var(--color-title);
        font-weight: 600;
    }
</style>
