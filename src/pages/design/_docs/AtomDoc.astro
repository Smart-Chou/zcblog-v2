---
/**
 * AtomDoc — 12 份组件文档的共用版式（M1-6）。
 *
 * 七个章节与 16-m1-brief §5 第 5 项一一对应：
 *   1 用途 / 何时不用 · 2 Props · 3 Slots · 4 States · 5 可访问性 ·
 *   6 消费的 token 白名单 · 7 示例（真实组件实例，由页面经 slot 传入）
 * 附录 A / B（尺寸、禁止项）来自 DESIGN.md，不是必需的七项，但缺了会返工。
 *
 * 本页 0 JS：没有 <script>、没有 client:* 指令；主题由 `data-theme` 属性决定
 * （默认 light，与 /design/atoms 的 specimen 页同一口径）。
 */
import "../../../styles/tokens/tokens.css";
import type { DocEntry } from "./types";
import { DOCS } from "./index";
import DocTable from "./DocTable.astro";
import { rich } from "./rich";

interface Props {
    doc: DocEntry;
    /**
     * 文档分区（M2-10a）。缺省 = atom 文档的现状（12 份 atom/molecule、/design/atoms/），
     * 传进来则整份版式按 legacy UI 的目录与同级顺序渲染 —— 版式只有这一份，不复制。
     */
    section?: DocSection;
}

interface DocSection {
    /** 同级文档的 URL 前缀，例如 `/design/components/`。 */
    base: string;
    /** 同级文档（prev / next / 页脚索引都从这里取）。 */
    peers: { slug: string; name: string }[];
    /** 页头的返回链接。 */
    backHref: string;
    backLabel: string;
    /** 页脚索引标题。 */
    indexTitle: string;
    /** 页脚索引下方的一句说明。 */
    indexHint: string;
}

const ATOM_SECTION: DocSection = {
    base: "/design/atoms/",
    peers: DOCS.map((entry) => ({ slug: entry.slug, name: entry.name })),
    backHref: "/design/atoms/",
    backLabel: "← specimen 实验页",
    indexTitle: "全部 12 份组件文档",
    indexHint: "契约源是 `DESIGN.md §5.6`；本页只负责把契约与实现摆在一起，不改组件、不改 token。",
};

const { doc, section = ATOM_SECTION } = Astro.props as Props;
const { a11y, tokens } = doc;

const peers = section.peers;
const index = peers.findIndex((entry) => entry.slug === doc.slug);
const prev = peers[(index - 1 + peers.length) % peers.length];
const next = peers[(index + 1) % peers.length];

const SECTIONS = [
    { id: "purpose", label: "用途" },
    { id: "props", label: "Props" },
    { id: "slots", label: "Slots" },
    { id: "states", label: "States" },
    { id: "a11y", label: "可访问性" },
    { id: "tokens", label: "Token" },
    { id: "example", label: "示例" },
];
---

<!doctype html>
<html lang="zh-CN" data-theme="light">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="robots" content="noindex, nofollow" />
        <title>{doc.name} · 组件文档 — Design system</title>
    </head>
    <body>
        <header class="doc-head">
            <p class="doc-kicker">
                Design system · {doc.layer} · {doc.spec}
            </p>
            <h1 class="doc-title">
                {doc.name}<span class="doc-cn">{doc.cn}</span>
            </h1>
            <p class="doc-meta">
                实现：<code class="tok">{doc.source}</code>
            </p>
            <nav class="doc-nav" aria-label="文档导航">
                <a class="doc-nav__link" href={section.backHref}>{section.backLabel}</a>
                <a class="doc-nav__link" href={`${section.base}${prev.slug}/`}>
                    ← {prev.name}
                </a>
                <a class="doc-nav__link" href={`${section.base}${next.slug}/`}>{next.name} →</a>
            </nav>
            <nav class="doc-toc" aria-label="本页章节">
                {
                    SECTIONS.map((section, i) => (
                        <a class="doc-toc__link" href={`#${section.id}`}>
                            {`${i + 1} · ${section.label}`}
                        </a>
                    ))
                }
            </nav>
        </header>

        <main class="doc-main">
            <section class="doc-section" id="purpose">
                <h2 class="doc-h2">1 · 用途 / 何时不用</h2>
                <p class="doc-lead" set:html={rich(doc.purpose)} />
                <h3 class="doc-h3">何时不用</h3>
                <ul class="doc-list">
                    {doc.notFor.map((item) => <li set:html={rich(item)} />)}
                </ul>
            </section>

            <section class="doc-section" id="props">
                <h2 class="doc-h2">2 · Props</h2>
                <DocTable
                    label={`${doc.name} Props`}
                    columns={["名称", "类型", "默认", "取值", "说明"]}
                    rows={doc.props.map((p) => [p.name, p.type, p.default, p.values, p.notes])}
                />
            </section>

            <section class="doc-section" id="slots">
                <h2 class="doc-h2">3 · Slots</h2>
                <DocTable
                    label={`${doc.name} Slots`}
                    columns={["名称", "必需", "说明"]}
                    rows={doc.slots.map((s) => [s.name, s.required, s.notes])}
                />
            </section>

            <section class="doc-section" id="states">
                <h2 class="doc-h2">4 · States</h2>
                <p class="doc-hint">
                    状态词取 §5.4 的 8 词闭集；这里只列本组件实际拥有的状态，其余标「不适用」。
                </p>
                <DocTable
                    label={`${doc.name} States`}
                    columns={["状态", "触发", "视觉 token", "ARIA"]}
                    rows={doc.states.map((s) => [s.state, s.trigger, s.visual, s.aria])}
                />
            </section>

            <section class="doc-section" id="a11y">
                <h2 class="doc-h2">5 · 可访问性</h2>
                <dl class="doc-dl">
                    <dt>语义元素</dt>
                    <dd set:html={rich(a11y.semantics)} />
                    <dt>键盘</dt>
                    <dd set:html={rich(a11y.keyboard)} />
                    <dt>ARIA</dt>
                    <dd set:html={rich(a11y.aria)} />
                    <dt>焦点环</dt>
                    <dd set:html={rich(a11y.focusRing)} />
                    <dt>指针目标</dt>
                    <dd set:html={rich(a11y.target)} />
                    <dt>reduced-motion</dt>
                    <dd set:html={rich(a11y.reducedMotion)} />
                </dl>
                <h3 class="doc-h3">对比度（light / dark，§5.6.13-B 实测）</h3>
                <DocTable
                    label={`${doc.name} 对比度`}
                    columns={["色对", "light", "dark", "门槛"]}
                    rows={a11y.contrast.map((c) => [c.pair, c.light, c.dark, c.threshold])}
                />
                {
                    a11y.notes && a11y.notes.length > 0 && (
                        <div class="doc-note">
                            <h3 class="doc-h3">补充</h3>
                            <ul class="doc-list">
                                {a11y.notes.map((note) => (
                                    <li set:html={rich(note)} />
                                ))}
                            </ul>
                        </div>
                    )
                }
            </section>

            <section class="doc-section" id="tokens">
                <h2 class="doc-h2">6 · 消费的 token 白名单</h2>
                <p class="doc-hint">
                    白名单以外的 token 一律不用；所有名字都来自
                    <code class="tok">src/styles/tokens/tokens.json</code>。
                </p>
                {
                    tokens.color.length > 0 ? (
                        <div class="doc-token-group">
                            <h3 class="doc-h3">颜色（{tokens.color.length}）</h3>
                            <ul class="doc-chips">
                                {tokens.color.map((token) => (
                                    <li>
                                        <code class="tok">{token}</code>
                                    </li>
                                ))}
                            </ul>
                        </div>
                    ) : (
                        <p class="doc-lead" set:html={rich(tokens.none ?? "颜色：无")} />
                    )
                }
                {
                    tokens.metric.length > 0 && (
                        <div class="doc-token-group">
                            <h3 class="doc-h3">度量（{tokens.metric.length}）</h3>
                            <ul class="doc-chips">
                                {tokens.metric.map((token) => (
                                    <li>
                                        <code class="tok">{token}</code>
                                    </li>
                                ))}
                            </ul>
                        </div>
                    )
                }
                {
                    tokens.other && tokens.other.length > 0 && (
                        <div class="doc-token-group">
                            <h3 class="doc-h3">其他（{tokens.other.length}）</h3>
                            <ul class="doc-chips">
                                {tokens.other.map((token) => (
                                    <li>
                                        <code class="tok">{token}</code>
                                    </li>
                                ))}
                            </ul>
                        </div>
                    )
                }
                {
                    tokens.color.length > 0 && tokens.none && (
                        <p class="doc-hint" set:html={rich(tokens.none)} />
                    )
                }
            </section>

            <section class="doc-section" id="example">
                <h2 class="doc-h2">7 · 示例</h2>
                <p class="doc-hint">
                    下面是真实组件实例（不是截图），标记与
                    <code class="tok">/design/atoms/</code> 的 specimen 同源；可以直接 Tab / 悬停 / 点击。
                </p>
                <slot />
            </section>

            {
                doc.sizes && (
                    <section class="doc-section" id="sizes">
                        <h2 class="doc-h2">附录 A · {doc.sizes.title}</h2>
                        <DocTable
                            label={`${doc.name} 尺寸`}
                            columns={doc.sizes.columns}
                            rows={doc.sizes.rows}
                        />
                    </section>
                )
            }

            {
                doc.forbidden && doc.forbidden.length > 0 && (
                    <section class="doc-section" id="forbidden">
                        <h2 class="doc-h2">附录 B · 禁止（本组件专属）</h2>
                        <ol class="doc-list">
                            {doc.forbidden.map((item) => (
                                <li set:html={rich(item)} />
                            ))}
                        </ol>
                    </section>
                )
            }
        </main>

        <footer class="doc-foot">
            <h2 class="doc-h2">{section.indexTitle}</h2>
            <ul class="doc-index">
                {
                    peers.map((entry) => (
                        <li>
                            <a
                                class="doc-index__link"
                                href={`${section.base}${entry.slug}/`}
                                aria-current={entry.slug === doc.slug ? "page" : undefined}
                            >
                                {entry.name}
                            </a>
                        </li>
                    ))
                }
            </ul>
            <p class="doc-hint" set:html={rich(section.indexHint)} />
        </footer>
    </body>
</html>

<style>
    *,
    *::before,
    *::after {
        box-sizing: border-box;
    }

    html {
        background-color: var(--color-bg-canvas);
        color: var(--color-fg-default);
    }

    body {
        margin: 0 auto;
        max-inline-size: var(--layout-content);
        padding: var(--space-8) var(--space-6);
        background-color: var(--color-bg-canvas);
        font-family: var(--font-sans);
        line-height: var(--leading-normal);
        overflow-wrap: break-word;
    }

    .doc-head {
        display: flex;
        flex-direction: column;
        gap: var(--space-3);
        padding-block-end: var(--space-6);
        border-block-end: 1px solid var(--color-border-subtle);
    }

    .doc-kicker {
        margin: 0;
        color: var(--color-fg-muted);
        font-family: var(--font-mono);
        font-size: var(--text-xs);
    }

    .doc-title {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: var(--space-3);
        margin: 0;
        color: var(--color-fg-heading);
        font-family: var(--font-serif);
        font-size: var(--text-3xl);
        line-height: var(--leading-tight);
    }

    .doc-cn {
        color: var(--color-fg-muted);
        font-family: var(--font-sans);
        font-size: var(--text-lg);
        font-weight: var(--font-weight-regular);
    }

    .doc-meta {
        margin: 0;
        color: var(--color-fg-muted);
        font-size: var(--text-sm);
    }

    .doc-nav {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-4);
    }

    .doc-nav__link,
    .doc-toc__link,
    .doc-index__link {
        color: var(--color-fg-link);
        text-decoration: underline;
        text-decoration-thickness: 1px;
        text-underline-offset: 2px;
    }

    .doc-nav__link {
        display: inline-flex;
        align-items: center;
        min-block-size: var(--space-11);
        font-size: var(--text-sm);
    }

    .doc-toc {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-3);
    }

    .doc-toc__link {
        display: inline-flex;
        align-items: center;
        min-block-size: var(--space-6);
        color: var(--color-fg-muted);
        font-size: var(--text-sm);
        text-decoration: none;
    }

    .doc-nav__link:focus-visible,
    .doc-toc__link:focus-visible,
    .doc-index__link:focus-visible {
        outline: 2px solid var(--color-ring-focus);
        outline-offset: 2px;
    }

    .doc-main {
        display: flex;
        flex-direction: column;
        gap: var(--space-12);
        padding-block: var(--space-8);
    }

    .doc-section {
        display: flex;
        flex-direction: column;
        gap: var(--space-4);
        padding-block-end: var(--space-8);
        border-block-end: 1px solid var(--color-border-subtle);
    }

    .doc-h2 {
        margin: 0;
        color: var(--color-fg-heading);
        font-family: var(--font-serif);
        font-size: var(--text-2xl);
        line-height: var(--leading-snug);
    }

    .doc-h3 {
        margin: 0;
        color: var(--color-fg-heading);
        font-size: var(--text-base);
        font-weight: var(--font-weight-semibold);
        line-height: var(--leading-snug);
    }

    .doc-lead {
        max-inline-size: var(--measure-prose);
        margin: 0;
        font-size: var(--text-base);
        line-height: var(--leading-relaxed);
    }

    .doc-hint {
        margin: 0;
        color: var(--color-fg-muted);
        font-size: var(--text-sm);
        line-height: var(--leading-normal);
    }

    .doc-list {
        display: flex;
        flex-direction: column;
        gap: var(--space-2);
        max-inline-size: var(--measure-prose);
        margin: 0;
        padding-inline-start: var(--space-6);
        font-size: var(--text-sm);
        line-height: var(--leading-relaxed);
    }

    .doc-dl {
        display: grid;
        grid-template-columns: minmax(min-content, var(--layout-toc)) minmax(0, 1fr);
        gap: var(--space-2) var(--space-4);
        margin: 0;
        font-size: var(--text-sm);
        line-height: var(--leading-relaxed);
    }

    .doc-dl dt {
        color: var(--color-fg-muted);
        font-weight: var(--font-weight-medium);
    }

    .doc-dl dd {
        margin: 0;
        overflow-wrap: anywhere;
    }

    .doc-note,
    .doc-token-group {
        display: flex;
        flex-direction: column;
        gap: var(--space-2);
    }

    .doc-chips {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-2);
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .doc-chips code {
        display: inline-flex;
        align-items: center;
        min-block-size: var(--space-6);
        padding-inline: var(--space-2);
        border: 1px solid var(--color-border-subtle);
        border-radius: var(--radius-sm);
        background-color: var(--color-bg-muted);
        color: var(--color-fg-default);
        font-size: var(--text-xs);
    }

    .doc-foot {
        display: flex;
        flex-direction: column;
        gap: var(--space-3);
        padding-block-start: var(--space-6);
        border-block-start: 1px solid var(--color-border-subtle);
    }

    .doc-index {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-4);
        margin: 0;
        padding: 0;
        list-style: none;
        font-size: var(--text-sm);
    }

    .doc-index__link {
        display: inline-flex;
        align-items: center;
        min-block-size: var(--space-6);
    }

    .doc-index__link[aria-current="page"] {
        color: var(--color-fg-default);
        font-weight: var(--font-weight-medium);
        text-decoration: none;
    }

    .tok {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
    }
</style>
