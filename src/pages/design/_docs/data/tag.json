            {
                "pair": "neutral 字 `fg-default` / `bg-muted`",
                "light": "8.05",
                "dark": "8.94",
                "threshold": "≥ 4.5"
            },
            {
                "pair": "accent 字 `fg-link` / `bg-surface`",
                "light": "6.04",
                "dark": "4.72",
                "threshold": "≥ 4.5"
            },
            {
                "pair": "info 字 `status-info-fg` / `-bg`",
                "light": "8.49",
                "dark": "8.73",
                "threshold": "≥ 4.5"
            },
            {
                "pair": "success 字 `status-success-fg` / `-bg`",
                "light": "4.60",
                "dark": "5.62",
                "threshold": "≥ 4.5"
            },
            {
                "pair": "warning 字 `status-warning-fg` / `-bg`",
                "light": "4.58",
                "dark": "4.97",
                "threshold": "≥ 4.5"
            },
            {
                "pair": "danger 字 `status-danger-fg` / `-bg`",
                "light": "6.21",
                "dark": "5.63",
                "threshold": "≥ 4.5"
            },
            {
                "pair": "反例：accent 若用 `accent-subtle` 做底（不采用）",
                "light": "5.47",
                "dark": "3.53",
                "threshold": "因此改用 `bg-surface`"
            }
        ],
        "focusRing": "G4；环画在 Tag 外沿，`outline-offset: 2px`，不压到相邻 Tag。",
        "target": "`sm` 24（`--space-6`）刚好达标；移除按钮单独点按 ≥ 24（`--space-6` 见方），不许把热区压到相邻元素。",
        "reducedMotion": "过渡归 0。",
        "notes": [
            "accent 档不用 `--color-accent-subtle` 做底：`fg-link` 在其上深色只有 3.53。",
            "tone 不是状态：`tone` 是变体，状态词只有 default / hover / focus-visible / selected。"
        ]
    },
