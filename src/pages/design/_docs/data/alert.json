        ],
        "none": "阴影：无。"
    },
    "sizes": {
        "title": "尺寸（DESIGN.md §5.6.11）",
        "columns": ["项", "值"],
        "rows": [
            ["内边距", "`--space-4`"],
            ["图标与正文间距", "`--space-3`"],
            ["标题与正文间距", "`--space-1`"],
            ["正文与 actions 间距", "`--space-3`"],
            ["圆角", "`--radius-md`"],
            ["图标尺寸", "`--space-5`（Icon `size=\"sm\"`）"],
            ["标题", "`--text-base` + `--font-weight-semibold` + `--leading-snug`"],
            ["正文", "`--text-sm` + `--leading-relaxed`"]
        ]
    },
    "forbidden": [
        "页面加载即存在的提示用 `live=\"assertive\"` / `role=\"alert\"`。",
        "用 `border-left` 彩色条表达 tone（N10）。",
        "只靠颜色区分 tone（必须有图标 + 文案，N5）。",
        "把 `Notice` 的 `localStorage` / `sessionStorage` 逻辑搬进 Alert。",
        "关闭按钮自己 `remove()`（父级控状态，G8）。",
        "Alert 里套 Alert / 卡片套 Alert 再套卡片。",
        "用 Alert 做营销横幅。"
    ],
    "related": ["icon", "button", "link"]
}
