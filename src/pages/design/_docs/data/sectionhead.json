            "notes": "标题层级；`3` 只用于已有一层 h2 的页面，不得跳级。"
        },
        {
            "name": "class",
            "type": "string",
            "default": "—",
            "values": "—",
            "notes": "只允许布局类。"
        }
    ],
    "slots": [
        {
            "name": "action",
            "required": "否",
            "notes": "右侧操作位（页面传入 `Link` 或 `Button`）；不传则只有 meta。"
