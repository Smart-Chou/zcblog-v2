            "--leading-none",
            "--duration-fast",
            "--ease-standard"
        ],
        "none": "阴影：无（按钮不吃 shadow；hover 抬升属 N10）。"
    },
    "sizes": {
        "title": "尺寸（DESIGN.md §5.6.1）",
        "columns": ["size", "高度", "内边距 x", "字号", "圆角"],
        "rows": [
            ["`sm`", "`--space-8`", "`--space-3`", "`--text-sm`", "`--radius-md`"],
            ["`md`", "`--space-10`", "`--space-4`", "`--text-sm`", "`--radius-md`"],
            ["`lg`", "`--space-12`", "`--space-6`", "`--text-base`", "`--radius-md`"]
        ]
    },
    "forbidden": [
        "用 `<a>` 实现按钮（跳转用 Link）。",
        "icon-only 不传 `label`（N4）。",
        "`loading` 时改变宽度或清空文案（抖动 + 读屏重读）。",
        "`text-transform: uppercase`（中文无意义，英文破坏 body 风格）。",
        "两个按钮等宽并排的营销 CTA。",
        "hover 里加 `box-shadow` 抬升或 `translateY(-2px)`。",
        "新增 `*-solid-hover` 这类 hover 专用语义键（§3.4 是闭集）。"
    ],
    "related": ["link", "icon"]
}
