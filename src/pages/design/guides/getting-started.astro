---
/**
 * /design/guides/getting-started/ — 教程 1（M2-10b）
 *
 * 目标：一个干净环境从 clone 到「门禁全绿」。这里的每条命令都在本机实跑过，
 * 版本号与输出以 2026-11 的仓库状态为准（命令本身不会过期，数字会）。
 */
import "../../../styles/tokens/tokens.css";

const STEPS = [
    {
        id: "prereq",
        title: "1 · 前置条件",
        body: [
            "Node 22（CI 用的就是 22）、pnpm 12（`packageManager` 字段钉了版本）、Python 3（四个门禁是 Python 脚本）。",
            "仓库用 corepack 管 pnpm：不要在全局装另一个版本，`packageManager` 会对不上。",
        ],
        code: [
            "node -v          # v22.x",
            "corepack enable",
            "corepack pnpm -v # 12.10.1（来自 package.json 的 packageManager）",
            "python3 -V       # 3.x",
        ].join("\n"),
    },
    {
        id: "install",
        title: "2 · 安装依赖",
        body: [
            "`preinstall` 里有一条 `only-allow pnpm`：用 npm / yarn 装会直接失败，这是有意的。",
            "sharp 需要 libvips；macOS 上装依赖时如果报找不到 libvips，先 `brew install vips`（CI 里是 `apt-get install libvips-dev`）。",
        ],
        code: [
            "corepack pnpm install --frozen-lockfile",
            "corepack pnpm dev   # http://localhost:4321",
        ].join("\n"),
    },
    {
        id: "content",
        title: "3 · 内容仓（可选，但完整构建需要）",
        body: [
            "文章不在这个仓库里：`src/content/article/` 与 `src/assets/` 都在 .gitignore 里，CI 从私有仓 `Smart-Chou/zcblog-articles` 检出后复制进来。",
            "只做设计系统 / 文档 / 门禁这类工作，不检出内容仓也能跑：`/design/` 下的 35 份文档不读文章集合（首页与归档会是空列表）。",
            "反过来，`scripts/verify-build.mjs` 会核对文章数量，所以「全绿」口径的验收需要内容仓。",
        ],
        code: [
            "mkdir -p src/content/article src/assets",
            "# 有内容仓时：",
            "# git clone <articles-repo> _articles",
            "# cp _articles/*.md _articles/*.mdx src/content/article/",
            "# node scripts/normalize-frontmatter.mjs src/content/article",
        ].join("\n"),
    },
    {
        id: "gates",
        title: "4 · 七道门禁",
        body: [
            "`package.json` 把门禁拆成了单条脚本，`gates:all` 串起七道。它们都是纯 Node/Python，不读 dist、不联网，适合在改完代码立刻跑。",
            "文档相关的两道（`gates:docs`、`verify-component-docs.mjs`）要读 dist 时加 `--dist`，所以顺序是「先 build 再带 --dist 跑」。",
        ],
        code: [
            "corepack pnpm gates:atoms     # 12 个 atom 的契约与实现一致",
            "corepack pnpm gates:docs      # 12 份 atom 文档（8 项判据）",
            "corepack pnpm gates:inventory # 组件清单与源码对账",
            "corepack pnpm gates:drift     # R-40：DESIGN.md §5.6 ↔ 文档数据",
            "corepack pnpm gates:tokens    # token 契约（10 项）",
            "corepack pnpm gates:surfaces  # P5 棘轮：页面 0 硬编码",
            "corepack pnpm gates:entities  # E1–E8 实体契约",
            "corepack pnpm gates:all       # 上面七条串起来",
        ].join("\n"),
    },
    {
        id: "build",
        title: "5 · 构建与文档站",
        body: [
            "`astro build` 之后才会生成 `/design/components/<slug>/` 的 23 个页面与 `/design/atoms/<slug>/` 的 12 个页面；文档门禁的 `--dist` 模式读的就是这批产物。",
            "`pnpm build` 会先跑 `fetch:all`（拉友链、豆瓣、Bangumi 等）+ `fetch:verify`，然后才 build。只想验证文档时用 `corepack pnpm exec astro build` 跳过联网抓取。",
            "搜索索引是构建后再跑的独立步骤（Pagefind），不跑就只能看到搜索框、搜不到东西。",
        ],
        code: [
            "corepack pnpm exec astro build",
            "node scripts/gates/verify-component-docs.mjs --dist   # 35 份 · 7 section · 5 表",
            "corepack pnpm pagefind                                # 生成 /pagefind/ 索引",
            "corepack pnpm preview                                 # 本地预览 dist",
        ].join("\n"),
    },
    {
        id: "e2e",
        title: "6 · 无障碍与视觉回归",
        body: [
            "Playwright 跑在构建产物上（`playwright.config.ts` 里配的 webServer 会起 `astro preview`），所以先 build，再跑用例。",
            "文档站的用例分三条：atom 文档、legacy UI 文档、specimen 页。/design 首页与 3 篇教程的结构/axe 断言也在文档那条 spec 里。",
        ],
        code: [
            "corepack pnpm exec playwright test e2e/design-component-docs.a11y.spec.ts",
            "corepack pnpm exec playwright test e2e/design-atom-docs.a11y.spec.ts",
            "corepack pnpm exec playwright test e2e/design-atoms.a11y.spec.ts",
        ].join("\n"),
    },
];

const PITFALLS = [
    "用 npm / yarn 装依赖 → `only-allow pnpm` 直接退出（退出码非 0，不是网络问题）。",
    "忘了 `corepack enable` → `pnpm: command not found`；用 `corepack pnpm` 前缀最稳。",
    "没有内容仓就跑 `pnpm build` → `fetch:all` 里几条抓取会失败，但因为命令串了 `|| true`，构建会继续，产物里文章为 0。",
    "先跑 `verify-component-docs.mjs --dist` 再 build → 读到的是上一次的 dist（或直接报缺产物）。",
    "在 `src/pages/design/**` 里写 `px` 字面量 → P5 棘轮与文档门禁 D7 会红（页面只允许 0 / 1px / 2px）。",
];
---

<!doctype html>
<html lang="zh-CN" data-theme="light">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="robots" content="noindex, nofollow" />
        <title>从零开始 · 文档站教程</title>
    </head>
    <body>
        <header class="guide-head">
            <p class="guide-kicker">Design system · guide 1 / 3</p>
            <h1 class="guide-title">从零开始</h1>
            <p class="guide-lead">
                把仓库跑起来、跑完门禁、看懂一次构建的产物。每一步都给出**真实命令**与「跑完应该看到什么」；
                命令本身是稳定的，输出里的数字会随仓库变化。
            </p>
            <nav class="guide-nav" aria-label="教程导航">
                <a href="/design/">← 文档站首页</a>
                <a href="/design/guides/writing-content/">下一篇：写内容 →</a>
            </nav>
        </header>

        <main class="guide-main">
            {
                STEPS.map((step) => (
                    <section class="guide-section" id={step.id}>
                        <h2 class="guide-h2">{step.title}</h2>
                        {step.body.map((paragraph) => (
                            <p class="guide-p">{paragraph}</p>
                        ))}
                        <pre class="guide-code">
                            <code>{step.code}</code>
                        </pre>
                    </section>
                ))
            }

            <section class="guide-section" id="pitfalls">
                <h2 class="guide-h2">7 · 常见坑</h2>
                <ul class="guide-list">
                    {PITFALLS.map((item) => <li>{item}</li>)}
                </ul>
            </section>
        </main>

        <footer class="guide-foot">
            <p class="guide-hint">
                下一篇：<a href="/design/guides/writing-content/">写内容</a> ·
                <a href="/design/guides/deploy/">部署</a>
            </p>
        </footer>
    </body>
</html>

<style>
    *,
    *::before,
    *::after {
        box-sizing: border-box;
    }

    html {
        background-color: var(--color-bg-canvas);
        color: var(--color-fg-default);
    }

    body {
        margin: 0 auto;
        max-inline-size: var(--layout-content);
        padding: var(--space-8) var(--space-6);
        font-family: var(--font-sans);
        line-height: var(--leading-normal);
        overflow-wrap: break-word;
    }

    .guide-head {
        display: flex;
        flex-direction: column;
        gap: var(--space-4);
        padding-block-end: var(--space-6);
        border-block-end: 1px solid var(--color-border-subtle);
    }

    .guide-kicker {
        margin: 0;
        color: var(--color-fg-muted);
        font-family: var(--font-mono);
        font-size: var(--text-xs);
    }

    .guide-title {
        margin: 0;
        color: var(--color-fg-heading);
        font-family: var(--font-serif);
        font-size: var(--text-3xl);
        line-height: var(--leading-tight);
    }

    .guide-lead {
        max-inline-size: var(--measure-prose);
        margin: 0;
        font-size: var(--text-base);
        line-height: var(--leading-relaxed);
    }

    .guide-nav {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-4);
        font-size: var(--text-sm);
    }

    .guide-nav a,
    .guide-foot a {
        color: var(--color-fg-link);
    }

    .guide-main {
        display: flex;
        flex-direction: column;
        gap: var(--space-10);
        padding-block: var(--space-8);
    }

    .guide-section {
        display: flex;
        flex-direction: column;
        gap: var(--space-3);
        padding-block-end: var(--space-6);
        border-block-end: 1px solid var(--color-border-subtle);
    }

    .guide-h2 {
        margin: 0;
        color: var(--color-fg-heading);
        font-family: var(--font-serif);
        font-size: var(--text-xl);
        line-height: var(--leading-snug);
    }

    .guide-p {
        max-inline-size: var(--measure-prose);
        margin: 0;
        font-size: var(--text-sm);
        line-height: var(--leading-relaxed);
    }

    .guide-code {
        margin: 0;
        padding: var(--space-4);
        border: 1px solid var(--color-border-subtle);
        border-radius: var(--radius-lg);
        background-color: var(--color-bg-sunken);
        overflow-x: auto;
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        line-height: var(--leading-relaxed);
    }

    .guide-list {
        display: flex;
        flex-direction: column;
        gap: var(--space-2);
        max-inline-size: var(--measure-prose);
        margin: 0;
        padding-inline-start: var(--space-6);
        font-size: var(--text-sm);
        line-height: var(--leading-relaxed);
    }

    .guide-hint {
        margin: 0;
        color: var(--color-fg-muted);
        font-size: var(--text-sm);
    }

    .guide-foot {
        padding-block-start: var(--space-6);
        border-block-start: 1px solid var(--color-border-subtle);
    }
</style>
