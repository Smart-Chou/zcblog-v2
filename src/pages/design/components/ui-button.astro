---
/**
 * /design/components/ui-button/ — Button 文档页（M2-10a）
 * 数据：src/pages/design/_docs/data/components/ui-button.json
 * 示例链接指到站内真实路由（/donate/ 与 /blog/），保证是可点路径而不是死链。
 * 契约：以实现为准（`packages/ui/src/Button.astro`，M3-3b 迁入 packages/ui）。
 * 站点侧的 src/components/UI/Button.astro 是 git 符号链接（与包内同一份文件），
 * 下方 import 走该路径是因为 verify-component-docs D3 的口径仍校验站点路径。
 */
import ComponentDoc from "../_docs/ComponentDoc.astro";
import DemoFrame from "../_docs/DemoFrame.astro";
import { byComponentSlug } from "../_docs/components";
import Button from "~/components/UI/Button.astro";

const doc = byComponentSlug("ui-button");
---

<ComponentDoc doc={doc}>
    <DemoFrame
        layout="row"
        caption="primary：白字 + `btn-primary-bg`（旧键缺失 → 底色透明，light 主题下几乎看不见）"
    >
        <Button href="/donate/" variant="primary">请我喝杯咖啡</Button>
    </DemoFrame>

    <DemoFrame layout="row" caption="secondary：描边 + accent 字（两个旧键同样缺失 → 描边不可见）">
        <Button href="/blog/" variant="secondary">看全部文章</Button>
    </DemoFrame>

    <DemoFrame layout="row" caption="外链用法：target + rel 由调用方给，组件不猜">
        <Button href="/friends/" variant="secondary" target="_blank" rel="noopener noreferrer">
            友情链接
        </Button>
    </DemoFrame>
</ComponentDoc>
