---
/**
 * /design/components/pageheader/ — PageHeader 文档页（M2-10a）
 * 数据：src/pages/design/_docs/data/components/pageheader.json
 *
 * 第二个示例故意把已经坏掉的图标框摆出来：底色取旧键 `color-accent`（缺失 → 透明），
 * 字色写死白色，所以深色描边图标在纸底上几乎看不见。文档不替它遮。
 */
import ComponentDoc from "../../_docs/ComponentDoc.astro";
import DemoFrame from "../../_docs/DemoFrame.astro";
import { byComponentSlug } from "../../_docs/components";
import PageHeader from "~/components/UI/PageHeader.astro";
import Icon from "~/components/UI/atom/Icon.astro";

const doc = byComponentSlug("pageheader");
---

<ComponentDoc doc={doc}>
    <DemoFrame layout="stack" caption="最小用法：title（渲染成 h1）+ subtitle；buildTime 可选">
        <PageHeader title="归档" subtitle="按年份收起的全部文章，共 3 篇。" />
    </DemoFrame>

    <DemoFrame layout="stack" caption="带 buildTime：正文色 + opacity .6，light 主题实测 3.12:1（债）">
        <PageHeader
            title="豆瓣"
            subtitle="读过的书、看过的电影、听过的唱片。"
            buildTime="构建于 2026-11-04"
        />
    </DemoFrame>

    <DemoFrame
        layout="stack"
        caption="showIcon + icon 槽：图标框底色失效（旧键缺失）→ 白字图标压在纸底上不可见"
    >
        <PageHeader title="友情链接" subtitle="交换友链请来信。" showIcon>
            <Icon slot="icon" name="tabler:users" size="lg" aria-hidden="true" />
        </PageHeader>
    </DemoFrame>
</ComponentDoc>
