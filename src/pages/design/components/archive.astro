---
/**
 * /design/components/archive/ — Archive 文档页（M2-10a）
 * 数据：src/pages/design/_docs/data/components/archive.json
 *
 * 注意：组件没有 `<style>`，归档行的外观在 `src/styles/pages/archives.css` 的 `.archives`
 * 作用域里（页面级样式）。所以示例区看到的是「裸组件」——这正是文档要说明的事实，
 * 而不是缺样式。
 */
import ComponentDoc from "../../_docs/ComponentDoc.astro";
import DemoFrame from "../../_docs/DemoFrame.astro";
import { byComponentSlug } from "../../_docs/components";
import Archive from "~/components/UI/Archive.astro";

const doc = byComponentSlug("archive");

const ROWS = [
    { title: "把设计 token 从 84 条字面量收回到语义层", url: "/blog/", publishedTime: "2026-11-02" },
    { title: "M2 拆解：12 张卡与它们的文件边界", url: "/blog/", publishedTime: "2026-11-04" },
    { title: "站内搜索换成 Pagefind 之后的第一次体检", url: "/blog/", publishedTime: "2026-10-28" },
];
---

<ComponentDoc doc={doc}>
    {
        ROWS.map((row) => (
            <DemoFrame layout="stack" caption="裸组件：三块内容全部由 props 生成，没有样式">
                <Archive title={row.title} url={row.url} publishedTime={row.publishedTime} />
            </DemoFrame>
        ))
    }

    <DemoFrame
        layout="stack"
        caption="坏数据分支：publishedTime 解析失败 → 显示 Invalid date，且不输出 datetime 属性"
    >
        <Archive title="日期坏掉的那一行" url="/blog/" publishedTime="not-a-date" />
    </DemoFrame>
</ComponentDoc>
