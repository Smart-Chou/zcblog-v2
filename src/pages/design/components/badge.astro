---
/**
 * /design/components/badge/ — Badge 文档页（M2-10a）
 * 数据：src/pages/design/_docs/data/components/badge.json
 * 契约：以实现为准（`packages/ui/src/Badge.astro`，M3-3a 迁入 packages/ui）。
 * 站点侧的 src/components/UI/Badge.astro 是 git 符号链接（与包内同一份文件），
 * 下方 import 走该路径是因为 verify-component-docs D3 的口径仍校验站点路径。
 * 六个 variant 都是 §5.5 的 tone 词。
 */
import ComponentDoc from "../_docs/ComponentDoc.astro";
import DemoFrame from "../_docs/DemoFrame.astro";
import { byComponentSlug } from "../_docs/components";
import Badge from "~/components/UI/Badge.astro";

const doc = byComponentSlug("badge");

const VARIANTS = ["default", "note", "tip", "danger", "success", "warning"] as const;
const SIZES = ["sm", "md", "lg"] as const;
---

<ComponentDoc doc={doc}>
    <DemoFrame
        layout="row"
        caption="六个 variant：default / note / tip / danger / success / warning"
    >
        {VARIANTS.map((variant) => <Badge variant={variant}>{variant}</Badge>)}
    </DemoFrame>

    <DemoFrame layout="row" caption="三个 size：sm / md / lg（只改字号与内边距）">
        {
            SIZES.map((size) => (
                <Badge variant="default" size={size}>
                    {`size=${size}`}
                </Badge>
            ))
        }
    </DemoFrame>

    <DemoFrame layout="row" caption="典型用法：跟在文章标题后面，承担「这一条是什么」的一句话">
        <span>新的设计系统文档站已经上线</span>
        <Badge variant="note">已更新</Badge>
    </DemoFrame>
</ComponentDoc>
