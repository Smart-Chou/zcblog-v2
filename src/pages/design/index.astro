---
/**
 * /design/ — 文档站首页（M2-10b）
 *
 * 35 份组件文档（12 atom + 23 legacy UI）+ 3 篇教程的索引与静态筛选。
 * 数据直接来自两份 registry（`_docs/index.ts` 的 DOCS、`_docs/components.ts` 的
 * COMPONENT_DOCS）——不另建一份清单，避免第三处「哪些组件有文档」的真相。
 *
 * 筛选是纯前端的：一行脚本给行加 `hidden`，0 新依赖、0 网络请求。
 * 与 `/design/atoms`、`/design/components` 同口径：noindex，不进主导航。
 */
import "../../styles/tokens/tokens.css";
import { DOCS } from "./_docs/index";
import { COMPONENT_DOCS } from "./_docs/components";

const atoms = DOCS.map((entry) => ({
    slug: entry.slug,
    name: entry.name,
    cn: entry.cn,
    layer: entry.layer,
    href: `/design/atoms/${entry.slug}/`,
}));

const components = COMPONENT_DOCS.map((entry) => ({
    slug: entry.slug,
    name: entry.name,
    cn: entry.cn,
    layer: entry.layer,
    href: `/design/components/${entry.slug}/`,
}));

const guides = [
    {
        href: "/design/guides/getting-started/",
        title: "从零开始",
        cn: "getting-started",
        desc: "把仓库跑起来、跑完七道门禁、看懂一次构建的产物。",
        kind: "guide",
    },
    {
        href: "/design/guides/writing-content/",
        title: "写内容",
        cn: "writing-content",
        desc: "文章从 Markdown 到页面的全链路：frontmatter、组件语法、图片与加密。",
        kind: "guide",
    },
    {
        href: "/design/guides/deploy/",
        title: "部署",
        cn: "deploy",
        desc: "两条线：本仓推 Cloudflare Pages 预览，生产走 Smart-Chou/zcblog 的 GitHub Pages。",
        kind: "guide",
    },
];

const FILTERS = [
    { id: "all", label: `全部（${atoms.length + components.length + guides.length}）` },
    { id: "atom", label: `atom（${atoms.length}）` },
    { id: "ui", label: `legacy UI（${components.length}）` },
    { id: "guide", label: `教程（${guides.length}）` },
];
---

<!doctype html>
<html lang="zh-CN" data-theme="light">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="robots" content="noindex, nofollow" />
        <title>文档站 · Design system</title>
    </head>
    <body>
        <header class="page-head">
            <p class="page-kicker">Design system · docs</p>
            <h1 class="page-title">文档站</h1>
            <p class="page-lead">
                {atoms.length} 个核心组件（atom / molecule，契约在 <code class="tok"
                    >DESIGN.md §5.6</code
                >）+ {components.length} 个 legacy UI 组件（实现即契约）+ {guides.length} 篇教程。 每份组件文档都是七个章节
                + 两个附录，示例区是真实组件实例，不是截图。
            </p>
            <nav class="page-nav" aria-label="文档分区">
                <a href="/design/atoms/">specimen 实验页</a>
                <a href="/design/atoms/button/">核心组件文档</a>
                <a href="/design/components/badge/">legacy UI 文档</a>
            </nav>
        </header>

        <main class="page-main">
            <section class="page-section" aria-labelledby="filter-title">
                <h2 id="filter-title" class="page-h2">筛选</h2>
                <div class="filter" role="group" aria-label="按类型筛选">
                    {
                        FILTERS.map((filter, index) => (
                            <button
                                type="button"
                                class="filter__btn"
                                data-filter={filter.id}
                                aria-pressed={index === 0 ? "true" : "false"}
                            >
                                {filter.label}
                            </button>
                        ))
                    }
                </div>
                <p class="page-hint" id="filter-status" role="status" aria-live="polite">
                    显示全部 {atoms.length + components.length + guides.length} 条
                </p>
            </section>

            <section class="page-section" aria-labelledby="guides-title">
                <h2 id="guides-title" class="page-h2">教程（{guides.length}）</h2>
                <ul class="cards">
                    {
                        guides.map((guide) => (
                            <li class="card" data-kind={guide.kind}>
                                <a class="card__link" href={guide.href}>
                                    <span class="card__title">{guide.title}</span>
                                    <code class="tok card__slug">{guide.cn}</code>
                                </a>
                                <p class="card__desc">{guide.desc}</p>
                            </li>
                        ))
                    }
                </ul>
            </section>

            <section class="page-section" aria-labelledby="atoms-title">
                <h2 id="atoms-title" class="page-h2">核心组件（{atoms.length}）</h2>
                <p class="page-hint">
                    这一组的契约是 `DESIGN.md §5.6`；文档只把契约与实现摆在一起，不改组件、不改
                    token。
                </p>
                <div class="table-wrap">
                    <table class="doc-table">
                        <caption class="visually-hidden">12 个核心组件的文档链接</caption>
                        <thead>
                            <tr>
                                <th scope="col">组件</th>
                                <th scope="col">中文</th>
                                <th scope="col">层</th>
                                <th scope="col">文档</th>
                            </tr>
                        </thead>
                        <tbody>
                            {
                                atoms.map((entry) => (
                                    <tr data-kind="atom">
                                        <th scope="row">{entry.name}</th>
                                        <td>{entry.cn}</td>
                                        <td>
                                            <code class="tok">{entry.layer}</code>
                                        </td>
                                        <td>
                                            <a href={entry.href}>{entry.href}</a>
                                        </td>
                                    </tr>
                                ))
                            }
                        </tbody>
                    </table>
                </div>
            </section>

            <section class="page-section" aria-labelledby="ui-title">
                <h2 id="ui-title" class="page-h2">legacy UI 组件（{components.length}）</h2>
                <p class="page-hint">
                    这一组是 <code class="tok">src/components/UI/*.astro</code> 的旧组件； 它们没有 §5.6
                    契约，文档以「实现事实」为准，并把债务逐条写下来。
                </p>
                <div class="table-wrap">
                    <table class="doc-table">
                        <caption class="visually-hidden">23 个 legacy UI 组件的文档链接</caption>
                        <thead>
                            <tr>
                                <th scope="col">组件</th>
                                <th scope="col">中文</th>
                                <th scope="col">层</th>
                                <th scope="col">slug</th>
                            </tr>
                        </thead>
                        <tbody>
                            {
                                components.map((entry) => (
                                    <tr data-kind="ui">
                                        <th scope="row">
                                            <a href={entry.href}>{entry.name}</a>
                                        </th>
                                        <td>{entry.cn}</td>
                                        <td>
                                            <code class="tok">{entry.layer}</code>
                                        </td>
                                        <td>
                                            <code class="tok">{entry.slug}</code>
                                        </td>
                                    </tr>
                                ))
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        </main>

        <footer class="page-foot">
            <p class="page-hint">
                {atoms.length + components.length} 份组件文档 + {guides.length} 篇教程 = {
                    atoms.length + components.length + guides.length
                }
                个入口。索引不参与 sitemap（<code class="tok">astro.config.mjs</code> 过滤
                <code class="tok">/design/</code>），也不进主导航。
            </p>
        </footer>

        <script>
            // 静态筛选：只改 hidden，不改 DOM 顺序、不发请求。
            const buttons = Array.from(
                document.querySelectorAll<HTMLButtonElement>(".filter__btn"),
            );
            const status = document.getElementById("filter-status");
            const rows = Array.from(document.querySelectorAll<HTMLElement>("[data-kind]"));

            function apply(kind: string): void {
                let visible = 0;
                for (const row of rows) {
                    const match = kind === "all" || row.dataset.kind === kind;
                    row.hidden = !match;
                    if (match) visible += 1;
                }
                for (const button of buttons) {
                    button.setAttribute("aria-pressed", String(button.dataset.filter === kind));
                }
                if (status) status.textContent = `显示 ${visible} 条`;
            }

            for (const button of buttons) {
                button.addEventListener("click", () => apply(button.dataset.filter ?? "all"));
            }
        </script>
    </body>
</html>

<style>
    *,
    *::before,
    *::after {
        box-sizing: border-box;
    }

    html {
        background-color: var(--color-bg-canvas);
        color: var(--color-fg-default);
    }

    body {
        margin: 0 auto;
        max-inline-size: var(--layout-content);
        padding: var(--space-8) var(--space-6);
        font-family: var(--font-sans);
        line-height: var(--leading-normal);
        overflow-wrap: break-word;
    }

    .page-head {
        display: flex;
        flex-direction: column;
        gap: var(--space-4);
        padding-block-end: var(--space-6);
        border-block-end: 1px solid var(--color-border-subtle);
    }

    .page-kicker {
        margin: 0;
        color: var(--color-fg-muted);
        font-family: var(--font-mono);
        font-size: var(--text-xs);
    }

    .page-title {
        margin: 0;
        color: var(--color-fg-heading);
        font-family: var(--font-serif);
        font-size: var(--text-3xl);
        line-height: var(--leading-tight);
    }

    .page-lead {
        max-inline-size: var(--measure-prose);
        margin: 0;
        font-size: var(--text-base);
        line-height: var(--leading-relaxed);
    }

    .page-nav {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-4);
        font-size: var(--text-sm);
    }

    .page-nav a {
        color: var(--color-fg-link);
    }

    .page-main {
        display: flex;
        flex-direction: column;
        gap: var(--space-12);
        padding-block: var(--space-8);
    }

    .page-section {
        display: flex;
        flex-direction: column;
        gap: var(--space-4);
    }

    .page-h2 {
        margin: 0;
        color: var(--color-fg-heading);
        font-family: var(--font-serif);
        font-size: var(--text-2xl);
        line-height: var(--leading-snug);
    }

    .page-hint {
        margin: 0;
        color: var(--color-fg-muted);
        font-size: var(--text-sm);
    }

    .filter {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-2);
    }

    .filter__btn {
        min-block-size: var(--space-9);
        padding-inline: var(--space-3);
        border: 1px solid var(--color-border-default);
        border-radius: var(--radius-pill);
        background-color: var(--color-bg-surface);
        color: var(--color-fg-default);
        font: inherit;
        font-size: var(--text-sm);
        cursor: pointer;
    }

    .filter__btn[aria-pressed="true"] {
        border-color: var(--color-border-accent);
        background-color: var(--color-bg-selected);
    }

    .filter__btn:focus-visible,
    .page-nav a:focus-visible,
    .card__link:focus-visible,
    .doc-table a:focus-visible {
        outline: 2px solid var(--color-ring-focus);
        outline-offset: 2px;
    }

    .cards {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(var(--layout-sidebar), 1fr));
        gap: var(--space-4);
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .card {
        display: flex;
        flex-direction: column;
        gap: var(--space-2);
        padding: var(--space-5);
        border: 1px solid var(--color-border-subtle);
        border-radius: var(--radius-lg);
        background-color: var(--color-bg-surface);
    }

    .card__link {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: var(--space-2);
        color: var(--color-fg-link);
    }

    .card__title {
        font-size: var(--text-base);
        font-weight: var(--font-weight-semibold);
    }

    .card__slug {
        color: var(--color-fg-muted);
    }

    .card__desc {
        margin: 0;
        color: var(--color-fg-default);
        font-size: var(--text-sm);
        line-height: var(--leading-relaxed);
    }

    .table-wrap {
        max-inline-size: 100%;
        overflow-x: auto;
    }

    .doc-table {
        inline-size: 100%;
        min-inline-size: max-content;
        border-collapse: collapse;
        font-size: var(--text-sm);
    }

    .doc-table th,
    .doc-table td {
        padding: var(--space-2) var(--space-3);
        border-block-end: 1px solid var(--color-border-subtle);
        text-align: start;
        vertical-align: top;
    }

    .doc-table thead th {
        color: var(--color-fg-muted);
        font-weight: var(--font-weight-medium);
    }

    .doc-table a {
        color: var(--color-fg-link);
    }

    .page-foot {
        padding-block-start: var(--space-6);
        border-block-start: 1px solid var(--color-border-subtle);
    }

    .tok {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
    }

    .visually-hidden {
        position: absolute;
        inline-size: 1px;
        block-size: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
        border: 0;
    }

    [hidden] {
        display: none !important;
    }
</style>
