---
/**
 * C-2 相册详情（M2-8c，中文路由）
 * ------------------------------------------------------------------
 * 结构：页头（相册名 / 张数 / 地点 / 拍摄日）+ 照片瀑布流 + 灯箱提示。
 *
 * 本卡的三条硬边界都在这里：
 * 1. **缩略图与原图分离**：`AlbumGrid` 里 `<img>` 读站点 `/cdn-cgi/image/width=…`
 *    缩略图，`<a href>` 读图床原图；两者地址不同源、不同串，e2e 直接对账数量与形状。
 * 2. **灯箱复用**：容器 id `#fancybox-gallery`，绑定的是 BaseLayout 常驻的
 *    `~/scripts/fancybox-album`（`~/utils/fancybox.ts`）。本页 0 行灯箱代码。
 * 3. **列数是断点契约**：albums.css 里 390 → 1、768 → 2、1440 → 3，不用 auto-fill
 *    碰巧凑数（e2e 读 computed columnCount 断言）。
 *
 * 路由只由通过校验的条目生成（坏数据不会生出一个 200 的空壳页）；
 * 相册 id 沿用既有 URL（`shenzhen_feng-huang-shan`），不重写 slug。
 */
import "~/styles/tokens/tokens.css";
import "~/styles/pages/entities.css";
import "~/styles/pages/albums.css";
import BaseLayout from "~/layouts/BaseLayout.astro";
import Icon from "~/components/UI/atom/Icon.astro";
import AlbumGrid from "~/components/C/AlbumGrid.astro";
import { albums, albumsMeta } from "~/data/entities/albums";
import {
    albumPlaceLabel,
    albumSpan,
    albumSpec,
    formatUpdated,
    normalizeCollection,
} from "~/types/entities";
import { getPicImageUrl } from "~/utils";
import { getLocale } from "~/utils/i18n";
import { site } from "~/config";

/**
 * 无入参：语言来自 URL、数据来自实体契约。
 * 显式声明成「空 props」是为了让 `/en/albums/[album]` 能直接渲染本页组件 ——
 * 不声明时 Astro 把页面 props 推成 `never`，复用方连 `<Page />` 都过不了类型检查。
 */
type Props = Record<string, never>;

export function getStaticPaths() {
    const feed = normalizeCollection(albums, albumsMeta, albumSpec);
    return feed.items.map((album) => ({ params: { album: album.id } }));
}

const feed = normalizeCollection(albums, albumsMeta, albumSpec);
const loc = getLocale(Astro.currentLocale || "zh");
const isEn = loc === "en";

const album = feed.items.find((item) => item.id === Astro.params.album);
if (!album) return Astro.redirect("/albums/");

const name = album.name[isEn ? "en" : "zh"];
const place = albumPlaceLabel(album.place, isEn ? "en" : "zh");
const span = albumSpan(album);
const backHref = isEn ? "/en/albums/" : "/albums/";
const updatedLabel = formatUpdated(album.updated, null, isEn ? "en" : "zh");

const copy = isEn
    ? {
          back: "Back to albums",
          kicker: "ALBUM · FIELD NOTES",
          photoOne: "photos",
          listTitle: "Photographs",
          listMeta: "Thumbnails here · originals open in the lightbox",
          note: "Click any photo to open the lightbox: arrow keys page through, Esc closes it, and focus returns to the photo you clicked. Each thumbnail above is a width-limited render (640 wide); the lightbox loads the original from the image host.",
          updatedPrefix: "album checked",
      }
    : {
          back: "返回相册列表",
          kicker: "ALBUM · 走走拍拍",
          photoOne: "张照片",
          listTitle: "照片",
          listMeta: "这里只加载缩略图 · 原图交给灯箱",
          note: "点任意照片打开灯箱：左右方向键翻页，Esc 关闭后焦点回到你点的那一张。上方每张都是按宽度压过的缩略图（640 宽），灯箱才去图床取原图。",
          updatedPrefix: "相册核对于",
      };

const description = isEn
    ? `${name} · ${place}${span ? ` · ${span}` : ""} · ${album.photos.length} photos`
    : `${name} · ${place}${span ? ` · ${span}` : ""} · ${album.photos.length} 张照片`;
---

<BaseLayout
    locale={loc}
    title={`${name} - ${isEn ? "Album" : "相册"} - ${site.title}`}
    description={description}
    image={getPicImageUrl(album.photos[0], 640)}
    imageAlt={name}
    keywords={[name, isEn ? "Album" : "相册", isEn ? "Photos" : "照片", place]}
>
    <article
        class="entities entities--albums"
        data-album-detail={album.id}
        data-album-photos={album.photos.length}
        data-album-place={album.place}
        data-album-span={span}
        aria-labelledby="album-title"
    >
        <header class="entities-hero">
            <a class="album-detail__back" href={backHref}>← {copy.back}</a>
            <p class="entities-kicker">{copy.kicker}</p>
            <h1 class="entities-title" id="album-title">{name}</h1>
            <div class="entities-hero__meta">
                <span class="entities-chip">
                    <Icon name="tabler:camera" size="xs" />
                    {album.photos.length}
                    {copy.photoOne}
                </span>
                {
                    span && (
                        <span class="entities-chip">
                            <Icon name="tabler:calendar" size="xs" />
                            {span}
                        </span>
                    )
                }
                <span class="entities-chip">
                    <Icon name="tabler:map-pin" size="xs" />
                    {place}
                </span>
                {
                    updatedLabel && (
                        <span class="entities-chip entities-chip--quiet">
                            {copy.updatedPrefix} {updatedLabel}
                        </span>
                    )
                }
            </div>
        </header>

        <section class="entities-section" aria-labelledby="album-photos-title">
            <div class="entities-section__head">
                <h2 class="entities-section__title" id="album-photos-title">{copy.listTitle}</h2>
                <p class="entities-section__meta">{copy.listMeta}</p>
            </div>

            <AlbumGrid album={album} locale={loc} />

            <p class="album-detail__note">{copy.note}</p>
        </section>
    </article>
</BaseLayout>
