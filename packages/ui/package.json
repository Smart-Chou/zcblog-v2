{
    "name": "@marxchou/dogeared-ui",
    "version": "2.1.0",
    "description": "Zero-dependency UI primitives (Astro components) for the Dogeared theme: Badge and Button.",
    "type": "module",
    "private": true,
    "license": "MIT",
    "homepage": "https://github.com/Smart-Chou/zcblog-v2/tree/main/packages/ui#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Smart-Chou/zcblog-v2.git",
        "directory": "packages/ui"
    },
    "bugs": {
        "url": "https://github.com/Smart-Chou/zcblog-v2/issues"
    },
    "files": [
        "dist",
        "src",
        "README.md",
        "LICENSE",
        "NOTICE"
    ],
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./Badge.astro": "./dist/Badge.astro",
        "./Button.astro": "./dist/Button.astro",
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "node scripts/build.mjs",
        "prepack": "node scripts/build.mjs",
        "pretest": "node scripts/build.mjs",
        "test": "node --test test/smoke.test.mjs"
    },
    "sideEffects": false,
    "peerDependencies": {
        "astro": "^7.3.6"
    },
    "peerDependenciesMeta": {
        "astro": {
            "optional": true
        }
    },
    "engines": {
        "node": ">=22"
    }
}
