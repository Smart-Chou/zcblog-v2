        "url": "git+https://github.com/Smart-Chou/zcblog-v2.git",
        "directory": "packages/og-image"
    },
    "bugs": {
        "url": "https://github.com/Smart-Chou/zcblog-v2/issues"
    },
    "files": [
        "src",
        "README.md",
        "LICENSE",
        "NOTICE"
    ],
    "main": "./src/index.ts",
    "module": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "import": "./src/index.ts",
            "default": "./src/index.ts"
        },
        "./package.json": "./package.json"
    },
    "sideEffects": false,
    "dependencies": {
