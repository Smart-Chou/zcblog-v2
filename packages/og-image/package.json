{
    "name": "@marxchou/dogeared-og-image",
    "version": "2.1.0",
    "description": "OG image route factory for the Dogeared theme: createOgImageRoute(options) renders 1200x630 PNGs. No site config is read; posts, site identity, palette and fonts are injected by the theme.",
    "type": "module",
    "private": true,
    "license": "MIT",
    "homepage": "https://github.com/Smart-Chou/zcblog-v2/tree/main/packages/og-image#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Smart-Chou/zcblog-v2.git",
        "directory": "packages/og-image"
    },
    "bugs": {
        "url": "https://github.com/Smart-Chou/zcblog-v2/issues"
    },
    "files": [
        "dist",
        "src",
        "README.md",
        "LICENSE",
        "NOTICE"
    ],
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "node scripts/build.mjs",
        "prepack": "node scripts/build.mjs",
        "pretest": "node scripts/build.mjs",
        "test": "node --test test/smoke.test.mjs"
    },
    "sideEffects": false,
    "dependencies": {
        "satori": "^0.26.0",
        "sharp": "^0.35.5"
    },
    "peerDependencies": {
        "astro": "^7.3.6"
    },
    "peerDependenciesMeta": {
        "astro": {
            "optional": true
        }
    },
    "engines": {
        "node": ">=22"
    }
}
