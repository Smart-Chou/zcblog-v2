{
    "name": "@marxchou/dogeared-tokens",
    "version": "2.1.2",
    "description": "Design tokens for the Dogeared theme: tokens.json is the single source, tokens.css its byte-verified build output, variables.css the primitive/palette layer. Zero runtime dependencies.",
    "type": "module",
    "private": false,
    "publishConfig": {
        "access": "public"
    },
    "license": "MIT",
    "homepage": "https://github.com/Smart-Chou/zcblog-v2/tree/main/packages/tokens#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Smart-Chou/zcblog-v2.git",
        "directory": "packages/tokens"
    },
    "bugs": {
        "url": "https://github.com/Smart-Chou/zcblog-v2/issues"
    },
    "files": [
        "tokens.json",
        "tokens.css",
        "variables.css",
        "scripts/build-tokens.mjs",
        "README.md",
        "LICENSE",
        "NOTICE"
    ],
    "exports": {
        ".": "./tokens.css",
        "./tokens.json": "./tokens.json",
        "./tokens.css": "./tokens.css",
        "./variables.css": "./variables.css",
        "./scripts/build-tokens.mjs": "./scripts/build-tokens.mjs",
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "node scripts/build-tokens.mjs",
        "test": "node --test test/smoke.test.mjs"
    },
    "bin": {
        "dogeared-tokens-build": "./scripts/build-tokens.mjs"
    },
    "sideEffects": [
        "**/*.css"
    ],
    "engines": {
        "node": ">=22"
    }
}
