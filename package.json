{
    "name": "@marxchou/zcblog",
    "version": "2.1.2",
    "description": "个人博客网站，使用Astro框架构建，包含文章、标签、归档、捐赠等功能",
    "type": "module",
    "private": true,
    "scripts": {
        "dev": "astro dev",
        "dev:clean": "rm -rf node_modules/.vite && astro dev",
        "start": "astro dev",
        "build": "pnpm run fetch:all || true && pnpm run fetch:verify || true && astro build && node scripts/postbuild/collapse-html-whitespace.mjs dist",
        "build:ci": "astro build && node scripts/postbuild/collapse-html-whitespace.mjs dist",
        "pagefind": "node scripts/pagefind.mjs",
        "preview": "astro preview",
        "astro": "astro",
        "type-check": "tsc --noEmit",
        "new-post": "node scripts/new-post.js",
        "preinstall": "npx only-allow pnpm",
        "fetch:all": "pnpm run talks & pnpm run douban & pnpm run friends & pnpm run bangumi & pnpm run popular & pnpm run stats & pnpm run icons",
        "icons": "node scripts/generate-icons.js",
        "talks": "node scripts/fetch-talks.mjs",
        "douban": "node scripts/fetch-douban.mjs",
        "friends": "node scripts/fetch-friends.mjs",
        "bangumi": "node scripts/fetch-bangumi.mjs",
        "popular": "node scripts/fetch-popular.mjs",
        "stats": "node scripts/fetch-site-stats.mjs",
        "seo:indexnow": "node scripts/indexnow-submit.mjs",
        "fetch:verify": "node scripts/verify-data.mjs",
        "links": "node scripts/link-check.mjs",
        "check:personal": "node scripts/check-personalization.mjs",
        "snapshot:theme": "node scripts/snapshot-theme.mjs",
        "release": "standard-version",
        "release:dry": "standard-version --dry-run",
        "release:packages": "changeset publish",
        "release:packages:dry": "node scripts/release/publish-dry-run.mjs",
        "changeset": "changeset",
        "version-packages": "changeset version",
        "verify:versions": "node scripts/release/verify-versions.mjs",
        "verify:registry": "node scripts/release/verify-registry.mjs",
        "verify:consumer-matrix": "node scripts/release/verify-consumer-matrix.mjs",
        "verify:consumer-matrix:docker": "node scripts/release/verify-consumer-matrix.mjs --docker=true",
        "fixture:next-minor": "node scripts/release/prepare-next-minor-fixture.mjs",
        "preflight:release": "node scripts/release/preflight.mjs",
        "release:selftest": "node scripts/release/verify-workflow.mjs && node scripts/release/verify-guards.mjs && node scripts/release/verify-changeset-loop.mjs",
        "format": "prettier -w .",
        "format:check": "prettier --check .",
        "lint": "pnpm run format:check",
        "gates:atoms": "node scripts/gates/verify-atoms.mjs",
        "gates:docs": "node scripts/gates/verify-atom-docs.mjs",
        "gates:inventory": "node scripts/gates/verify-component-inventory.mjs",
        "gates:drift": "node scripts/gates/verify-doc-drift.mjs",
        "gates:tokens": "node scripts/gates/check-tokens.mjs",
        "gates:surfaces": "node scripts/gates/verify-surface-tokens.mjs",
        "gates:entities": "node scripts/gates/verify-entities.mjs",
        "gates:boundary": "node scripts/gates/verify-package-boundary.mjs",
        "gates:overlay": "node scripts/gates/verify-overlay.mjs",
        "gates:m3-exit": "node scripts/gates/verify-m3-exit.mjs --all",
        "theme:sync": "node scripts/theme-sync.mjs --dry-run",
        "gates:icons": "node scripts/gates/verify-icon-sprite.mjs",
        "gates:all": "node scripts/gates/verify-atoms.mjs && node scripts/gates/verify-atom-docs.mjs && node scripts/gates/verify-component-inventory.mjs && node scripts/gates/verify-doc-drift.mjs && node scripts/gates/check-tokens.mjs && node scripts/gates/verify-surface-tokens.mjs && node scripts/gates/verify-entities.mjs && node scripts/gates/verify-package-boundary.mjs && node scripts/gates/verify-overlay.mjs && node scripts/gates/verify-icon-sprite.mjs",
        "test:unit": "vitest run",
        "test:unit:watch": "vitest",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "audit:a11y": "playwright test e2e/export-audit.spec.ts",
        "audit:a11y:smoke": "AUDIT_BASELINE=0 AUDIT_ROUTES='/ /en/ /blog/1/ /archives/ /tags/ /culture/ /bangumi/ /douban/ /cookies/ /design/components/author/ /404.html' playwright test e2e/export-audit.spec.ts",
        "preview:deploy": "wrangler pages deploy dist --project-name=zcblog-v2 --branch=${BRANCH:-local} --commit-dirty=true"
    },
    "dependencies": {
        "@astrojs/check": "^0.9.10",
        "@astrojs/markdown-remark": "^7.3.2",
        "@astrojs/mdx": "^7.0.8",
        "@astrojs/rss": "^4.0.19",
        "@astrojs/sitemap": "^3.7.4",
        "@expressive-code/plugin-collapsible-sections": "^0.41.7",
        "@expressive-code/plugin-line-numbers": "^0.41.7",
        "@fancyapps/ui": "^6.1.15",
        "@pagefind/component-ui": "^1.5.2",
        "@swup/astro": "^1.8.0",
        "@waline/client": "^3.16.0",
        "astro": "^7.3.6",
        "astro-expressive-code": "^0.44.2",
        "astro-icon": "^1.2.0",
        "astro-vtbot": "^2.1.12",
        "fast-glob": "^3.3.3",
        "hast-util-to-html": "^9.0.5",
        "hastscript": "^9.0.1",
        "html-minifier-terser": "^7.2.0",
        "katex": "^0.19.0",
        "marked": "^18.1.0",
        "pagefind": "^1.5.2",
        "pangu": "^7.2.1",
        "reading-time": "^1.5.0",
        "rehype-autolink-headings": "^7.1.0",
        "rehype-callouts": "^2.2.0",
        "rehype-components": "^0.3.0",
        "rehype-katex": "^7.0.1",
        "rehype-slug": "^6.0.0",
        "remark-directive": "^4.0.0",
        "remark-gfm": "^4.0.1",
        "remark-math": "^6.0.0",
        "sanitize-html": "^2.18.0",
        "satori": "^0.63.2",
        "sharp": "^0.35.5",
        "tocbot": "^4.36.8",
        "unist-util-remove": "^4.0.0",
        "unist-util-visit": "^5.1.0",
        "uqr": "^0.1.3"
    },
    "devDependencies": {
        "@changesets/cli": "3.0.3",
        "@iconify-json/logos": "^1.2.15",
        "@iconify-json/mingcute": "^1.2.8",
        "@iconify-json/tabler": "^1.2.41",
        "@iconify/utils": "^3.1.7",
        "@playwright/test": "^1.63.0",
        "@types/hast": "^3.0.5",
        "@types/mdast": "^4.0.4",
        "@types/sanitize-html": "^2.16.2",
        "axe-core": "^4.14.0",
        "jsdom": "^28.1.0",
        "prettier": "^3.9.9",
        "prettier-plugin-astro": "^0.14.1",
        "standard-version": "^9.5.0",
        "typescript": "^5.9.3",
        "vite": "^7.3.7",
        "vite-plugin-pwa": "^1.3.0",
        "vitest": "^4.1.11",
        "yaml": "2.9.1"
    },
    "packageManager": "pnpm@12.10.1"
}
