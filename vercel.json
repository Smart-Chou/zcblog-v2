{
    "buildCommand": "pnpm build:ci",
    "outputDirectory": "dist",
    "build": {
        "env": {
            "NODE_OPTIONS": "--max-old-space-size=4096"
        }
    },
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=0, must-revalidate"
                }
            ]
        }
    ],
    "redirects": [
        {
            "source": "/tag/:tag",
            "destination": "/tags/:tag/",
            "statusCode": 301
        },
        {
            "source": "/tag/:tag/",
            "destination": "/tags/:tag/",
            "statusCode": 301
        },
        {
            "source": "/en/tag/:tag",
            "destination": "/en/tags/:tag/",
            "statusCode": 301
        },
        {
            "source": "/en/tag/:tag/",
            "destination": "/en/tags/:tag/",
            "statusCode": 301
        }
    ]
}
