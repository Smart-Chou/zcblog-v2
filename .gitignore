# build output
dist/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# env
.env

# macOS
.DS_Store

# Editor / IDE
.vscode/
.trae/

# Astro
.astro/

# Vite
.vite-cache/

# Playwright
playwright-report/
test-results/

# AI / Claude
.claude/settings.local.json
.superpowers/
.codegraph/

# impeccable
.impeccable/

# pagefind dev index
public/pagefind/

# Auto-generated files
src/assets/fonts/
src/assets/coverimage/
src/assets/pagefind-search-practice-illustrations/
src/assets/chrome-zoom-bug-git-bisect-illustrations/
src/assets/blog-seo-practice-illustrations/
src/assets/note/

# Articles (private submodule, checked out in CI)
src/content/article/

# Temp / tasks
tasks/
scripts/check-content-sync.py

# 主题快照输出（若生成到仓库内）
theme-snapshot/

# Python 门禁脚本的字节码缓存
__pycache__/
*.pyc
release-pack/

# 本地取证用的构建产物快照（`dist-<批次>-<阶段>`，每次 e2e/视觉对比后生成）
dist-*/
.visual-states/
.scratch-*/
# 同上，但 scratch 名也可能是「一条日志文件」而不是目录（.scratch-m866-build.log）。
# 只写 .scratch-*/ 的话这些文件不被忽略，会长期污染 git status。
.scratch-*
.probe-*.mjs
playwright.m7-*.config.ts
playwright.m8-*.config.ts
playwright.baseline.config.ts
