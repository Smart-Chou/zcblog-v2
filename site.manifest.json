            "class": "T"
        },
        {
            "path": "theme-template/README.md",
            "class": "T"
        },
        {
            "path": ".github/workflows/ci.yml",
            "class": "T"
        },
        {
            "path": "public/fonts/dm-sans-latin-wght-normal.woff2",
            "class": "T"
        },
        {
            "path": "src/config/site.ts",
            "class": "O"
        },
        {
            "path": "src/config/feature.ts",
            "class": "O"
        },
        {
            "path": "src/config/ui.ts",
            "class": "O"
        },
        {
            "path": "src/config/services.ts",
            "class": "O"
        },
        {
            "path": "src/content/pages/privacy-policy.md",
            "class": "O"
        },
        {
            "path": "src/data/friends.json",
            "class": "O"
        },
        {
            "path": "src/data/adapters/friends.ts",
            "class": "O"
        },
        {
            "path": "src/assets/logo.svg",
            "class": "O"
        },
        {
            "path": "public/assets/note/000823-556005.png",
            "class": "O"
        },
        {
            "path": "public/images/douban/30385142.webp",
            "class": "O"
        },
        {
            "path": "public/cover.png",
            "class": "O"
        },
        {
            "path": "public/_headers",
            "class": "O"
        },
        {
            "path": "vercel.json",
            "class": "O"
        },
        {
            "path": "site.manifest.json",
            "class": "O"
        },
        {
            "path": "docs/_reviews/M2-13/report.md",
            "class": "X"
