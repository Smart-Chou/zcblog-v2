{
    "manifestVersion": 1,
    "$comment": "站点 overlay 清单 · M3-5 产物。T = 主题代码（升级时整体替换）；O = 站点 overlay（升级永不触碰）；X = 排除（构建/缓存/评审档案，不入任一清单）。判据：node scripts/gates/verify-overlay.mjs --report → unclassified=0。变更留痕：每改一次清单都要追加一条 changeLog（decision 指向 blog2.0/docs/decision-log.md 的 D-NNNN）。契约：docs/overlay-contract.md。",
    "theme": {
        "name": "dogeared",
        "package": "@marxchou/zcblog",
        "version": "2.1.2",
        "ref": "pkg-v2.1.2",
        "repository": "https://github.com/Smart-Chou/zcblog"
    },
    "planBaseline": {
        "files": 998,
        "source": "blog2.0/docs/21-m3-plan.md §4.1（2026-11 计划冻结时的 `git ls-files` 计数）",
        "note": "998 是计划当时的实测值；之后 M3-1..M3-4 各卡新增的 T 文件会计入 classified，delta 由门禁打印。"
    },
    "changeLog": [
        {
            "decision": "D-0138",
            "date": "2026-11-07",
            "summary": "M5-7b：新增 changeLog 字段（清单变更留痕）；T/O/X 规则一条未改，classified 相对 998 基线的 delta 全部来自后续各卡新增文件。"
        }
    ],
    "classes": {
        "T": {
            "label": "theme",
            "upgrade": "replace",
            "rules": [
                "src/components/**",
                "src/layouts/**",
                "src/pages/**",
                "src/styles/**",
                "src/utils/**",
                "src/scripts/**",
                "src/integrations/**",
                "src/remark-plugin/**",
                "src/rehype-plugin/**",
                "src/schemas/**",
                "src/types/**",
                "src/content.config.ts",
                "src/env.d.ts",
                "src/data/i18n/**",
                "src/config/index.ts",
                "packages/**",
                "scripts/**",
                "e2e/**",
                "theme-template/**",
                "docs/DESIGN.md",
                "docs/DESIGN.vendor.json",
                "docs/component-inventory.json",
                "docs/surface-token-baseline.json",
                "docs/package-boundary.md",
                "docs/overlay-contract.md",
                "docs/deploy-matrix.md",
                "docs/upgrade.md",
                "docs/npm-consumer.md",
                ".github/workflows/ci.yml",
                ".github/workflows/perf.yml",
                ".github/workflows/a11y-pr.yml",
                ".github/workflows/a11y-nightly.yml",
                ".github/workflows/friend-link.yml",
                ".github/workflows/deploy-matrix.yml",
                ".github/workflows/demo.yml",
                ".github/scripts/friend-link.mjs",
                ".github/ISSUE_TEMPLATE/friend-link.yml",
                "public/fonts/**",
                "public/favicon.*",
                "public/logo.webp",
                "public/assets/rss/**",
                "astro.config.mjs",
                "tsconfig.json",
                "playwright.config.ts",
                "vitest.config.ts",
                "package.json",
                "pnpm-lock.yaml",
                "pnpm-workspace.yaml",
                ".npmrc",
                ".prettierrc.mjs",
                ".prettierignore",
                ".editorconfig",
                ".gitignore",
                ".env.example",
                "README.md",
                "CONTRIBUTING.md",
                "LICENSE",
                "NOTICE"
            ],
            "reserved": [".changeset/**", "docs/release.md", ".github/workflows/release.yml"]
        },
        "O": {
            "label": "overlay",
            "upgrade": "keep",
            "rules": [
                "src/config/site.ts",
                "src/config/feature.ts",
                "src/config/ui.ts",
                "src/config/services.ts",
                "src/content/**",
                "src/data/*.json",
                "src/data/entities/**",
                "src/data/adapters/**",
                "src/assets/**",
                "public/assets/note/**",
                "public/images/**",
                "public/cover.png",
                "public/_headers",
                "public/a9c70334-a4c2-470d-872c-c60cff6c24a0.txt",
                "vercel.json",
                ".github/workflows/deploy.yml",
                "apps/demo/**",
                "site.manifest.json"
            ],
            "reserved": [".env", "deploy/**", "CHANGELOG.md", "public/_redirects"]
        },
        "X": {
            "label": "exclude",
            "upgrade": "ignore",
            "rules": ["docs/_reviews/**", ".claude/**"],
            "reserved": [
                "dist/**",
                "node_modules/**",
                ".astro/**",
                ".vite-cache/**",
                "playwright-report/**",
                "test-results/**",
                ".git/**"
            ]
        }
    },
    "overrides": [
        {
            "path": "src/styles/site.css",
            "class": "O",
            "note": "§4.2：站点唯一允许新增的样式文件（主题不覆盖）。精确路径优先于 src/styles/** 这条 T 规则。"
        }
    ],
    "anchors": [
        {
            "path": "astro.config.mjs",
            "class": "T"
        },
        {
            "path": "NOTICE",
            "class": "T"
        },
        {
