            "class": "T"
        },
        {
            "path": "src/config/index.ts",
            "class": "T"
        },
        {
            "path": "src/components/Article/PostCard.astro",
            "class": "T"
        },
        {
            "path": "src/styles/global.css",
            "class": "T"
        },
        {
            "path": "src/data/i18n/zh.json",
            "class": "T"
        },
        {
