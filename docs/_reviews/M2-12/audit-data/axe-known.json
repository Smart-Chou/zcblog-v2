[
    {
        "rule": "color-contrast",
        "selector": ".pf-trigger-text",
        "note": "共享 Header 搜索触发器占位文字：暗色 #767676 on #1e1e2e = 3.61 < 4.5（全站 546 页）"
    },
    {
        "rule": "color-contrast",
        "selector": "#hitokoto-source",
        "note": "文章/列表页一言出处：暗色 #6b6762 on #1c1917 = 3.11 < 4.5（92 页）"
    },
    {
        "rule": "aria-hidden-focus",
        "selector": ".share-pop",
        "note": "文章页分享浮层 aria-hidden=true 内仍含可聚焦 button（opacity:0 但仍可 Tab 到，85 篇）"
    },
    {
        "rule": "aria-prohibited-attr",
        "selector": ".disabled",
        "note": "分页禁用态 <a aria-disabled aria-label> 无 role（19 页）"
    },
    {
        "rule": "aria-prohibited-attr",
        "selector": ".footer-stats",
        "note": "页脚统计 div 带 aria-label 但无 role（全站 header/footer 存量）"
    },
    {
        "rule": "link-name",
        "selector": ".img-link",
        "note": "正文图片链接无可访问名（2 篇文章 × 4 节点）"
    },
    {
        "rule": "aria-allowed-attr",
        "route": "^/(en/)?bangumi/$",
        "note": "番剧页 tab-btn 用 aria-selected 但缺 role=tab（critical，2 页）"
    },
    {
        "rule": "label",
        "selector": ".task-list-item",
        "note": "Markdown 任务列表 checkbox 无 label（critical，1 篇 8 节点）"
    },
    {
        "rule": "color-contrast",
        "route": "^/(en/)?(bangumi|douban)/$",
        "note": "番剧/豆瓣页 status-badge、count、filter-count 暗色对比度不足"
    },
    {
        "rule": "link-in-text-block",
        "route": "^/(cookies|privacy-policy|copyright)/$",
        "note": "法律页正文内联链接只靠颜色区分（无下划线/边框）"
    },
    {
        "rule": "target-size",
        "route": "^(/|/design/components/author/)$",
        "note": "首页 / Author 文档页社交图标命中区 < 24px"
    },
    {
        "rule": "color-contrast",
        "selector": ".build-time",
        "note": "组件文档页「构建于 …」时间戳暗色对比度"
    },
    {
        "rule": "color-contrast",
        "selector": ".ln[aria-hidden=\"true\"]",
        "note": "expressive-code 行号（aria-hidden）暗色对比度，1 篇文章 4 节点"
    },
    {
        "rule": "color-contrast",
        "selector": ".remark-aside",
        "note": "remark-aside 提示框内链暗色对比度，2 篇文章"
    },
    {
        "rule": "color-contrast",
        "selector": ".redirect-tip",
        "note": "外链跳转中继页 /redirect/ 的提示文字暗色对比度"
    },
    {
        "rule": "color-contrast",
        "route": "^/500\\.html$",
        "note": "500 错误页 .btn-primary 暗色对比度"
    }
]
